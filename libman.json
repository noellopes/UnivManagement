{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/bootstrap/dist",
      "files": [
        "js/*.js",
        "css/*.css"
      ]
    },
    {
      "library": "jquery@4.0.0",
      "destination": "wwwroot/lib/jquery/dist",
      "files": [
        "jquery.min.js",
        "jquery.js",
        "jquery.slim.js",
        "jquery.slim.min.js"
      ]
    },
    {
      "library": "jquery-validate@1.22.1",
      "destination": "wwwroot/lib/jquery-validation/dist",
      "files": [
        "jquery.validate.min.js",
        "additional-methods.js",
        "additional-methods.min.js",
        "jquery.validate.js"
      ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/dist"
    },
    {
      "library": "bootstrap-icons@1.13.1",
      "destination": "wwwroot/lib/bootstrap-icons"
    }
  ]
}