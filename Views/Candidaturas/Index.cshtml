@model IEnumerable<UnivManagement.Models.Candidatura>

@{
    ViewData["Title"] = "Candidaturas";
}

<div class="container mt-4">
    <!-- Cabeçalho com título e botão de ação alinhados -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Candidaturas</h1>
            <p class="text-muted mb-0">Gestão e acompanhamento das candidaturas submetidas.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Criar Nova Candidatura
        </a>
    </div>

    <!-- Cartão contentor para a tabela -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7">
                        <tr>
                            <th class="py-3 ps-4">Estudante</th>
                            <th class="py-3">Oferta</th>
                            <th class="py-3">Data</th>
                            <th class="py-3">Estado</th>
                            <th class="py-3">Currículo</th>
                            <th class="py-3 text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder2-open fs-2 d-block mb-2"></i>
                                    Ainda não existem candidaturas registadas.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">
                                        @(item.Estudante != null ? item.Estudante.Nome : "Estudante Desconhecido")
                                    </td>
                                    <td>
                                        <span class="text-secondary">@(item.Oferta != null ? item.Oferta.Titulo : $"Oferta #{item.IdOferta}")</span>
                                    </td>
                                    <td>
                                        @item.DataCandidatura.ToShortDateString()
                                    </td>
                                    <td>
                                        @if (item.Estado == "Submetida")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">@item.Estado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1">@item.Estado</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-muted text-truncate d-inline-block" style="max-width: 150px;">@item.Curriculo</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-idcandidatura="@item.IdCandidatura" class="btn btn-sm btn-outline-secondary" title="Editar">
                                                <i class="bi bi-pencil"></i> Editar
                                            </a>
                                            <a asp-action="Details" asp-route-idcandidatura="@item.IdCandidatura" class="btn btn-sm btn-outline-info" title="Detalhes">
                                                <i class="bi bi-info-circle"></i> Detalhes
                                            </a>
                                            <a asp-action="Delete" asp-route-idcandidatura="@item.IdCandidatura" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>