@model ServiceRequestCatalogItem

@{
    ViewData["Title"] = "Delete service";
    bool hasRequests = Model.Requests.Any();
}

<div class="container py-4">
    <a asp-action="Index" class="link-secondary text-decoration-none">
        <i class="bi bi-arrow-left"></i> Back to catalog
    </a>

    <header class="my-4">
        <h1 class="display-6">Delete service</h1>
    </header>

    @if (TempData["Error"] != null) {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    @if (hasRequests) {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            This service has @Model.Requests.Count request(s), so it cannot be deleted.
            You can <a asp-action="Edit" asp-route-id="@Model.ServiceRequestCatalogItemId" class="alert-link">mark it as unavailable</a>
            so it is no longer offered.
        </div>
    } else {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            Are you sure you want to delete this service? This action cannot be undone.
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Type)</dt>
                <dd class="col-sm-9">@Model.Type?.Name</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ProcessingDays)</dt>
                <dd class="col-sm-9">@Model.ProcessingDays day(s)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(m => m.IsActive)</dt>
                <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.ServiceRequestCatalogItemId" method="post" class="mt-4">
        <input type="hidden" asp-for="ServiceRequestCatalogItemId" />
        <button type="submit" class="btn btn-danger" disabled="@hasRequests">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to catalog</a>
    </form>
</div>
