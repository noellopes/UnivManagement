@model IEnumerable<ServiceRequestCatalogItem>

@{
    ViewData["Title"] = "Service catalog";

    var currentSearch = ViewData["Search"] as string;
    var showUnavailable = ViewData["ShowUnavailable"] as bool? == true;

    // The controller already marks the selected type
    var typeItems = ViewData["Types"] as SelectList;
}

<div class="container py-4">
    <a asp-controller="AdministrativeServices" asp-action="Index" class="link-secondary text-decoration-none">
        <i class="bi bi-arrow-left"></i> Requests and Administrative Services
    </a>

    <header class="d-flex flex-wrap justify-content-between align-items-center my-4">
        <div>
            <h1 class="display-6 mb-0">Service catalog</h1>
            <p class="text-body-secondary mb-0">Certificates, documents and other services that can be requested.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New service
        </a>
    </header>

    @if (TempData["Message"] != null) {
        <div class="alert alert-success" role="alert">@TempData["Message"]</div>
    }

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-5">
            <input type="text" name="search" value="@currentSearch" class="form-control"
                   placeholder="Search services" aria-label="Search" />
        </div>
        <div class="col-md-3">
            <select name="type" class="form-select" aria-label="Request type" asp-items="typeItems">
                <option value="">All types</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="showUnavailable" value="true" id="showUnavailable"
                       checked="@showUnavailable" />
                <label class="form-check-label" for="showUnavailable">Show unavailable</label>
            </div>
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-outline-primary" title="Filter">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </form>

    @if (!Model.Any()) {
        <div class="alert alert-info" role="alert">
            No services found.
        </div>
    } else {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var item in Model) {
                <div class="col">
                    <div class="card h-100 shadow-sm @(item.IsActive ? null : "opacity-75")">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h2 class="card-title h5 mb-0">@item.Name</h2>
                                @if (!item.IsActive) {
                                    <span class="badge text-bg-secondary ms-2">Unavailable</span>
                                }
                            </div>
                            <p class="small mb-2">
                                <span class="badge text-bg-light border">@item.Type?.Name</span>
                                <span class="text-body-secondary ms-1">
                                    <i class="bi bi-calendar-check"></i> @item.ProcessingDays day(s)
                                </span>
                            </p>
                            <p class="card-text text-body-secondary flex-grow-1">
                                @(item.Description ?? "No description.")
                            </p>
                            <p class="small text-body-secondary">
                                <i class="bi bi-inbox"></i> @item.Requests.Count request(s)
                            </p>
                            @if (!string.IsNullOrWhiteSpace(item.RequiredDocuments)) {
                                <p class="small text-body-secondary">
                                    <i class="bi bi-paperclip"></i> Documents needed: @item.RequiredDocuments
                                </p>
                            }
                            <div class="d-flex gap-2">
                                @if (item.IsActive) {
                                    <a asp-controller="ServiceRequests" asp-action="Create"
                                       asp-route-serviceRequestCatalogItemId="@item.ServiceRequestCatalogItemId"
                                       class="btn btn-sm btn-primary me-auto">
                                        <i class="bi bi-send"></i> Request this service
                                    </a>
                                }
                                <a asp-action="Details" asp-route-id="@item.ServiceRequestCatalogItemId"
                                   class="btn btn-sm btn-outline-secondary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ServiceRequestCatalogItemId"
                                   class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ServiceRequestCatalogItemId"
                                   class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
