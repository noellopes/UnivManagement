@model IEnumerable<ServiceRequestCatalogItem>

@{
    ViewData["Title"] = "Service catalog";
}

<div class="container py-4">
    <a asp-controller="AdministrativeServices" asp-action="Index" class="link-secondary text-decoration-none">
        Back to Requests and Administrative Services
    </a>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
            @ViewBag.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <header class="d-flex flex-wrap justify-content-between align-items-center my-4">
        <div>
            <h1 class="display-6 mb-0">Service catalog</h1>
            <p class="text-body-secondary mb-0">Services that can be requested from the administrative services.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">New service</a>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>Type</th>
                        <th>Processing days</th>
                        <th>Active</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@item.Type?.Name</td>
                            <td>@Html.DisplayFor(modelItem => item.ProcessingDays)</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge text-bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.ServiceRequestCatalogItemId" class="btn btn-sm btn-outline-secondary" title="Details" aria-label="Details">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ServiceRequestCatalogItemId" class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ServiceRequestCatalogItemId" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            There are no services yet. Create the first one.
        </div>
    }
</div>