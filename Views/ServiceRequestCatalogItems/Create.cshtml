@model ServiceRequestCatalogItem

@{
    ViewData["Title"] = "New service";
}

<div class="container py-4">
    <a asp-action="Index" class="link-secondary text-decoration-none">Back to the service catalog</a>

    <header class="my-4">
        <h1 class="display-6">New service</h1>
        <p class="text-body-secondary">A service is something that can be requested from the administrative services, for example an enrolment certificate.</p>
    </header>

    <div class="row">
        <div class="col-lg-8">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Enrolment certificate" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="What the service is for"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ServiceRequestTypeId" class="form-label">Type</label>
                    <select asp-for="ServiceRequestTypeId" asp-items="ViewBag.ServiceRequestTypeId" class="form-select">
                        <option value="0">Choose a type</option>
                    </select>
                    <span asp-validation-for="ServiceRequestTypeId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProcessingDays" class="form-label">Processing days</label>
                    <input asp-for="ProcessingDays" class="form-control" min="1" max="60" placeholder="Days to process the request (1 to 60)" />
                    <span asp-validation-for="ProcessingDays" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RequiredDocuments" class="form-label">Required documents</label>
                    <textarea asp-for="RequiredDocuments" class="form-control" rows="3" placeholder="Documents the student has to bring"></textarea>
                    <span asp-validation-for="RequiredDocuments" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Active (it can be requested)</label>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}