@model ServiceRequest?

@{
    ViewData["Title"] = "Track a request";

    var number = ViewData["Number"] as int?;
    var email = ViewData["Email"] as string;
    var error = ViewData["Error"] as string;

    const string statusBadge = "~/Views/ServiceRequests/_ServiceRequestStatusBadge.cshtml";

    // Submitted (first status of the list) -> being processed -> closed (a status that closes the request)
    var firstStatusId = ViewData["FirstStatusId"] as int?;
    int currentStep = Model == null ? 0
        : Model.IsClosed ? 3
        : Model.ServiceRequestStatusId == firstStatusId ? 1
        : 2;
    string[] steps = { "Submitted", "Being processed", "Closed" };
}

<div class="container py-4">
    <a asp-controller="AdministrativeServices" asp-action="Index" class="link-secondary text-decoration-none">
        <i class="bi bi-arrow-left"></i> Requests and Administrative Services
    </a>

    <header class="my-4">
        <h1 class="display-6">Track a request</h1>
        <p class="text-body-secondary">
            Enter the number you received when you submitted the request and the email you used.
        </p>
    </header>

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <label for="number" class="form-label">Request number</label>
            <input type="number" id="number" name="number" value="@number" class="form-control" min="1" required />
        </div>
        <div class="col-md-6">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" value="@email" class="form-control"
                   placeholder="name@example.com" required />
        </div>
        <div class="col-md-3 d-grid align-items-end">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Track
            </button>
        </div>
    </form>

    @if (error != null) {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @error
        </div>
    }

    @if (Model != null) {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <h2 class="h4 mb-1">
                            @Model.Title
                            <span class="text-body-secondary fs-6">#@Model.ServiceRequestId</span>
                        </h2>
                        <p class="text-body-secondary mb-0">
                            @if (Model.CatalogItem != null) {
                                @Model.CatalogItem.Name
                            } else {
                                @Model.Type?.Name
                            }
                            &middot; Submitted on @Model.CreatedAt.ToString("yyyy-MM-dd")
                        </p>
                    </div>
                    <partial name="@statusBadge" model="Model.Status" />
                </div>

                <ol class="list-unstyled d-flex justify-content-between text-center mt-4 mb-2">
                    @for (int i = 0; i < steps.Length; i++) {
                        bool reached = i < currentStep;
                        <li class="flex-fill">
                            <i class="bi @(reached ? "bi-check-circle-fill text-success" : "bi-circle text-body-tertiary") fs-4"></i>
                            <div class="small @(i == currentStep - 1 ? "fw-semibold" : "text-body-secondary")">@steps[i]</div>
                        </li>
                    }
                </ol>
                <div class="progress" role="progressbar" aria-label="Request progress"
                     aria-valuenow="@currentStep" aria-valuemin="0" aria-valuemax="@steps.Length" style="height: 6px">
                    <div class="progress-bar @(Model.IsClosed ? "bg-" + Model.Status?.Color : null)"
                         style="width: @(currentStep * 100 / steps.Length)%"></div>
                </div>

                <dl class="row mt-4 mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m!.DueDate)</dt>
                    <dd class="col-sm-8">
                        @(Model.DueDate?.ToString("yyyy-MM-dd") ?? "—")
                        @if (Model.IsOverdue) {
                            <span class="badge text-bg-danger ms-1">Delayed</span>
                        }
                    </dd>

                    @if (Model.ClosedAt.HasValue) {
                        <dt class="col-sm-4">@Html.DisplayNameFor(m => m!.ClosedAt)</dt>
                        <dd class="col-sm-8">@Model.ClosedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                    }
                </dl>

                @* Open statuses that ask for a note, such as waiting for information, need something from the requester *@
                @if (Model.Status is { IsFinal: false, RequiresNote: true }) {
                    <div class="alert alert-info mt-3 mb-0" role="alert">
                        <i class="bi bi-info-circle"></i>
                        We need something from you to continue. Check the latest note below.
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <i class="bi bi-clock-history"></i> What has happened
            </div>
            @if (!Model.History.Any()) {
                <div class="card-body text-body-secondary">No actions recorded yet.</div>
            } else {
                <ul class="list-group list-group-flush">
                    @foreach (var entry in Model.History) {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <span>@entry.Action</span>
                                <small class="text-body-secondary text-nowrap ms-2">@entry.ChangedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </div>
                            @if (entry.NewStatus != null) {
                                <div class="mt-1"><partial name="@statusBadge" model="entry.NewStatus" /></div>
                            }
                            @if (!string.IsNullOrEmpty(entry.Note)) {
                                <p class="small mb-0 mt-1">@entry.Note</p>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>
