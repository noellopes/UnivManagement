@model UnivManagement.Models.Group

@{
    ViewData["Title"] = "Eliminar Turma";
}

<div class="container mt-4" style="max-width: 720px;">
  
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">Eliminar Turma</h1>
            <p class="text-muted small mb-0">Confirme os detalhes da turma antes de prosseguir com a eliminação.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Voltar à Lista
        </a>
    </div>

   
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4 shadow-sm rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
        <div>
            <strong>Atenção!</strong> Tem a certeza de que pretende eliminar esta turma? Esta ação não pode ser desfeita.
        </div>
    </div>

   
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <dl class="row mb-0 gy-3">
                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.NomeTurma)
                </dt>
                <dd class="col-sm-8 fw-bold text-dark mb-0">
                    @Html.DisplayFor(model => model.NomeTurma)
                </dd>

                <hr class="my-2 text-light-emphasis" />

                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.NumeroAlunos)
                </dt>
                <dd class="col-sm-8 text-dark mb-0">
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 fs-6">
                        @Html.DisplayFor(model => model.NumeroAlunos) alunos
                    </span>
                </dd>

                <hr class="my-2 text-light-emphasis" />

                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.Ativo)
                </dt>
                <dd class="col-sm-8 text-dark mb-0">
                    @if (Model.Ativo) {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                            Ativo
                        </span>
                    } else {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                            Inativo
                        </span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete" class="mt-4 pt-3 border-top">
                <input type="hidden" asp-for="GroupId" />
                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn btn-danger px-4 shadow-sm">
                        <i class="bi bi-trash me-1"></i> Confirmar Eliminação
                    </button>
                    <a asp-action="Index" class="btn btn-light border px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>