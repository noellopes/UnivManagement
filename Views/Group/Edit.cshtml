@model UnivManagement.Models.Group

@{
    ViewData["Title"] = "Editar Turma";
}

<div class="container mt-4" style="max-width: 720px;">
    
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">Editar Turma</h1>
            <p class="text-muted small mb-0">Atualize as informações da turma selecionada.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Voltar à Lista
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>
                
                <input type="hidden" asp-for="GroupId" />

                <div class="mb-3">
                    <label asp-for="NomeTurma" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="NomeTurma" class="form-control" />
                    <span asp-validation-for="NomeTurma" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NumeroAlunos" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="NumeroAlunos" type="number" class="form-control" />
                    <span asp-validation-for="NumeroAlunos" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch fs-6">
                        <input asp-for="Ativo" class="form-check-input" type="checkbox" role="switch" id="AtivoSwitch" />
                        <label class="form-check-label fw-semibold text-dark ms-2" for="AtivoSwitch">
                            @Html.DisplayNameFor(model => model.Ativo)
                        </label>
                    </div>
                    <span asp-validation-for="Ativo" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center gap-2 pt-2 border-top">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Guardar Alterações
                    </button>
                    <a asp-action="Index" class="btn btn-light border px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}