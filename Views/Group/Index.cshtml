@model IEnumerable<UnivManagement.Models.Group>

@{
    ViewData["Title"] = "Gestão de Turmas";
}

<div class="container-fluid mt-4 px-4">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">Gestão de Turmas</h1>
            <p class="text-muted small mb-0">Consulte e gira as turmas registadas no sistema.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i> Criar Nova Turma
        </a>
    </div>


    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">
                                @Html.DisplayNameFor(model => model.NomeTurma)
                            </th>
                            <th class="text-center">
                                @Html.DisplayNameFor(model => model.NumeroAlunos)
                            </th>
                            <th class="text-center">
                                @Html.DisplayNameFor(model => model.Ativo)
                            </th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
@foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                @Html.DisplayFor(model => item.NomeTurma)
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2 fs-6">
                                    @Html.DisplayFor(model => item.NumeroAlunos) alunos
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.Ativo) {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        Ativo
                                    </span>
                                } else {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                                        Inativo
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Ações">
                                    <a asp-action="Edit" asp-route-id="@item.GroupId" class="btn btn-outline-primary" title="Editar">
                                        Editar
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.GroupId" class="btn btn-outline-info" title="Detalhes">
                                        Detalhes
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.GroupId" class="btn btn-outline-danger" title="Eliminar">
                                        Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>