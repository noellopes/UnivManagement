@model UnivManagement.Models.Docente

@{
    ViewData["Title"] = "Criar Novo Docente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-sm border-0 rounded-3">
                <!-- Cabeçalho Azul -->
                <div class="card-header bg-primary text-white py-3 rounded-top-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-person-plus-fill me-2"></i> Criar Novo Docente
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <!-- Nº Docente -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="NumDocente" class="form-label fw-semibold text-muted">Nº Docente</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-hash"></i></span>
                                    <input asp-for="NumDocente" class="form-control" placeholder="Ex: 101" />
                                </div>
                                <span asp-validation-for="NumDocente" class="text-danger small"></span>
                            </div>

                            <!-- Nome -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nome" class="form-label fw-semibold text-muted">Nome</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input asp-for="Nome" class="form-control" placeholder="Nome completo" />
                                </div>
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- NIF -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nif" class="form-label fw-semibold text-muted">NIF</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-card-text"></i></span>
                                    <input asp-for="Nif" class="form-control" />
                                </div>
                                <span asp-validation-for="Nif" class="text-danger small"></span>
                            </div>

                            <!-- Telefone -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefone" class="form-label fw-semibold text-muted">Telefone</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Telefone" class="form-control" />
                                </div>
                                <span asp-validation-for="Telefone" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-muted">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="exemplo@ipg.pt" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Morada -->
                        <div class="mb-3">
                            <label asp-for="Morada" class="form-label fw-semibold text-muted">Morada</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Morada" class="form-control" />
                            </div>
                            <span asp-validation-for="Morada" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <!-- Departamento -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="DepartamentoId" class="form-label fw-semibold text-muted">Departamento</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-building"></i></span>
                                    <select asp-for="DepartamentoId" class="form-control" asp-items="ViewBag.DepartamentoId">
                                        <option value="">Selecione o departamento...</option>
                                    </select>
                                </div>
                                <span asp-validation-for="DepartamentoId" class="text-danger small"></span>
                            </div>

                            <!-- Data de Admissão -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="DataAdmissao" class="form-label fw-semibold text-muted">Data de Admissão</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="DataAdmissao" class="form-control" type="date" />
                                </div>
                                <span asp-validation-for="DataAdmissao" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Estado (Ativo Switch) -->
                        <div class="mb-4 mt-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="Ativo" id="flexSwitchCheckChecked" checked>
                                <label class="form-check-label fw-semibold text-dark" for="flexSwitchCheckChecked">
                                    Docente Ativo
                                </label>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                                <i class="bi bi-check2-circle me-1"></i> Criar Docente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}