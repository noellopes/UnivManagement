@model UnivManagement.Models.Docente

@{
    ViewData["Title"] = "Eliminar Docente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <!-- Alerta de Aviso Amarelo -->
            <div class="alert alert-warning d-flex align-items-center p-3 rounded-3 shadow-sm border-0 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-warning"></i>
                <div>
                    <h6 class="alert-heading fw-bold mb-1">Confirmar Eliminação</h6>
                    <p class="mb-0 small">Tem a certeza de que pretende eliminar este docente?</p>
                </div>
            </div>

            <!-- Cartão Principal -->
            <div class="card shadow-sm border-0 rounded-3">
                <!-- Cabeçalho Vermelho -->
                <div class="card-header bg-danger text-white py-3 rounded-top-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-person-x-fill me-2"></i> Eliminar Registo de Docente
                    </h4>
                </div>

                <!-- Corpo do Cartão -->
                <div class="card-body p-4">
                    <div class="bg-light p-4 rounded-3">

                        <!-- Número de Docente -->
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-semibold">
                                <i class="bi bi-hash me-2"></i> Nº Docente
                            </div>
                            <div class="col-sm-8 fw-bold">
                                @Model.NumDocente
                            </div>
                        </div>

                        <!-- Nome -->
                        <div class="row pb-3 mb-3 border-bottom">
                            <div class="col-sm-4 text-muted fw-semibold">
                                <i class="bi bi-person me-2"></i> Nome
                            </div>
                            <div class="col-sm-8 fw-bold fs-5">
                                @Model.Nome
                            </div>
                        </div>

                        <!-- NIF -->
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-semibold">
                                <i class="bi bi-card-text me-2"></i> NIF
                            </div>
                            <div class="col-sm-8">
                                @Model.Nif
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-semibold">
                                <i class="bi bi-envelope me-2"></i> Email
                            </div>
                            <div class="col-sm-8">
                                <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                            </div>
                        </div>

                        <!-- Telefone -->
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-semibold">
                                <i class="bi bi-telephone me-2"></i> Telefone
                            </div>
                            <div class="col-sm-8">
                                @Model.Telefone
                            </div>
                        </div>

                        <!-- Morada -->
                        <div class="row pb-3 mb-3 border-bottom">
                            <div class="col-sm-4 text-muted fw-semibold">
                                <i class="bi bi-geo-alt me-2"></i> Morada
                            </div>
                            <div class="col-sm-8">
                                @Model.Morada
                            </div>
                        </div>

                        <!-- Departamento -->
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-semibold">
                                <i class="bi bi-building me-2"></i> Departamento
                            </div>
                            <div class="col-sm-8 fw-bold text-primary">
                                @(Model.Departamento != null ? Model.Departamento.Nome : "Sem departamento")
                            </div>
                        </div>

                        <!-- Data de Admissão -->
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-semibold">
                                <i class="bi bi-calendar-event me-2"></i> Data de Admissão
                            </div>
                            <div class="col-sm-8">
                                @Model.DataAdmissao.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <!-- Estado -->
                        <div class="row mb-0">
                            <div class="col-sm-4 text-muted fw-semibold">
                                <i class="bi bi-activity me-2"></i> Estado
                            </div>
                            <div class="col-sm-8">
                                @if (Model.Ativo)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i> Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="bi bi-x-circle me-1"></i> Inativo
                                    </span>
                                }
                            </div>
                        </div>

                    </div>

                    <!-- Formulário e Botões de Ação no Rodapé -->
                    <form asp-action="Delete" class="d-flex justify-content-between align-items-center mt-4 pt-2">
                        <input type="hidden" asp-for="DocenteId" />

                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar e Voltar
                        </a>

                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                            <i class="bi bi-trash me-1"></i> Confirmar Eliminação
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>