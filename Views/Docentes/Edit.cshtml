@model UnivManagement.Models.Docente

@{
    ViewData["Title"] = "Edit";
}

<div class="card shadow-sm border-0 my-4">
    <div class="card-header bg-secondary text-white py-3">
        <h4 class="mb-0 text-center"><i class="bi bi-pencil-square me-2"></i>Editar Docente</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="DocenteId" />

            <!-- Linha 1: NumDocente e Nome -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="NumDocente" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-hash"></i></span>
                        <input asp-for="NumDocente" class="form-control" />
                    </div>
                    <span asp-validation-for="NumDocente" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Nome" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Nome" class="form-control" />
                    </div>
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
            </div>

            <!-- Linha 2: Nif e Email -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Nif" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                        <input asp-for="Nif" class="form-control" />
                    </div>
                    <span asp-validation-for="Nif" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <!-- Linha 3: Telefone e Morada -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Telefone" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                        <input asp-for="Telefone" class="form-control" />
                    </div>
                    <span asp-validation-for="Telefone" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Morada" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                        <input asp-for="Morada" class="form-control" />
                    </div>
                    <span asp-validation-for="Morada" class="text-danger"></span>
                </div>
            </div>

            <!-- Linha 4: FuncaoDocenteId, DataAdmissao e Departamento -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="FuncaoDocenteId" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                        <input asp-for="FuncaoDocenteId" class="form-control" />
                    </div>
                    <span asp-validation-for="FuncaoDocenteId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DataAdmissao" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                        <input asp-for="DataAdmissao" class="form-control" />
                    </div>
                    <span asp-validation-for="DataAdmissao" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DepartamentoId" class="form-label fw-bold">Departamento</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-building"></i></span>
                        <select asp-for="DepartamentoId" class="form-control" asp-items="ViewBag.DepartamentoId"></select>
                    </div>
                    <span asp-validation-for="DepartamentoId" class="text-danger"></span>
                </div>
            </div>

              <!-- Linha 5: Ativo (Checkbox Estilizado) -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input bg-success border-success" type="checkbox" role="switch" asp-for="Ativo" style="cursor: pointer; width: 2.5em; height: 1.25em;" />
                        <label class="form-check-label fw-bold ms-2" asp-for="Ativo">@Html.DisplayNameFor(model => model.Ativo)</label>
                    </div>
                </div>
            </div>

            <!-- Botões de Ação -->
            <div class="d-flex justify-content-between align-items-center">
                <button type="submit" class="btn btn-success px-4 py-2">
                    <i class="bi bi-check-lg me-1"></i> Salvar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
                </a>
            </div>
        </form>
    </div>
</div>