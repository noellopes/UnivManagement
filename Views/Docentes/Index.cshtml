@model IEnumerable<UnivManagement.Models.Docente>

@{
    ViewData["Title"] = "Lista de Docentes";
}

<div class="card bg-light border-0 mb-4 p-4 shadow-sm">
    <h2 class="fw-bold text-dark mb-0">Index</h2>
</div>

<div class="mb-4">
    <a asp-action="Create" class="btn btn-success px-3 py-2">
        <i class="bi bi-plus-lg me-1"></i> Criar Novo Docente
    </a>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Nif</th>
                <th>Morada</th>
                <th>Telefone</th>
                <th>Email</th>
                <th>Departamento</th>
                <th>Ativo</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => item.Nif)</td>
                    <td>@Html.DisplayFor(modelItem => item.Morada)</td>
                    <td>@Html.DisplayFor(modelItem => item.Telefone)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Departamento.Nome)</td>
                    <td>
                        @if (item.Ativo)
                        {
                            <span class="badge bg-success px-2 py-1">
                                <i class="bi bi-check-circle-fill me-1"></i> Ativo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-2 py-1">
                                <i class="bi bi-x-circle-fill me-1"></i> Inativo
                            </span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.DocenteId" class="btn btn-primary btn-sm" title="Editar">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.DocenteId" class="btn btn-info btn-sm text-white" title="Detalhes">
                            <i class="bi bi-info-circle"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.DocenteId" class="btn btn-danger btn-sm" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>