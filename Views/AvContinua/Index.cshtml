@model IEnumerable<UnivManagement.Models.AvContinua>

@{
    ViewData["Title"] = "Avaliações Contínuas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2">Avaliações Contínuas</h1>
            <p class="text-body-secondary">
                Gestão das avaliações contínuas.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Data de Registo</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id_Cont</td>
                            <td>@item.Data_Registo.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="text-body-secondary small">
                                    Ações em desenvolvimento
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
