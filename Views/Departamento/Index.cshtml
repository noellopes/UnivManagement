@model IEnumerable<UnivManagement.Models.Departamento>

@{
    ViewData["Title"] = "Gestão de Departamentos";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 rounded-3">
        
        <!-- Cabeçalho com Título e Botão de Criar -->
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h4 class="card-title mb-0 fw-bold text-primary">
                <i class="bi bi-building me-2"></i>Gestão de Departamentos
            </h4>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
                <i class="bi bi-building-add me-1"></i> Criar Novo Departamento
            </a>
        </div>

        <!-- Tabela Responsiva -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Nome)</th>
                            <th>@Html.DisplayNameFor(model => model.DataCriacao)</th>
                            <th class="text-center">@Html.DisplayNameFor(model => model.Ativo)</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Nenhum departamento registado até ao momento.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Nome do Departamento -->
                                    <td class="ps-4">
                                        <span class="fw-bold text-dark">@item.Nome</span>
                                    </td>

                                    <!-- Data de Criação -->
                                    <td>
                                        <i class="bi bi-calendar-event me-1 text-muted"></i>@item.DataCriacao.ToString("dd/MM/yyyy")
                                    </td>

                                    <!-- Estado Ativo / Inativo -->
                                    <td class="text-center">
                                        @if (item.Ativo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i>Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                                                <i class="bi bi-x-circle-fill me-1"></i>Inativo
                                            </span>
                                        }
                                    </td>

                                    <!-- Botões de Ação com Ícones -->
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.DepartamentoId" class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.DepartamentoId" class="btn btn-sm btn-outline-info" title="Detalhes">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.DepartamentoId" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>