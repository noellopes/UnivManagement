@model UnivManagement.Models.Departamento

@{
    ViewData["Title"] = "Eliminar Departamento";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-danger border-0 rounded-3">
                <!-- Cabeçalho do Cartão -->
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="card-title mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Eliminar Departamento
                    </h4>
                </div>

                <!-- Corpo com Alerta e Detalhes -->
                <div class="card-body p-4">

                    <!-- Mensagem de Aviso -->
                    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
                        <div>
                            <strong>Atenção!</strong> Tem a certeza de que pretende eliminar este departamento? Esta ação não pode ser desfeita.
                        </div>
                    </div>

                    <!-- Detalhes do Departamento -->
                    <div class="bg-light rounded p-4 mb-4">
                        <dl class="row mb-0 gy-3">
                            <!-- Nome -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-building me-1"></i> @Html.DisplayNameFor(model => model.Nome)
                            </dt>
                            <dd class="col-sm-8 fw-bold text-dark fs-5 mb-0">
                                @Html.DisplayFor(model => model.Nome)
                            </dd>

                            <hr class="my-2 text-muted" />

                            <!-- Data de Criação -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-calendar-event me-1"></i> Data de Criação
                            </dt>
                            <dd class="col-sm-8 mb-0">
                                @Model.DataCriacao.ToString("dd/MM/yyyy")
                            </dd>

                            <hr class="my-2 text-muted" />

                            <!-- Estado Ativo/Inativo -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-activity me-1"></i> Estado
                            </dt>
                            <dd class="col-sm-8 mb-0">
                                @if (Model.Ativo)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i> Inativo</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <!-- Formulário de Confirmação -->
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="DepartamentoId" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar e Voltar
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                                <i class="bi bi-trash-fill me-1"></i> Confirmar Eliminação
                            </button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>