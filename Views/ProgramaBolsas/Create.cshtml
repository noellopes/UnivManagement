@model UnivManagement.Models.ProgramaBolsa

@{
    ViewData["Title"] = "Adicionar Programa";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="fw-bold mb-2">Adicionar Programa de Bolsa</h1>
        <p class="text-secondary mb-0">
            Preencha os dados para criar um novo programa de bolsa.
        </p>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm border-0" style="border-radius: 0.5rem;">
        <div class="card-body p-4">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold">
                            Nome do programa
                        </label>
                        <input asp-for="Nome" class="form-control"
                               placeholder="Introduza o nome do programa" />
                        <span asp-validation-for="Nome"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AnoLetivo" class="form-label fw-semibold">
                            Ano letivo
                        </label>
                        <input asp-for="AnoLetivo" class="form-control"
                               placeholder="Ex: 2026/2027" />
                        <span asp-validation-for="AnoLetivo"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Descricao" class="form-label fw-semibold">
                            Descrição
                        </label>
                        <textarea asp-for="Descricao" class="form-control"
                                  rows="4"
                                  placeholder="Descreva o programa de bolsa"></textarea>
                        <span asp-validation-for="Descricao"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DataInicio" class="form-label fw-semibold">
                            Data de início
                        </label>
                        <input asp-for="DataInicio" class="form-control"
                               type="date" />
                        <span asp-validation-for="DataInicio"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ValorMaximoBolsa"
                               class="form-label fw-semibold">
                            Valor máximo da bolsa (€)
                        </label>
                        <input asp-for="ValorMaximoBolsa" class="form-control"
                               type="number" step="0.01" min="0"
                               placeholder="Ex: 1500.00" />
                        <span asp-validation-for="ValorMaximoBolsa"
                              class="text-danger"></span>
                    </div>

                    <!-- Dropdown -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdTipoPrograma"
                               class="form-label fw-semibold">
                            Tipo de programa
                        </label>

                        <select asp-for="IdTipoPrograma"
                                asp-items="ViewBag.IdTipoPrograma"
                                class="form-select">
                            <option value="">Selecione o tipo de programa</option>
                        </select>

                        <span asp-validation-for="IdTipoPrograma"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit"
                            class="btn text-white"
                            style="background-color: #e8a33d;">
                        Guardar programa
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
