@model UnivManagement.Models.OrientadorEstagio

@{
    ViewData["Title"] = "Eliminar Orientador";
}

<h2>Eliminar Orientador de Estágio</h2>

<p>Tem a certeza de que pretende eliminar este orientador?</p>

<div class="border rounded p-3 mt-4">

    <p>
        <strong>Nome:</strong>
        @Model.Nome
    </p>

    <p>
        <strong>Email:</strong>
        @Model.Email
    </p>

    <form asp-action="Delete" method="post">

        <input type="hidden" name="idorientador"
               value="@Model.IdOrientador" />

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>

        <a asp-action="Details"
           asp-route-idorientador="@Model.IdOrientador"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>