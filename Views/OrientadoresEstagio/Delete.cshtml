@model UnivManagement.Models.OrientadorEstagio

@{
    ViewData["Title"] = "Eliminar Orientador";
}

<h2>Eliminar Orientador de Estágio</h2>

@if (Model.Estagios.Count > 0)
{
    <div class="alert alert-warning mt-4">
        Não é possível eliminar este orientador porque possui
        estágios associados.
    </div>
}
else
{
    <p>Tem a certeza de que pretende eliminar este orientador?</p>
}

<div class="border rounded p-3 mt-4">

    <p>
        <strong>Nome:</strong>
        @Model.Nome
    </p>

    <p>
        <strong>Email:</strong>
        @Model.Email
    </p>
    <p>
        <strong>Estágios associados:</strong>
        @Model.Estagios.Count
    </p>
    <form asp-action="Delete" method="post">

        <input type="hidden"
               name="orientadorId"
               value="@Model.OrientadorId" />

        @if (Model.Estagios.Count == 0)
        {
            <button type="submit" class="btn btn-danger">
                Eliminar
            </button>
        }
        else
        {
            <button type="submit" class="btn btn-danger" disabled>
                Eliminar
            </button>
        }

        <a asp-action="Details"
           asp-route-orientadorId="@Model.OrientadorId"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>