@model UnivManagement.Models.OrientadorEstagio

@{
    ViewData["Title"] = "Detalhes do Orientador";
}

<h2>Orientador de Estágio</h2>

<div class="border rounded p-3 mt-4">

    <p>
        <strong>Nome:</strong>
        @Model.Nome
    </p>

    <p>
        <strong>Email:</strong>
        @Model.Email
    </p>

    <div class="mt-4">

        <a asp-action="Edit"
           asp-route-idorientador="@Model.IdOrientador"
           class="btn btn-primary">
            Editar
        </a>

        <a asp-action="Delete"
           asp-route-idorientador="@Model.IdOrientador"
           class="btn btn-danger">
            Eliminar
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>

    </div>

</div>