@model UnivManagement.Models.OrientadorEstagio

@{
    ViewData["Title"] = "Detalhes do Orientador";
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @ViewBag.SuccessMessage
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

<h2>Orientador de Estágio</h2>

<div class="border rounded p-3 mt-4">

    <p>
        <strong>Nome:</strong>
        @Model.Nome
    </p>

    <p>
        <strong>Email:</strong>
        @Model.Email
    </p>

    <p>
        <strong>Estágios associados:</strong>
        @Model.Estagios.Count
    </p>

    <div class="mt-4">

        <a asp-action="Edit"
           asp-route-orientadorId="@Model.OrientadorId"
           class="btn btn-primary">
            Editar
        </a>

        <a asp-action="Delete"
           asp-route-orientadorId="@Model.OrientadorId"
           class="btn btn-danger">
            Eliminar
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>

    </div>

</div>