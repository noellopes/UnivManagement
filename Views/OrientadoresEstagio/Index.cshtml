@model IEnumerable<UnivManagement.Models.OrientadorEstagio>

@{
    ViewData["Title"] = "Orientadores de Estágio";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Orientadores de Estágio</h2>

    <a asp-action="Create" class="btn btn-primary">Criar</a>
</div>

@if (Model.Count() == 0)
{
    <p>Ainda não existem orientadores de estágio registados.</p>
}
else
{
    @foreach (var orientador in Model)
    {
        <a asp-action="Details"
           asp-route-idorientador="@orientador.IdOrientador"
           class="d-block border rounded p-3 mb-3 text-decoration-none">
            @orientador.Nome
        </a>
    }
}