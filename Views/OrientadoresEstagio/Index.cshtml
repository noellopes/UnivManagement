@model UnivManagement.ViewModels.QueryOptions<UnivManagement.Models.OrientadorEstagio>

@{
    ViewData["Title"] = "Orientadores de Estágio";

    var orientadores = Model.Items;

    int totalPaginas =
        (Model.TotalItems + Model.ItemsPerPage - 1) / Model.ItemsPerPage;
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @ViewBag.SuccessMessage
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Orientadores de Estágio</h2>

    <a asp-action="Create" class="btn btn-primary">
        Criar Orientador
    </a>
</div>

@if (!orientadores.Any())
{
    <div class="border rounded p-4 text-center">
        <p class="text-muted mb-0">
            Ainda não existem orientadores de estágio registados.
        </p>
    </div>
}
else
{
    @foreach (var orientador in orientadores)
    {
        <a asp-action="Details"
           asp-route-orientadorId="@orientador.OrientadorId"
           class="d-block text-decoration-none border rounded-3 shadow-sm p-3 mb-3">

            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-semibold text-dark">
                        @orientador.Nome
                    </span>

                    <div class="text-muted">
                        Estágios associados: @orientador.Estagios.Count
                    </div>
                </div>
                <span class="text-primary">
                    Ver detalhes &rsaquo;
                </span>

            </div>
        </a>
    }
}

@if (totalPaginas > 1)
{
    <nav aria-label="Paginação dos orientadores de estágio" class="mt-3">
        <ul class="pagination justify-content-center">

            @if (Model.CurrentPage == 1)
            {
                <li class="page-item disabled">
                    <span class="page-link">Anterior</span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)">
                        Anterior
                    </a>
                </li>
            }

            @for (int pagina = 1; pagina <= totalPaginas; pagina++)
            {
                if (pagina == Model.CurrentPage)
                {
                    <li class="page-item active" aria-current="page">
                        <span class="page-link">@pagina</span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@pagina">
                            @pagina
                        </a>
                    </li>
                }
            }

            @if (Model.CurrentPage == totalPaginas)
            {
                <li class="page-item disabled">
                    <span class="page-link">Seguinte</span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)">
                        Seguinte
                    </a>
                </li>
            }

        </ul>
    </nav>
}