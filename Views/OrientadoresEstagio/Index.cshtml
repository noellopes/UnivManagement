@model IEnumerable<UnivManagement.Models.OrientadorEstagio>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Password)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estagios)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Avaliacoes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Password)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estagios)
            </td>
            <td>
                @Html.DisplayFor(model => item.Avaliacoes)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdOrientador">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdOrientador">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdOrientador">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
