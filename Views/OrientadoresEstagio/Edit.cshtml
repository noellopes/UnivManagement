@model UnivManagement.Models.OrientadorEstagio

@{
    ViewData["Title"] = "Editar Orientador";
}

<h2>Editar Orientador de Estágio</h2>

<div class="border rounded p-3 mt-4">

    <form asp-action="Edit"
          asp-route-idorientador="@Model.IdOrientador"
          method="post">

        <input type="hidden"
               name="IdOrientador"
               value="@Model.IdOrientador" />

        <div class="mb-3">
            <label class="form-label">Nome</label>
            <input type="text"
                   name="Nome"
                   value="@Model.Nome"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email"
                   name="Email"
                   value="@Model.Email"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password"
                   name="Password"
                   class="form-control"
                   placeholder="Deixar vazio para manter a atual" />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">
                Guardar Alterações
            </button>

            <a asp-action="Details"
               asp-route-idorientador="@Model.IdOrientador"
               class="btn btn-secondary">
                Cancelar
            </a>
        </div>

    </form>

</div>