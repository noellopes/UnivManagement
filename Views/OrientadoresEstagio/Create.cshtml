@model UnivManagement.Models.OrientadorEstagio

@{
    ViewData["Title"] = "Criar Orientador";
}

<h2>Criar Orientador de Estágio</h2>

<div class="border rounded p-3 mt-4">

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label class="form-label">Nome</label>
            <input type="text"
                   name="Nome"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email"
                   name="Email"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password"
                   name="Password"
                   class="form-control"
                   required />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">
                Criar
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
        </div>

    </form>

</div>