@model UnivManagement.Models.Nota

@{
    ViewData["Title"] = "Detalhes da nota";
}

<h1>Detalhes da nota</h1>
<hr />

    <dl class="row">
        <dt class="col-sm-3">Avaliação</dt>
        <dd class="col-sm-9">@Model.AvaliacaoUC?.TipoAvaliacao?.Tipo_Prova - UC @Model.AvaliacaoUC?.UcID</dd>

        <dt class="col-sm-3">Data da avaliação</dt>
        <dd class="col-sm-9">@Model.AvaliacaoUC?.Data.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Inscrição na UC</dt>
        <dd class="col-sm-9">Nº @Model.InscrUcId</dd>

        <dt class="col-sm-3">Data da nota</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Data)</dd>

        <dt class="col-sm-3">Nota</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Valor)</dd>

        <dt class="col-sm-3">Aprovado</dt>
        <dd class="col-sm-9">@(Model.Aprovado ? "Sim" : "Não")</dd>
    </dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.NotaId" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar à lista</a>
</div>