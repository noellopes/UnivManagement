@model IEnumerable<UnivManagement.Models.Notas>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AvaliacaoID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AvaliacaoUC)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InscrUcID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InscrUC)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nota)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Aprovado)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.AvaliacaoID)
            </td>
            <td>
                @Html.DisplayFor(model => item.AvaliacaoUC)
            </td>
            <td>
                @Html.DisplayFor(model => item.InscrUcID)
            </td>
            <td>
                @Html.DisplayFor(model => item.InscrUC)
            </td>
            <td>
                @Html.DisplayFor(model => item.Data)
            </td>
            <td>
                @Html.DisplayFor(model => item.Nota)
            </td>
            <td>
                @Html.DisplayFor(model => item.Aprovado)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.NotaID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.NotaID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.NotaID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
