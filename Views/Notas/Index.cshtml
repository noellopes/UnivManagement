@model IEnumerable<UnivManagement.Models.Nota>

@{
    ViewData["Title"] = "Notas";
}

<h1>Notas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Lançar nova nota</a>
</p>

@if (!Model.Any())
{
    <p>Ainda não há notas lançadas.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Avaliação</th>
                <th>Inscrição na UC</th>
                <th>Data</th>
                <th>Nota</th>
                <th>Aprovado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AvaliacaoUC?.TipoAvaliacao?.Tipo_Prova - UC @item.AvaliacaoUC?.UcID</td>
                    <td>Nº @item.InscrUcId</td>
                    <td>@Html.DisplayFor(modelItem => item.Data)</td>
                    <td>@Html.DisplayFor(modelItem => item.Valor)</td>
                    <td>@(item.Aprovado ? "Sim" : "Não")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.NotaId" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.NotaId" class="btn btn-sm btn-info">Detalhes</a>
                        <a asp-action="Delete" asp-route-id="@item.NotaId" class="btn btn-sm btn-danger">Apagar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}