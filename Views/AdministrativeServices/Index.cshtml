@{
    ViewData["Title"] = "Requests and Administrative Services";
}

<div class="container py-4">
    <a asp-controller="Home" asp-action="Index" class="link-secondary text-decoration-none">
        <i class="bi bi-arrow-left"></i> Home
    </a>

    <header class="text-center mb-5">
        <h1 class="display-5">Requests and Administrative Services</h1>
        <p class="lead text-body-secondary">
            Submit administrative requests and follow them until they are resolved.
        </p>
    </header>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5"><i class="bi bi-inbox"></i> Requests</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Submit new administrative requests and manage existing ones.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Coming soon
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5"><i class="bi bi-file-earmark-text"></i> Certificates and Documents</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Request certificates and other official documents.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Coming soon
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5"><i class="bi bi-life-preserver"></i> Student Support</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Submit and follow up on student support requests.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Coming soon
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5"><i class="bi bi-tools"></i> Maintenance</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Report maintenance issues in campus buildings, rooms, and equipment.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Coming soon
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5"><i class="bi bi-person-check"></i> Assignments</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Assign each request to the appropriate department or staff member.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Coming soon
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5"><i class="bi bi-clock-history"></i> Tracking and History</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Track request status, comments, attachments, and the actions taken on each request.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Coming soon
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
