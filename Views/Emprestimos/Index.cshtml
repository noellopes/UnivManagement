@model IEnumerable<UnivManagement.Models.Emprestimo>

@{
    ViewData["Title"] = "Lista de Empréstimos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 font-weight-bold text-dark">Empréstimos</h1>
            <p class="text-muted mb-0">Gestão de empréstimos e devoluções de exemplares da biblioteca.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg">+ Novo Empréstimo</i>
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3 px-3">Data de Empréstimo</th>
                            <th class="py-3">Data de Devolução</th>
                            <th class="py-3">Estado</th>
                            <th class="py-3">ID Exemplar</th>
                            <th class="py-3">Código Exemplar</th>
                            <th class="py-3 text-end px-3">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Ainda não existem empréstimos registados.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model) {
                                <tr>
                                    <td class="px-3">
                                        @Html.DisplayFor(modelItem => item.dataEmprestimo)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.dataDevolucao)
                                    </td>
                                    <td>
                                        @if (item.estado == "Ativo")
                                        {
                                            <span class="badge bg-warning text-dark px-2 py-1">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-2 py-1">@item.estado</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>#@item.ExemplarId</strong>
                                    </td>
                                    <td>
                                        @(item.Exemplar?.Codigo ?? "N/D")
                                    </td>
                                    <td class="text-end px-3">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-emprestimoid="@item.EmprestimoId" class="btn btn-sm btn-outline-secondary">Editar</a>
                                            <a asp-action="Details" asp-route-emprestimoid="@item.EmprestimoId" class="btn btn-sm btn-outline-info">Detalhes</a>
                                            <a asp-action="Delete" asp-route-emprestimoid="@item.EmprestimoId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                            
                                            @if (item.estado == "Ativo")
                                            {
                                                <form asp-action="ReturnBook" asp-route-id="@item.EmprestimoId" method="post" class="d-inline ms-1">
                                                    <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Confirma a devolução deste exemplar?');">
                                                        Devolver
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>