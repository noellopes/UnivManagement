@model IEnumerable<UnivManagement.Models.Emprestimo>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.dataEmprestimo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.dataDevolucao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExemplarId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Exemplar)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.dataEmprestimo)
            </td>
            <td>
                @Html.DisplayFor(model => item.dataDevolucao)
            </td>
            <td>
                @Html.DisplayFor(model => item.estado)
            </td>
            <td>
                @Html.DisplayFor(model => item.ExemplarId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Exemplar)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EmprestimoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EmprestimoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EmprestimoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
