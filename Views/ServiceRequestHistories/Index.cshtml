@model IEnumerable<UnivManagement.Models.ServiceRequestHistory>

@{
    ViewData["Title"] = "Index";
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ServiceRequestId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OldStatusId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NewStatusId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Action)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Note)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChangedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.ServiceRequest?.Title
            </td>
            <td>
                @(item.OldStatus?.Name ?? "(none)")
            </td>
            <td>
                @(item.NewStatus?.Name ?? "(none)")
            </td>
            <td>
                @Html.DisplayFor(model => item.Action)
            </td>
            <td>
                @Html.DisplayFor(model => item.Note)
            </td>
            <td>
                @Html.DisplayFor(model => item.ChangedAt)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ServiceRequestHistoryId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ServiceRequestHistoryId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ServiceRequestHistoryId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
