@model UnivManagement.Models.ServiceRequestHistory

@{
    ViewData["Title"] = "Details";
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Details</h1>

<div>
    <h4>ServiceRequestHistory</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ServiceRequestId)
        </dt>
        <dd class="col-sm-10">
            @Model.ServiceRequest?.Title
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OldStatusId)
        </dt>
        <dd class="col-sm-10">
            @(Model.OldStatus?.Name ?? "(none)")
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NewStatusId)
        </dt>
        <dd class="col-sm-10">
            @(Model.NewStatus?.Name ?? "(none)")
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Action)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Action)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Note)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Note)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ChangedAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ChangedAt)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ServiceRequestHistoryId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
