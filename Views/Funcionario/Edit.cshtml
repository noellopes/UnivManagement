@model UnivManagement.Models.Funcionario

@{
    ViewData["Title"] = "Editar Funcionário";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="card shadow-sm border-0 rounded-3">
                <!-- Cabeçalho do Cartão -->
                <div class="card-header bg-warning text-white py-3">
                    <h4 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-pencil-square me-2"></i>Editar Funcionário
                    </h4>
                </div>

                <!-- Corpo do Formulário -->
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Campo Oculto para o ID -->
                        <input type="hidden" asp-for="FuncionarioId" />

                        <div class="row g-3">
                            <!-- Nome -->
                            <div class="col-md-8">
                                <label asp-for="Nome" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input asp-for="Nome" class="form-control" placeholder="Nome completo" />
                                </div>
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>

                            <!-- NIF -->
                            <div class="col-md-4">
                                <label asp-for="Nif" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-card-heading"></i></span>
                                    <input asp-for="Nif" class="form-control" placeholder="123456789" />
                                </div>
                                <span asp-validation-for="Nif" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="exemplo@univ.pt" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Telefone -->
                            <div class="col-md-6">
                                <label asp-for="Telefone" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Telefone" class="form-control" placeholder="912345678" />
                                </div>
                                <span asp-validation-for="Telefone" class="text-danger small"></span>
                            </div>

                            <!-- Morada -->
                            <div class="col-12">
                                <label asp-for="Morada" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Morada" class="form-control" placeholder="Rua, Número, Código Postal" />
                                </div>
                                <span asp-validation-for="Morada" class="text-danger small"></span>
                            </div>

                            <!-- Serviço (Dropdown) -->
                            <div class="col-md-6">
                                <label asp-for="ServicoFuncionarioId" class="form-label fw-bold">Serviço</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                                    <select asp-for="ServicoFuncionarioId" class="form-select" asp-items="ViewBag.ServicoFuncionarioId">
                                        <option value="">-- Selecione um Serviço --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="ServicoFuncionarioId" class="text-danger small"></span>
                            </div>

                            <!-- Data de Admissão -->
                            <div class="col-md-6">
                                <label asp-for="DataAdmissao" class="form-label fw-bold">Data de Admissão</label>
                                <input asp-for="DataAdmissao" class="form-control" type="date" />
                                <span asp-validation-for="DataAdmissao" class="text-danger small"></span>
                            </div>

                            <!-- Estado Ativo (Switch Dinâmico com Ícone) -->
                            <div class="col-12 mt-4">
                                <div class="form-check form-switch">
                                    <input asp-for="Ativo" class="form-check-input" type="checkbox" role="switch" id="switchAtivo" />
                                    <label class="form-check-label fw-bold" for="switchAtivo">
                                        <i id="statusIcon" class="bi bi-x-circle-fill me-1 text-danger"></i>
                                        <span id="statusLabel">Funcionário Inativo</span>
                                    </label>
                                </div>
                                <span asp-validation-for="Ativo" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Botões de Ação -->
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                                <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
                            </a>
                            <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm text-dark fw-bold">
                                <i class="bi bi-check-lg me-1"></i> Guardar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const switchAtivo = document.getElementById("switchAtivo");
            const statusIcon = document.getElementById("statusIcon");
            const statusLabel = document.getElementById("statusLabel");

            function atualizarStatus() {
                if (switchAtivo.checked) {
                    statusIcon.className = "bi bi-check-circle-fill me-1 text-success";
                    statusLabel.textContent = "Funcionário Ativo";
                } else {
                    statusIcon.className = "bi bi-x-circle-fill me-1 text-danger";
                    statusLabel.textContent = "Funcionário Inativo";
                }
            }

            // Executa para refletir o estado atual do funcionário registado na BD
            atualizarStatus();

            // Ouve alterações no toggle
            switchAtivo.addEventListener("change", atualizarStatus);
        });
    </script>
}