@model UnivManagement.Models.Funcionario

@{
    ViewData["Title"] = "Detalhes do Funcionário";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @* Alerta de sucesso *@
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                    <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                    @ViewBag.SuccessMessage
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>
                </div>
            }

            <div class="card shadow-sm border-0 rounded-3">
                <!-- Cabeçalho do Cartão -->
                <div class="card-header bg-info text-white py-3">
                    <h4 class="card-title mb-0 fw-bold">
                        <i class="bi bi-person-lines-fill me-2"></i>Detalhes do Funcionário
                    </h4>
                </div>

                <!-- Corpo dos Detalhes -->
                <div class="card-body p-4">

                    <div class="bg-light rounded p-4 mb-4">
                        <dl class="row mb-0 gy-3">
                            <!-- Nome -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-person me-1"></i> @Html.DisplayNameFor(model => model.Nome)
                            </dt>
                            <dd class="col-sm-8 fw-bold text-dark fs-5 mb-0">
                                @Html.DisplayFor(model => model.Nome)
                            </dd>

                            <hr class="my-2 text-muted" />

                            <!-- NIF -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-card-heading me-1"></i> @Html.DisplayNameFor(model => model.Nif)
                            </dt>
                            <dd class="col-sm-8 mb-0">
                                @Html.DisplayFor(model => model.Nif)
                            </dd>

                            <!-- Email -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-envelope me-1"></i> @Html.DisplayNameFor(model => model.Email)
                            </dt>
                            <dd class="col-sm-8 mb-0">
                                <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                            </dd>

                            <!-- Telefone -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-telephone me-1"></i> @Html.DisplayNameFor(model => model.Telefone)
                            </dt>
                            <dd class="col-sm-8 mb-0">
                                @Html.DisplayFor(model => model.Telefone)
                            </dd>

                            <!-- Morada -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-geo-alt me-1"></i> @Html.DisplayNameFor(model => model.Morada)
                            </dt>
                            <dd class="col-sm-8 mb-0">
                                @Html.DisplayFor(model => model.Morada)
                            </dd>

                            <hr class="my-2 text-muted" />

                            <!-- Nome do Serviço Relacionado -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-briefcase me-1"></i> Serviço
                            </dt>
                            <dd class="col-sm-8 fw-bold text-primary mb-0">
                                @(Model.Servico != null ? Model.Servico.Nome : "Sem Serviço Atribuído")
                            </dd>

                            <!-- Data de Admissão -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-calendar-event me-1"></i> Data de Admissão
                            </dt>
                            <dd class="col-sm-8 mb-0">
                                @Model.DataAdmissao.ToString("dd/MM/yyyy")
                            </dd>

                            <!-- Estado Ativo/Inativo -->
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-activity me-1"></i> Estado
                            </dt>
                            <dd class="col-sm-8 mb-0">
                                @if (Model.Ativo)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i> Inativo</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                            <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model?.FuncionarioId" class="btn btn-warning rounded-pill px-4 shadow-sm text-dark fw-bold">
                            <i class="bi bi-pencil-square me-1"></i> Editar
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>