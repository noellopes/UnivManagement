@model UnivManagement.Models.Funcionario

@{
    ViewData["Title"] = "Eliminar Funcionário";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-danger border-0 rounded-3">
                <!-- Cabeçalho do Cartão -->
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="card-title mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Eliminar Funcionário
                    </h4>
                </div>

                <!-- Corpo com Alerta e Detalhes -->
                <div class="card-body p-4">

                    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
                        <div>
                            <strong>Atenção!</strong> Tem a certeza de que pretende eliminar este funcionário? Esta ação não pode ser desfeita.
                        </div>
                    </div>

                    <div class="bg-light rounded p-3 mb-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-person me-1"></i> @Html.DisplayNameFor(model => model.Nome)
                            </dt>
                            <dd class="col-sm-8 fw-bold">
                                @Html.DisplayFor(model => model.Nome)
                            </dd>

                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-card-heading me-1"></i> @Html.DisplayNameFor(model => model.Nif)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Nif)
                            </dd>

                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-envelope me-1"></i> @Html.DisplayNameFor(model => model.Email)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Email)
                            </dd>

                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-telephone me-1"></i> @Html.DisplayNameFor(model => model.Telefone)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Telefone)
                            </dd>

                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-geo-alt me-1"></i> @Html.DisplayNameFor(model => model.Morada)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Morada)
                            </dd>

                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-briefcase me-1"></i> Serviço
                            </dt>
                            <!-- Exibe o Nome do Serviço em vez do ID -->
                            <dd class="col-sm-8 fw-bold text-primary">
                                @(Model.Servico != null ? Model.Servico.Nome : "Sem Serviço Atribuído")
                            </dd>

                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-calendar-event me-1"></i> Data de Admissão
                            </dt>
                            <dd class="col-sm-8">
                                @Model.DataAdmissao.ToString("dd/MM/yyyy")
                            </dd>

                            <dt class="col-sm-4 text-muted">
                                <i class="bi bi-activity me-1"></i> Estado
                            </dt>
                            <dd class="col-sm-8">
                                @if (Model.Ativo)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i> Inativo</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <!-- Form de Confirmação -->
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="FuncionarioId" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar e Voltar
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                                <i class="bi bi-trash-fill me-1"></i> Confirmar Eliminação
                            </button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>