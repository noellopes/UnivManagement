@using UnivManagement.Models
@model Documento;

@{
    ViewData["Title"] = "Registar Novo Documento";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card shadow-sm">

    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">
            <i class="bi bi-file-earmark-plus me-2"></i> Novo Documento
        </h4>
    </div>

    <div class="card-body">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

            <div class="row">
                <div class="col-md-6">

                    <div class="mb-3">
                        <label for="ficheiro" class="form-label fw-bold">Ficheiro</label>
                        <input type="file" name="ficheiro" id="ficheiro" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
                        <span class="text-danger small" data-valmsg-for="ficheiro" data-valmsg-replace="true"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DataEmissao" class="form-label fw-bold"></label>
                        <input asp-for="DataEmissao" type="date" class="form-control">
                        <span asp-validation-for="DataEmissao" class="text-danger small"></span>
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="mb-3">
                        <label asp-for="TipoDocumentoId" class="form-label fw-bold"></label>
                        <select asp-for="TipoDocumentoId" class="form-select" asp-items="ViewBag.TipoDocumentoId">
                            <option value="">-- Selecione o tipo --</option>
                        </select>
                        <span asp-validation-for="TipoDocumentoId" class="text-danger small"></span>
                    </div>

                    <input asp-for="DocumentoId" type="hidden" />

                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end gap-2 border-top pt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i> Submeter Registo
                </button>
                <a href="javascript:void(0);" onclick="history.back();" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle me-1"></i> Voltar
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}