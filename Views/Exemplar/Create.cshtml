@model UnivManagement.Models.Exemplar

@{
    ViewData["Title"] = "Novo Exemplar";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h4 class="mb-0">Novo Exemplar</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Codigo" class="form-label"></label>
                            <input asp-for="Codigo" class="form-control" placeholder="Ex.: EX-001" />
                            <span asp-validation-for="Codigo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ObraId" class="form-label"></label>
                            <select asp-for="ObraId" class="form-select" asp-items="ViewBag.ObraId">
                                <option value="">-- Selecionar Obra --</option>
                            </select>
                            <span asp-validation-for="ObraId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Estado" class="form-label"></label>
                            <select asp-for="Estado" class="form-select">
                                <option value="Disponível">Disponível</option>
                                <option value="Emprestado">Emprestado</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
                            <button type="submit" class="btn btn-primary">Guardar Exemplar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}