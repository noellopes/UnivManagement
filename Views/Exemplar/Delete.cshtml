@model UnivManagement.Models.Exemplar

@{
    ViewData["Title"] = "Eliminar Exemplar";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Eliminar Exemplar</h4>
                </div>
                <div class="card-body">
                    <p class="mb-3">Tem a certeza de que pretende eliminar este exemplar?</p>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Código</dt>
                        <dd class="col-sm-8">@Model.Codigo</dd>

                        <dt class="col-sm-4">Obra</dt>
                        <dd class="col-sm-8">
                            @(Model.Obra != null
                                ? $"{Model.Obra.Titulo} (#{Model.ObraId})"
                                : $"Obra #{Model.ObraId}")
                        </dd>

                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">@Model.Estado</dd>
                    </dl>
                </div>
                <div class="card-footer bg-white">
                    <form asp-action="Delete" asp-route-id="@Model.ExemplarId" method="post" class="d-flex justify-content-between">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ExemplarId" />
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger">Confirmar Eliminação</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>