@model IEnumerable<UnivManagement.Models.Exemplar>

@{
    ViewData["Title"] = "Exemplares";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Exemplares</h2>
            <small class="text-muted">Gestão de cópias físicas e disponibilidade no catálogo.</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Emprestimos" asp-action="Index" class="btn btn-outline-secondary">Ver Empréstimos</a>
            <a asp-action="Create" class="btn btn-primary">Novo Exemplar</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Obra</th>
                            <th>Estado</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    Ainda não existem exemplares registados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Codigo</td>
                                    <td>
                                        @(item.Obra != null
                                            ? $"{item.Obra.Titulo} (#{item.ObraId})"
                                            : $"Obra #{item.ObraId}")
                                    </td>
                                    <td>
                                        @if (item.Estado == "Disponível")
                                        {
                                            <span class="badge bg-success">Disponível</span>
                                        }
                                        else if (item.Estado == "Emprestado")
                                        {
                                            <span class="badge bg-warning text-dark">Emprestado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Estado</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Exemplar" asp-action="Edit" asp-route-id="@item.ExemplarId" class="btn btn-sm btn-outline-secondary">Editar</a>
                                        <a asp-controller="Exemplar" asp-action="Details" asp-route-id="@item.ExemplarId" class="btn btn-sm btn-outline-info">Detalhes</a>
                                        <a asp-controller="Exemplar" asp-action="Delete" asp-route-id="@item.ExemplarId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>