@model IEnumerable<UnivManagement.Models.Candidatura>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdAluno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estudante)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdOferta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Oferta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataCandidatura)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Curriculo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.IdAluno)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estudante)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdOferta)
            </td>
            <td>
                @Html.DisplayFor(model => item.Oferta)
            </td>
            <td>
                @Html.DisplayFor(model => item.DataCandidatura)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(model => item.Curriculo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdCandidatura">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdCandidatura">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdCandidatura">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
