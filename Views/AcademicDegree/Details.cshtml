@model UnivManagement.Models.AcademicManagement.AcademicDegree
@{
    ViewData["Title"] = "Detalhes do Grau Académico";
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-4">
    <h1 class="h2 mb-1">Detalhes do Grau Académico</h1>
    <p class="text-muted mb-0">Consulte a informação do grau académico selecionado.</p>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-body py-3">
        <h2 class="h5 mb-0">
            <i class="bi bi-mortarboard me-2" aria-hidden="true"></i>
            Dados do Grau Académico
        </h2>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-9 fw-semibold">
                @Html.DisplayFor(model => model.Name)
            </dd>

            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <span class="text-muted fst-italic">Sem descrição.</span>
                }
                else
                {
                    @Html.DisplayFor(model => model.Description)
                }
            </dd>
        </dl>
    </div>

    <div class="card-footer bg-body">
        <div class="d-flex justify-content-end flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                Voltar à Lista
            </a>

            <a asp-action="Edit" asp-route-id="@Model?.AcademicDegreeId" class="btn btn-primary">
                <i class="bi bi-pencil me-2" aria-hidden="true"></i>
                Editar
            </a>

            <a asp-action="Delete" asp-route-id="@Model?.AcademicDegreeId" class="btn btn-danger">
                <i class="bi bi-trash me-2" aria-hidden="true"></i>
                Eliminar
            </a>
        </div>
    </div>
</div>
