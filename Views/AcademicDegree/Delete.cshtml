@model UnivManagement.Models.AcademicManagement.AcademicDegree
@{
    ViewData["Title"] = "Eliminar Grau Académico";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Eliminar Grau Académico</h1>
    <p class="text-muted mb-0">Confirme a eliminação do grau académico selecionado.</p>
</div>

<div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-3 fs-4" aria-hidden="true"></i>
    <div>
        <strong>Atenção!</strong>
        Tem a certeza de que pretende eliminar este grau académico?
        Esta ação poderá ser irreversível.
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-body py-3">
        <h2 class="h5 mb-0">
            <i class="bi bi-mortarboard me-2" aria-hidden="true"></i>
            Dados do Grau Académico
        </h2>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-9 fw-semibold">
                @Html.DisplayFor(model => model.Name)
            </dd>

            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <span class="text-muted fst-italic">Sem descrição.</span>
                }
                else
                {
                    @Html.DisplayFor(model => model.Description)
                }
            </dd>
        </dl>
    </div>

    <div class="card-footer bg-body">
        <form asp-action="Delete">
            <input type="hidden" asp-for="AcademicDegreeId" />

            <div class="d-flex justify-content-end flex-wrap gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                    Voltar à Lista
                </a>

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-2" aria-hidden="true"></i>
                    Confirmar Eliminação
                </button>
            </div>
        </form>
    </div>
</div>