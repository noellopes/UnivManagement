@model IEnumerable<ServiceRequestPriority>

@{
    ViewData["Title"] = "Priorities";
}

<div class="container py-4">
    <a asp-controller="AdministrativeServices" asp-action="Index" class="link-secondary text-decoration-none">
        Back to Requests and Administrative Services
    </a>

    <header class="d-flex flex-wrap justify-content-between align-items-center my-4">
        <div>
            <h1 class="display-6 mb-0">Priorities</h1>
            <p class="text-body-secondary mb-0">How fast each request has to be answered.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">New priority</a>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Level)</th>
                        <th>Response days</th>
                        <th>@Html.DisplayNameFor(model => model.Color)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Level)</td>
                            <td>@Html.DisplayFor(modelItem => item.ResponseDays)</td>
                            <td><span class="badge text-bg-@item.Color">@item.Color</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.ServiceRequestPriorityId" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.ServiceRequestPriorityId" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.ServiceRequestPriorityId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            There are no priorities yet. Create the first one.
        </div>
    }
</div>
