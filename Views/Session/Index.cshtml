@model IEnumerable<UnivManagement.Models.Session>

@{
    ViewData["Title"] = "Gestão de Aulas";
}

<div class="container-fluid mt-4 px-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">Gestão de Aulas e Horários</h1>
            <p class="text-muted small mb-0">Consulte e gira os horários das sessões e turmas registadas.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i> Criar Nova Aula
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">
                                @Html.DisplayNameFor(model => model.DiaSemana)
                            </th>
                            <th class="text-center">Horário</th>
                            <th class="text-center">
                                @Html.DisplayNameFor(model => model.TipoAula)
                            </th>
                            <th class="text-center">
                                @Html.DisplayNameFor(model => model.Group)
                            </th>
                            <th class="text-center">
                                @Html.DisplayNameFor(model => model.IdSala)
                            </th>
                            <th class="text-center">
                                @Html.DisplayNameFor(model => model.Ativo)
                            </th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
@foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                <i class="bi bi-calendar3 me-1 text-primary"></i>
                                @Html.DisplayFor(model => item.DiaSemana)
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-clock me-1 text-muted"></i>
                                    @Html.DisplayFor(model => item.HoraInicio) - @Html.DisplayFor(model => item.HoraFim)
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-1">
                                    @Html.DisplayFor(model => item.TipoAula)
                                </span>
                            </td>
                            <td class="text-center fw-semibold text-dark">
                                @Html.DisplayFor(model => item.Group)
                            </td>
                            <td class="text-center text-muted">
                                @Html.DisplayFor(model => item.IdSala)
                            </td>
                            <td class="text-center">
                                @if (item.Ativo) {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        Ativo
                                    </span>
                                } else {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                                        Inativo
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Ações">
                                    <a asp-action="Edit" asp-route-id="@item.ClassSessionId" class="btn btn-outline-primary" title="Editar">
                                        Editar
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.ClassSessionId" class="btn btn-outline-info" title="Detalhes">
                                        Detalhes
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ClassSessionId" class="btn btn-outline-danger" title="Eliminar">
                                        Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>