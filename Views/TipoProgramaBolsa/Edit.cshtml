@model UnivManagement.Models.TipoProgramaBolsa

@{
    ViewData["Title"] = "Editar Tipo de Bolsa";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold mb-2">Editar Tipo de Bolsa</h1>
        <p class="text-secondary">
            Atualize as informações do tipo de bolsa.
        </p>
    </div>

    <div class="card shadow-sm border-0"
         style="border-radius: 0.5rem; max-width: 750px;">

        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-idtipoprograma="@Model.IdTipoPrograma"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <input type="hidden" asp-for="IdTipoPrograma" />

                <div class="mb-3">
                    <label asp-for="NomeTipo"
                           class="form-label fw-semibold">
                        Nome do tipo
                    </label>

                    <input asp-for="NomeTipo"
                           class="form-control"
                           placeholder="Nome do tipo de bolsa" />

                    <span asp-validation-for="NomeTipo"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Descricao"
                           class="form-label fw-semibold">
                        Descrição
                    </label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="4"
                              placeholder="Descrição do tipo de bolsa">
                    </textarea>

                    <span asp-validation-for="Descricao"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn text-white"
                            style="background-color: #1d4e6b;">
                        Guardar alterações
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
