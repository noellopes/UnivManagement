@model IEnumerable<UnivManagement.Models.TipoProgramaBolsa>

@{
    ViewData["Title"] = "Tipos de Bolsa";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-2">Tipos de Bolsa</h1>
            <p class="text-secondary mb-0">
                Gerir os diferentes tipos de bolsas de estudo.
            </p>
        </div>

        <a asp-action="Create"
           class="btn text-white mt-3 mt-md-0"
           style="background-color: #e8a33d;">
            + Adicionar tipo
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <strong>Sucesso!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            <strong>Erro!</strong>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Types Table -->
    <div class="card shadow-sm border-0"
         style="border-radius: 0.5rem;">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead style="background-color: #f6f8fa;">
                            <tr>
                                <th class="py-3 px-4">Nome do tipo</th>
                                <th class="py-3">Descrição</th>
                                <th class="py-3 text-end px-4">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 fw-semibold">
                                        @item.NomeTipo
                                    </td>

                                    <td class="text-secondary">
                                        @item.Descricao
                                    </td>

                                    <td class="text-end px-4">
                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-action="Edit"
                                               asp-route-idtipoprograma="@item.IdTipoPrograma"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>

                                            <a asp-action="Details"
                                               asp-route-idtipoprograma="@item.IdTipoPrograma"
                                               class="btn btn-sm btn-outline-secondary">
                                                Detalhes
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-idtipoprograma="@item.IdTipoPrograma"
                                               class="btn btn-sm btn-outline-danger">
                                                Eliminar
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h2 class="h5 fw-bold mb-2">
                        Ainda não existem tipos de bolsa
                    </h2>

                    <p class="text-secondary mb-3">
                        Adicione o primeiro tipo de bolsa para começar.
                    </p>

                    <a asp-action="Create"
                       class="btn text-white"
                       style="background-color: #1d4e6b;">
                        Adicionar primeiro tipo
                    </a>

                </div>
            }

        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="GestaoBolsas"
           asp-action="Index"
           class="text-decoration-none">
            ← Voltar à gestão de bolsas
        </a>
    </div>

</div>
