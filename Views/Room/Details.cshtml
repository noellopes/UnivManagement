@model UnivManagement.Models.Room

@{
    ViewData["Title"] = "Detalhes da Sala";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-info-circle-fill text-info me-2"></i>Detalhes da Sala
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Voltar à Lista
        </a>
    </div>


    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.NumeroSala)</dt>
                <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.NumeroSala)</dd>

                <dt class="col-sm-4 text-muted mt-2">@Html.DisplayNameFor(model => model.Edificio)</dt>
                <dd class="col-sm-8 mt-2">@Html.DisplayFor(model => model.Edificio!.NomeEdificio)</dd>

                <dt class="col-sm-4 text-muted mt-2">@Html.DisplayNameFor(model => model.Piso)</dt>
                <dd class="col-sm-8 mt-2">Piso @Html.DisplayFor(model => model.Piso)</dd>

                <dt class="col-sm-4 text-muted mt-2">@Html.DisplayNameFor(model => model.TipoSala)</dt>
                <dd class="col-sm-8 mt-2">@Html.DisplayFor(model => model.TipoSala!.Designacao)</dd>

                <dt class="col-sm-4 text-muted mt-2">@Html.DisplayNameFor(model => model.Lotacao)</dt>
                <dd class="col-sm-8 mt-2">@Html.DisplayFor(model => model.Lotacao) lugares</dd>

                <dt class="col-sm-4 text-muted mt-2">@Html.DisplayNameFor(model => model.Estado)</dt>
                <dd class="col-sm-8 mt-2">
                    @if (Model.Estado == "Ativa")
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">@Model.Estado</span>
                    }
                    else if (Model.Estado == "Manutenção")
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">@Model.Estado</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">@Model.Estado</span>
                    }
                </dd>
            </dl>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light border">Voltar</a>
                <a asp-action="Edit" asp-route-id="@Model?.RoomId" class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
            </div>
        </div>
    </div>
</div>