
@model UnivManagement.Models.Room

@{
    ViewData["Title"] = "Detalhes da Sala";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                    @ViewBag.SuccessMessage

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Fechar">
                    </button>
                </div>
            }

            <div class="card border-0 shadow rounded-4">

                <!-- Cabeçalho -->
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3 class="mb-1">🏫 Detalhes da Sala</h3>
                    <p class="mb-0 opacity-75">
                        Consulte as informações da sala.
                    </p>
                </div>

                <div class="card-body p-4">

                    <!-- Título da secção -->
                    <h5 class="fw-semibold mb-4">
                        Informações da Sala
                    </h5>

                    <div class="row g-3">

                        <!-- Número da Sala -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.NumeroSala)
                            </label>
                            <div class="form-control bg-light">
                                @Html.DisplayFor(model => model.NumeroSala)
                            </div>
                        </div>

                        <!-- Piso -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Piso)
                            </label>
                            <div class="form-control bg-light">
                                @Html.DisplayFor(model => model.Piso)
                            </div>
                        </div>

                        <!-- Lotação -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Lotacao)
                            </label>
                            <div class="form-control bg-light">
                                @Model.Lotacao lugares
                            </div>
                        </div>

                        <!-- Estado Operacional -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Estado)
                            </label>
                            <div>
                                <span class="badge bg-secondary fs-6 px-3 py-2">
                                    @Html.DisplayFor(model => model.Estado)
                                </span>
                            </div>
                        </div>

                        <!-- Edifício -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                Edifício
                            </label>
                            <div class="form-control bg-light">
                                @(Model.Edificio?.NomeEdificio ?? "Edifício não encontrado")
                            </div>
                        </div>

                        <!-- Tipo de Sala -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                Tipo de Sala
                            </label>
                            <div class="form-control bg-light">
                                @(Model.TipoSala?.Designacao ?? "Tipo de sala não encontrado")
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Botões -->
                    <div class="d-flex justify-content-between gap-2">

                        <a asp-controller="Room"
                           asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                            ← Voltar
                        </a>

                        <a asp-controller="Room"
                           asp-action="Edit"
                           asp-route-id="@Model.RoomId"
                           class="btn btn-primary px-4">
                            ✏️ Editar Sala
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
