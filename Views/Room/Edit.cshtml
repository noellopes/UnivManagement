@model UnivManagement.Models.Room

@{
    ViewData["Title"] = "Editar Sala";
}

<div class="container py-4" style="max-width: 820px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-pencil-square text-warning me-2"></i>Editar Sala
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Voltar à Lista
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="RoomId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NumeroSala" class="form-label fw-semibold"></label>
                        <input asp-for="NumeroSala" class="form-control" />
                        <span asp-validation-for="NumeroSala" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdEdificio" class="form-label fw-semibold"></label>
                        <select asp-for="IdEdificio" class="form-select" asp-items="ViewBag.IdEdificio"></select>
                        <span asp-validation-for="IdEdificio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Piso" class="form-label fw-semibold"></label>
                        <input asp-for="Piso" type="number" class="form-control" />
                        <span asp-validation-for="Piso" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Lotacao" class="form-label fw-semibold"></label>
                        <input asp-for="Lotacao" type="number" class="form-control" />
                        <span asp-validation-for="Lotacao" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Estado" class="form-label fw-semibold"></label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Ativa">Ativa</option>
                            <option value="Manutenção">Manutenção</option>
                            <option value="Inativa">Inativa</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="IdTipoSala" class="form-label fw-semibold"></label>
                        <select asp-for="IdTipoSala" class="form-select" asp-items="ViewBag.IdTipoSala"></select>
                        <span asp-validation-for="IdTipoSala" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light border">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}