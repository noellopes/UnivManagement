
@model UnivManagement.Models.Room

@{
    ViewData["Title"] = "Eliminar Sala";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="card border-0 shadow rounded-4">

                <!-- Cabeçalho -->
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3 class="mb-1">🗑️ Eliminar Sala</h3>
                    <p class="mb-0 opacity-75">
                        Confirme os dados antes de eliminar a sala.
                    </p>
                </div>

                <div class="card-body p-4">

                    <!-- Aviso de confirmação -->
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"
                           aria-hidden="true"></i>

                        <strong>Atenção!</strong>
                        Tem a certeza de que pretende eliminar esta sala?
                        Esta operação não poderá ser anulada.

                        <p class="mb-0 mt-2">
                            Não será possível eliminar a sala se possuir
                            reservas ou aulas associadas.
                        </p>
                    </div>

                    <h5 class="fw-semibold mb-4">
                        Informações da Sala
                    </h5>

                    <div class="row g-3">

                        <!-- Número da Sala -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.NumeroSala)
                            </label>

                            <div class="form-control bg-light">
                                @Html.DisplayFor(model => model.NumeroSala)
                            </div>
                        </div>

                        <!-- Piso -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Piso)
                            </label>

                            <div class="form-control bg-light">
                                @Html.DisplayFor(model => model.Piso)
                            </div>
                        </div>

                        <!-- Lotação -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Lotacao)
                            </label>

                            <div class="form-control bg-light">
                                @Model.Lotacao lugares
                            </div>
                        </div>

                        <!-- Estado Operacional -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Estado)
                            </label>

                            <div>
                                <span class="badge bg-secondary fs-6 px-3 py-2">
                                    @Html.DisplayFor(model => model.Estado)
                                </span>
                            </div>
                        </div>

                        <!-- Edifício -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                Edifício
                            </label>

                            <div class="form-control bg-light">
                                @(Model.Edificio?.NomeEdificio ?? "Edifício não encontrado")
                            </div>
                        </div>

                        <!-- Tipo de Sala -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                Tipo de Sala
                            </label>

                            <div class="form-control bg-light">
                                @(Model.TipoSala?.Designacao ?? "Tipo de sala não encontrado")
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Formulário de eliminação -->
                    <form asp-controller="Room"
                          asp-action="Delete"
                          asp-route-id="@Model.RoomId"
                          method="post">

                        <input type="hidden" asp-for="RoomId" />

                        <div class="d-flex justify-content-between gap-2">

                            <!-- Cancelar -->
                            <a asp-controller="Room"
                               asp-action="Details"
                               asp-route-id="@Model.RoomId"
                               class="btn btn-outline-secondary px-4">
                                ← Cancelar
                            </a>

                            <!-- Confirmar eliminação -->
                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash me-2"></i>
                                Confirmar Eliminação

                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
