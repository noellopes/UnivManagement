@model UnivManagement.Models.AcademicManagement.UC

@{
    ViewData["Title"] = "Criar Unidade Curricular";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

        <div class="mb-4">
            <h1 class="h2 mb-1">Criar Unidade Curricular</h1>
            <p class="text-body-secondary mb-0">
                Adicionar uma nova unidade curricular à universidade.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body-tertiary py-3">
                <h2 class="h5 mb-0">
                    <i class="bi bi-book me-2" aria-hidden="true"></i>
                    Informação da nova Unidade Curricular
                </h2>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label fw-semibold"></label>

                            <input asp-for="Code"
                                   class="form-control"
                                   placeholder="Ex.: LEI-IP"
                                   autofocus />

                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-semibold"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Introduza o nome da UC" />

                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Acronym" class="form-label fw-semibold"></label>

                            <input asp-for="Acronym"
                                   class="form-control"
                                   placeholder="Introduza a sigla da UC" />

                            <span asp-validation-for="Acronym" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ValueECTS" class="form-label fw-semibold"></label>

                            <input asp-for="ValueECTS"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   max="300" />

                            <span asp-validation-for="ValueECTS" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="NumHours" class="form-label fw-semibold"></label>

                            <input asp-for="NumHours"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   max="1000" />

                            <span asp-validation-for="NumHours" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="StudyPlanId" class="form-label fw-semibold">
                                Plano de Estudos
                                <span class="text-muted fw-normal">(opcional)</span>
                            </label>

                            <select asp-for="StudyPlanId"
                                    class="form-select"
                                    asp-items="ViewBag.StudyPlans">
                                <option value="">-- Sem plano de estudos --</option>
                            </select>

                            <span asp-validation-for="StudyPlanId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Introduza a descrição da UC"></textarea>

                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                            Criar Unidade Curricular
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                            Voltar à Lista
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
