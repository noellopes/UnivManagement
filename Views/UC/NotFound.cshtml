@{
    ViewData["Title"] = "UC não encontrada";
}

<div class="alert alert-danger border-0 shadow-sm rounded-4 p-4 d-flex align-items-start gap-3 mt-4" role="alert">
    <div class="bg-danger-subtle text-danger rounded-3 p-3 flex-shrink-0">
        <i class="bi bi-exclamation-triangle-fill fs-3" aria-hidden="true"></i>
    </div>

    <div class="flex-grow-1">
        <h4 class="alert-heading fs-5 fw-semibold mb-2">
            Unidade Curricular não encontrada
        </h4>

        <p class="mb-3">
            A Unidade Curricular selecionada não foi encontrada. É possível que tenha sido eliminada ou já não esteja disponível.
        </p>

        <hr class="border-danger opacity-25">

        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            <a asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                Voltar à Lista de UCs
            </a>
            <span class="text-body-secondary small">
                Regressa à lista para continuar a navegar.
            </span>
        </div>
    </div>
</div>