@model UnivManagement.Models.RoomType

@{
    ViewData["Title"] = "Detalhes do Tipo de Sala";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-info-circle-fill text-info me-2"></i>Detalhes do Tipo de Sala
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Voltar à Lista
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Designacao)</dt>
                <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Designacao)</dd>

                <dt class="col-sm-4 text-muted mt-2">@Html.DisplayNameFor(model => model.RequerComputadores)</dt>
                <dd class="col-sm-8 mt-2">
                    @if (Model.RequerComputadores)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="bi bi-pc-display me-1"></i>Sim
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                            Não
                        </span>
                    }
                </dd>
            </dl>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light border">Voltar</a>
                <a asp-action="Edit" asp-route-id="@Model?.RoomTypeId" class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
            </div>
        </div>
    </div>
</div>