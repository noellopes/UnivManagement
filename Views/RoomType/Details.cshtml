
@model UnivManagement.Models.RoomType

@{
    ViewData["Title"] = "Detalhes do Tipo de Sala";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">

                    <i class="bi bi-check-circle me-2"
                       aria-hidden="true"></i>

                    @ViewBag.SuccessMessage

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Fechar">
                    </button>
                </div>
            }

            <div class="card border-0 shadow rounded-4">

                <!-- Cabeçalho -->
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3 class="mb-1">🏫 Detalhes do Tipo de Sala</h3>
                    <p class="mb-0 opacity-75">
                        Consulte as informações do tipo de sala.
                    </p>
                </div>

                <div class="card-body p-4">

                    <!-- Título da secção -->
                    <h5 class="fw-semibold mb-4">
                        Informações do Tipo de Sala
                    </h5>

                    <div class="row g-3">

                        <!-- Designação -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Designacao)
                            </label>

                            <div class="form-control bg-light">
                                @Html.DisplayFor(model => model.Designacao)
                            </div>
                        </div>

                        <!-- Requer Computadores -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.RequerComputadores)
                            </label>

                            <div>
                                @if (Model.RequerComputadores)
                                {
                                    <span class="badge bg-success fs-6 px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Sim
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6 px-3 py-2">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Não
                                    </span>
                                }
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Botões -->
                    <div class="d-flex justify-content-between gap-2">

                        <a asp-controller="RoomType"
                           asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                            ← Voltar
                        </a>

                        <a asp-controller="RoomType"
                           asp-action="Edit"
                           asp-route-id="@Model.RoomTypeId"
                           class="btn btn-primary px-4">
                            ✏️ Editar Tipo de Sala
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
