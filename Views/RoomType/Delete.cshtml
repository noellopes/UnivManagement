
@model UnivManagement.Models.RoomType

@{
    ViewData["Title"] = "Eliminar Tipo de Sala";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="card border-0 shadow rounded-4">

                <!-- Cabeçalho -->
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3 class="mb-1">🗑️ Eliminar Tipo de Sala</h3>
                    <p class="mb-0 opacity-75">
                        Confirme os dados antes de eliminar o tipo de sala.
                    </p>
                </div>

                <div class="card-body p-4">

                    <!-- Aviso de confirmação -->
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"
                           aria-hidden="true"></i>

                        <strong>Atenção!</strong>
                        Tem a certeza de que pretende eliminar este tipo de sala?
                        Esta operação não poderá ser anulada.

                        <p class="mb-0 mt-2">
                            Não será possível eliminar o tipo de sala
                            se existirem salas associadas.
                        </p>
                    </div>

                    <!-- Informações do Tipo de Sala -->
                    <h5 class="fw-semibold mb-4">
                        Informações do Tipo de Sala
                    </h5>

                    <div class="row g-3">

                        <!-- Designação -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Designacao)
                            </label>

                            <div class="form-control bg-light">
                                @Html.DisplayFor(model => model.Designacao)
                            </div>
                        </div>

                        <!-- Requer Computadores -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.RequerComputadores)
                            </label>

                            <div>
                                @if (Model.RequerComputadores)
                                {
                                    <span class="badge bg-success fs-6 px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Sim
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6 px-3 py-2">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Não
                                    </span>
                                }
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Formulário de eliminação -->
                    <form asp-controller="RoomType"
                          asp-action="Delete"
                          asp-route-id="@Model.RoomTypeId"
                          method="post">

                        <!-- Identificador do Tipo de Sala -->
                        <input type="hidden" asp-for="RoomTypeId" />

                        <div class="d-flex justify-content-between gap-2">

                            <!-- Cancelar -->
                            <a asp-controller="RoomType"
                               asp-action="Details"
                               asp-route-id="@Model.RoomTypeId"
                               class="btn btn-outline-secondary px-4">

                                ← Cancelar

                            </a>

                            <!-- Confirmar eliminação -->
                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash me-2"></i>
                                Confirmar Eliminação

                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
