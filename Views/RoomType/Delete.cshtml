@model UnivManagement.Models.RoomType

@{
    ViewData["Title"] = "Eliminar Tipo de Sala";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-danger mb-0">
            <i class="bi bi-trash-fill me-2"></i>Eliminar Tipo de Sala
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Voltar à Lista
        </a>
    </div>

    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
        <div>Tem a certeza que pretende eliminar este tipo de sala? Esta ação não pode ser revertida.</div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Designacao)</dt>
                <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Designacao)</dd>

                <dt class="col-sm-4 text-muted mt-2">@Html.DisplayNameFor(model => model.RequerComputadores)</dt>
                <dd class="col-sm-8 mt-2">
                    @(Model.RequerComputadores ? "Sim" : "Não")
                </dd>
            </dl>

            <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <input type="hidden" asp-for="RoomTypeId" />
                <a asp-action="Index" class="btn btn-light border">Cancelar</a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i>Eliminar
                </button>
            </form>
        </div>
    </div>
</div>