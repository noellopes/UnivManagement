@model UnivManagement.Models.AvaliacaoUC

@{
    ViewData["Title"] = "Editar Avaliação";
}

<div class="container mt-4">

    <h2 class="mb-4">Editar Avaliação</h2>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            Dados da Avaliação
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <input type="hidden" asp-for="AvaliacaoUCId" />

                <div class="mb-3">
                    <label asp-for="TipoAvaliacaoId" class="form-label"></label>

                    <select asp-for="TipoAvaliacaoId"
                            asp-items="ViewBag.TiposAvaliacao"
                            class="form-select">
                        <option value="">-- Selecionar Época --</option>
                    </select>

                    <span asp-validation-for="TipoAvaliacaoId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UcId" class="form-label"></label>

                    <select asp-for="UcId"
                            asp-items="ViewBag.UnidadesCurriculares"
                            class="form-select">
                        <option value="">-- Selecionar Unidade Curricular --</option>
                    </select>

                    <span asp-validation-for="UcId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tipo" class="form-label"></label>

                    <select asp-for="Tipo"
                            asp-items="ViewBag.Tipos"
                            class="form-select">
                        <option value="">-- Selecionar Tipo de Avaliação --</option>
                    </select>

                    <span asp-validation-for="Tipo"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Avaliacao" class="form-label"></label>

                    <input asp-for="Avaliacao"
                           class="form-control"
                           placeholder="Nome da avaliação" />

                    <span asp-validation-for="Avaliacao"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Data" class="form-label"></label>

                    <input asp-for="Data" class="form-control" />

                    <span asp-validation-for="Data"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Guardar Alterações
                    </button>

                    <a asp-action="IndexDocente"
                       class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
