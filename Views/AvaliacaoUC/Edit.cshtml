@model UnivManagement.Models.AvaliacaoUC

@{
    ViewData["Title"] = "Editar Avaliação";
}

<div class="container mt-4">

    <h2 class="mb-4">Editar Avaliação</h2>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            Dados da Avaliação
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <input type="hidden" asp-for="AvaliacaoID" />

                <div class="mb-3">
                    <label asp-for="T_Avaliacao"
                           class="form-label">
                        Tipo de Avaliação
                    </label>

                    <input asp-for="T_Avaliacao"
                           class="form-control" />

                    <span asp-validation-for="T_Avaliacao"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UcID"
                           class="form-label">
                        Unidade Curricular
                    </label>

                    <input asp-for="UcID"
                           class="form-control" />

                    <span asp-validation-for="UcID"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Data"
                           class="form-label">
                        Data da Avaliação
                    </label>

                    <input asp-for="Data"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Data"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-success">
                        Guardar Alterações
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
