@model IEnumerable<UnivManagement.Models.AvaliacaoUC>

@{
    ViewData["Title"] = "Avaliações";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestão de Avaliações</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nova Avaliação
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Tipo de Avaliação</th>
                        <th>Unidade Curricular</th>
                        <th>Data</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.T_Avaliacao</td>
                            <td>@item.UcID</td>
                            <td>@item.Data.ToString("dd/MM/yyyy")</td>

                            <td class="text-center">
                                <a asp-action="Edit"
                                   asp-route-id="@item.AvaliacaoID"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.AvaliacaoID"
                                   class="btn btn-info btn-sm">
                                    Detalhes
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.AvaliacaoID"
                                   class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    Ainda não existem avaliações registadas.
                </div>
            }

        </div>
    </div>
</div>
