@model IEnumerable<ServiceRequestAttachment>

@{
    ViewData["Title"] = "Attachments";
}

<div class="container py-4">
    <a asp-controller="AdministrativeServices" asp-action="Index" class="link-secondary text-decoration-none">
        Back to Requests and Administrative Services
    </a>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
            @ViewBag.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <header class="d-flex flex-wrap justify-content-between align-items-center my-4">
        <div>
            <h1 class="display-6 mb-0">Attachments</h1>
            <p class="text-body-secondary mb-0">Documents attached to the service requests.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">New attachment</a>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.FileName)</th>
                        <th>Request</th>
                        <th>@Html.DisplayNameFor(model => model.SizeInKb)</th>
                        <th>@Html.DisplayNameFor(model => model.UploadedAt)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.FileName)</td>
                            <td>@item.ServiceRequest?.Title</td>
                            <td>@Html.DisplayFor(modelItem => item.SizeInKb)</td>
                            <td>@item.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.ServiceRequestAttachmentId" class="btn btn-sm btn-outline-secondary" title="Details" aria-label="Details">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ServiceRequestAttachmentId" class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ServiceRequestAttachmentId" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            There are no attachments yet. Create the first one.
        </div>
    }
</div>
