@model IEnumerable<UnivManagement.Models.EstadoCandidatura>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.nome_estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.descricao)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.nome_estado)
            </td>
            <td>
                @Html.DisplayFor(model => item.descricao)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EstadoCandidaturaId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EstadoCandidaturaId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EstadoCandidaturaId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
