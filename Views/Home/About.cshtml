@{
    ViewData["Title"] = "About";
}

<div class="container py-4">
    <header class="text-center mb-5">
        <h1 class="display-5">About the Project</h1>
        <p class="lead text-body-secondary">
            University Campus Management Platform
        </p>
    </header>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <section class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">Project Overview</h2>
                    <p>
                        The University Campus Management Platform is a web application
                        designed to bring together a range of university services in a
                        single system. It aims to simplify the management of academic
                        activities, campus resources, student services, and administrative
                        processes.
                    </p>
                    <p class="mb-0">
                        The platform is developed as an academic project, providing an
                        opportunity to apply software development principles and web
                        technologies to a practical university management scenario.
                    </p>
                </div>
            </section>

            <section class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">Academic Context</h2>
                    <p>
                        This project is developed within the Computer Science programme
                        at the Polytechnic University of Guarda, as part of the following
                        courses:
                    </p>
                    <ul class="mb-0">
                        <li>Internet Programming</li>
                        <li>Software Engineering II</li>
                    </ul>
                </div>
            </section>

            <section class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">Technologies</h2>
                    <p>
                        The application uses modern web development technologies,
                        including:
                    </p>
                    <ul class="mb-0">
                        <li>ASP.NET Core and C#</li>
                        <li>HTML, CSS, JavaScript, and Bootstrap</li>
                        <li>SQL Server and Entity Framework Core</li>
                        <li>Git and GitHub for version control and collaboration</li>
                    </ul>
                </div>
            </section>
        </div>
    </div>
</div>