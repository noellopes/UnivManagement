@{
    ViewData["Title"] = "Home";
}

<div class="container py-4">
    <header class="text-center mb-5">
        <h1 class="display-5">University Campus Management</h1>
        <p class="lead text-body-secondary">
            Access the services and resources available across the university.
        </p>
    </header>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Academic Management</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Manage academic programs, study plans, course units, enrolments, and the academic calendar.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Open module
                    </button>
                </div>
            </div>
        </div>


        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Timetables and Room Management</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Manage buildings, rooms, class timetables, reservations, and availability.
                    </p>
                    <a asp-controller="Scheduling"
                       asp-action="Index"
                       class="btn btn-outline-primary w-100">
                        Open module
                    </a>
                </div>
            </div>
        </div>


        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Assessments and Assignments</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Manage exams, registrations, grades, assignments, submissions, and feedback.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Open module
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Library Management</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Manage books, catalogue searches, loans, returns, reservations, and overdue items.
                    </p>
                    <a asp-controller="Biblioteca"
                       asp-action="Index"
                       class="btn btn-outline-primary w-100">
                        Open module
                    </a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Accommodation Management</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Manage residences, rooms, applications, allocations, contracts, and occupancy.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Open module
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Cafeteria and Food Services</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Manage cafeterias, menus, meal reservations, prices, allergens, and personnel records.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Open module
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Scholarship Management</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Manage scholarship programs, applications, eligibility, evaluations, awards, and payments.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Open module
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Alumni, Internships, and Career Management</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Manage alumni profiles, employers, job opportunities, internships, and career progression.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Open module
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Requests and Administrative Services</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Manage administrative requests, certificates, support services, maintenance, and request status.
                    </p>
                    <a asp-controller="Requests" asp-action="Index" class="btn btn-outline-primary w-100">
                        Open module
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>