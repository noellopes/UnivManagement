@model UnivManagement.Models.Tecnico

@{
    ViewData["Title"] = "Editar técnico";
}

<div class="container py-4">
    <!-- Main Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1" style="color: #174966;">Editar técnico</h1>
            <p class="text-muted small mb-0">
                Altere os dados e o departamento deste técnico.
            </p>
        </div>
        <div class="mt-2 mt-sm-0">
            <a asp-action="Index"
               class="btn btn-outline-secondary bg-white text-dark border px-3 py-2"
               style="border-radius: 6px;">
                Voltar à lista
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card border-0 shadow-sm bg-white" style="border-top: 3px solid #e5a93b !important; border-radius: 8px;">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <input type="hidden" asp-for="TecnicoId" />

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label text-dark">Nome</label>
                            <input asp-for="Nome"
                                   class="form-control" />
                            <span asp-validation-for="Nome"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-dark">Email</label>
                            <input asp-for="Email"
                                   class="form-control" />
                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DepartamentoId" class="form-label text-dark">Departamento</label>
                            <select asp-for="DepartamentoId"
                                    class="form-select"
                                    asp-items="ViewBag.DepartamentoId">
                                <option value="">-- Selecione um departamento --</option>
                            </select>
                            <span asp-validation-for="DepartamentoId"
                                  class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit"
                                    class="btn text-white px-3 py-2"
                                    style="background-color: #174966; border-color: #174966; border-radius: 6px;">
                                Guardar alterações
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary bg-white text-dark border px-3 py-2"
                               style="border-radius: 6px;">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}