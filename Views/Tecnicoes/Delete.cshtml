@model UnivManagement.Models.Tecnico

@{
    ViewData["Title"] = "Eliminar Técnico";
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="mb-4">
                <h1 class="h2 mb-1">Eliminar Técnico</h1>
                <p class="text-body-secondary mb-0">
                    Tem a certeza de que pretende eliminar este técnico?
                </p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-body-tertiary py-3">
                    <h2 class="h5 mb-0 text-danger">
                        <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                        Confirmar Eliminação
                    </h2>
                </div>

                <div class="card-body p-4">
                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Nome</dt>
                        <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Nome)</dd>

                        <dt class="col-sm-4 text-muted">Email</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                        <dt class="col-sm-4 text-muted mb-0">Departamento</dt>
                        <dd class="col-sm-8 mb-0">@Html.DisplayFor(model => model.Departamento!.Nome)</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="TecnicoId" />

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill me-1" aria-hidden="true"></i>
                                Eliminar Técnico
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                                Voltar à Lista
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>