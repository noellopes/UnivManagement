@model UnivManagement.Models.Tecnico

@{
    ViewData["Title"] = "Detalhes do Técnico";
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                    @ViewBag.SuccessMessage
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Fechar">
                    </button>
                </div>
            }

            <div class="mb-4">
                <h1 class="h2 mb-1">Detalhes do Técnico</h1>
                <p class="text-body-secondary mb-0">
                    Consultar os dados completos deste técnico.
                </p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-body-tertiary py-3">
                    <h2 class="h5 mb-0">
                        <i class="bi bi-person-badge me-2" aria-hidden="true"></i>
                        Informação do Técnico
                    </h2>
                </div>

                <div class="card-body p-4">
                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Nome</dt>
                        <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Nome)</dd>

                        <dt class="col-sm-4 text-muted">Email</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                        <dt class="col-sm-4 text-muted mb-0">Departamento</dt>
                        <dd class="col-sm-8 mb-0">@Html.DisplayFor(model => model.Departamento!.Nome)</dd>
                    </dl>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.TecnicoId" class="btn btn-primary">
                            <i class="bi bi-pencil-fill me-1" aria-hidden="true"></i>
                            Editar
                        </a>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                            Voltar à Lista
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>