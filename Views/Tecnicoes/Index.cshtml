@model IEnumerable<UnivManagement.Models.Tecnico>

@{
    ViewData["Title"] = "Técnicos";
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @ViewBag.SuccessMessage
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

<!-- Main Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom">
    <div>
        <h1 class="h2 text-body-emphasis fw-bold mb-1">Diretório de Técnicos</h1>
        <p class="text-muted small mb-0">Gerir os técnicos e os respetivos departamentos.</p>
    </div>
    <div class="mt-2 mt-sm-0">
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm w-100 w-sm-auto">
            <i class="bi bi-plus-lg"></i> Criar Novo
        </a>
    </div>
</div>

<!-- Data Table inside a Responsive Card -->
<div class="card shadow-sm border-0 bg-body-tertiary">
    <div class="table-responsive rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light fs-7 text-muted border-bottom">
                <tr>
                    <th class="py-3 px-4">Nome</th>
                    <th class="py-3 px-4">Email</th>
                    <th class="py-3 px-4">Departamento</th>
                    <th class="py-3 pe-4 text-end" style="width: 180px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            Nenhum técnico encontrado.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 text-body-emphasis">
                                @Html.DisplayFor(model => item.Nome)
                            </td>
                            <td class="px-4 text-secondary">
                                @Html.DisplayFor(model => item.Email)
                            </td>
                            <td class="px-4 text-secondary">
                                @Html.DisplayFor(model => item.Departamento!.Nome)
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Ações do Técnico">
                                    <a asp-action="Edit" asp-route-id="@item.TecnicoId" class="btn btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.TecnicoId" class="btn btn-outline-secondary" title="Detalhes">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.TecnicoId" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>