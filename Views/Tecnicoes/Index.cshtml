@model IEnumerable<UnivManagement.Models.Tecnico>

@{
    ViewData["Title"] = "Técnicos";
}

<style>
    .btn-outline-petrol {
        color: #174966;
        border-color: #174966;
        background-color: #ffffff;
    }

        .btn-outline-petrol:hover {
            color: #ffffff;
            background-color: #174966;
            border-color: #174966;
        }
</style>

<div class="container py-4">
    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
            @ViewBag.SuccessMessage
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <!-- Main Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1" style="color: #174966;">Técnicos</h1>
            <p class="text-muted small mb-0">Gerir os técnicos dos serviços de ação social e os respetivos departamentos.</p>
        </div>
        <div class="mt-2 mt-sm-0">
            <a asp-action="Create"
               class="btn text-white fw-medium px-3 py-2 w-100 w-sm-auto"
               style="background-color: #e5a93b; border-color: #e5a93b; border-radius: 6px;">
                + Adicionar técnico
            </a>
        </div>
    </div>

    <!-- Data Table inside Card with Gold Top Border -->
    <div class="card border-0 shadow-sm bg-white" style="border-top: 3px solid #e5a93b !important; border-radius: 8px;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="border-bottom">
                        <th class="py-3 ps-4 fw-bold text-dark">Nome</th>
                        <th class="py-3 px-4 fw-bold text-dark">Email</th>
                        <th class="py-3 px-4 fw-bold text-dark">Departamento</th>
                        <th class="py-3 pe-4 fw-bold text-dark text-end" style="width: 240px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                Nenhum técnico encontrado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-semibold text-dark">
                                    @Html.DisplayFor(model => item.Nome)
                                </td>
                                <td class="px-4 py-3 text-muted">
                                    @Html.DisplayFor(model => item.Email)
                                </td>
                                <td class="px-4 py-3 text-muted">
                                    @Html.DisplayFor(model => item.Departamento!.Nome)
                                </td>
                                <td class="pe-4 py-3 text-end text-nowrap">
                                    <div class="d-inline-flex gap-1" role="group" aria-label="Ações do Técnico">
                                        <a asp-action="Details"
                                           asp-route-id="@item.TecnicoId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Detalhes
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.TecnicoId"
                                           class="btn btn-sm btn-outline-petrol">
                                            Editar
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.TecnicoId"
                                           class="btn btn-sm btn-outline-danger">
                                            Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>