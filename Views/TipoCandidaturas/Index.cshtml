@model IEnumerable<UnivManagement.Models.TipoCandidatura>

@{
    ViewData["Title"] = "Application Types";
}

<div class="container mt-4 mb-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="display-6 fw-semibold mb-1" style="color: #2F506F;">
                Application Types
            </h1>
            <p class="text-muted mb-0">
                Manage the different types of scholarship applications.
            </p>
        </div>

        <a asp-action="Create"
           class="btn text-white px-3 shadow-sm"
           style="background-color: #E7A52B;">
            <i class="bi bi-plus-lg me-1"></i>
            Create New
        </a>
    </div>

    <!-- Success / Error Message -->
    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert @(ViewBag.SuccessType == "danger" ? "alert-danger" : "alert-success")
            alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-info-circle-fill me-2"></i>
            @ViewBag.SuccessMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Application Types Table -->
    <div class="card shadow-sm rounded-3"
         style="border: 1px solid #DEE2E6;
        border-top: 4px solid #E7A52B;">

        <div class="card-body p-3">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th style="width: 25%;">Application Type</th>
                            <th>Description</th>
                            <th class="text-end" style="width: 20%;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @Html.DisplayFor(modelItem => item.Designacao)
                                    </td>

                                    <td class="text-muted">
                                        @if (!string.IsNullOrWhiteSpace(item.Descricao))
                                        {
                                            @item.Descricao
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">
                                                No description available
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@item.TipoCandidaturaId"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Details">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.TipoCandidaturaId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.TipoCandidaturaId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete">
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No application types found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
