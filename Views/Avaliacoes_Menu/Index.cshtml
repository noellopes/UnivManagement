@{
    ViewData["Title"] = "Avaliações e Trabalhos — Escolher Perfil";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">
    <div class="mb-3">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left"></i> Início
        </a>
    </div>

    <div class="text-center mb-5">
        <h1 class="display-5 fw-normal">Avaliações e Trabalhos</h1>
        <p class="text-muted fs-5">Selecione o perfil pretendido para aceder às respetivas funcionalidades.</p>
    </div>

    <div class="row justify-content-center g-4">

        <!-- Cartão Área do Docente -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body d-flex flex-column text-center p-4">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-person-workspace" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="card-title fw-bold">Área do Docente</h4>
                    <p class="card-text text-muted flex-grow-1 mt-2">
                        Acesso à gestão académica: criar e gerir avaliações, trabalhos, grupos de trabalho, critérios, notas e feedback das submissões.
                    </p>
                    <a asp-controller="Avaliacoes_Menu"
                       asp-action="PainelDocente"
                       class="btn btn-primary btn-lg w-100 mt-3">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Entrar como Docente
                    </a>
                </div>
            </div>
        </div>

        <!-- Cartão Área do Aluno -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-body d-flex flex-column text-center p-4">
                    <div class="mb-3 text-success">
                        <i class="bi bi-mortarboard" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="card-title fw-bold">Área do Aluno</h4>
                    <p class="card-text text-muted flex-grow-1 mt-2">
                        Acesso à área de estudante: consultar avaliações e trabalhos, submeter entregas, verificar grupos, notas e feedback recebido.
                    </p>
                    <a asp-controller="Avaliacoes_Menu"
                       asp-action="PainelAluno"
                       class="btn btn-success btn-lg w-100 mt-3">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Entrar como Aluno
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>