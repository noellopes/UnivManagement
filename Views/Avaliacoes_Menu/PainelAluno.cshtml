@{
    ViewData["Title"] = "Painel do Aluno — Avaliações e Trabalhos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-controller="Avaliacoes_Menu" asp-action="Index" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left"></i> Escolher Perfil
        </a>
        <span class="badge bg-success fs-6">
            <i class="bi bi-mortarboard me-1"></i> Perfil: Aluno
        </span>
    </div>

    <div class="text-center mb-5">
        <h1 class="display-5 fw-normal">Painel do Aluno</h1>
        <p class="text-muted fs-5">Consulta de avaliações, enunciados, grupos, notas, feedback e submissão de trabalhos.</p>
    </div>

    <div class="row g-4">

        <!-- 1. Diogo: Avaliações e Submissões (Aluno) -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">
                        <i class="bi bi-clipboard-check me-2 text-success"></i>Avaliações e Submissões
                    </h5>
                    <p class="card-text text-muted flex-grow-1">
                        Consultar datas e detalhes das avaliações e criar, consultar ou editar as suas submissões de trabalhos.
                    </p>
                    <div class="col-12">
                        <a asp-controller="AvaliacaoUC" asp-action="IndexAluno" class="btn btn-outline-success w-100 mt-3">
                            Consultar Avaliações
                        </a>
                        <a asp-controller="SubmissaoTrabalho" asp-action="IndexAluno" class="btn btn-outline-success w-100 mt-3">
                            As Minhas Submissões
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Vasco: Notas e Exames -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">
                        <i class="bi bi-award me-2 text-success"></i>Notas e Exames
                    </h5>
                    <p class="card-text text-muted flex-grow-1">
                        Consultar informações de exames realizados e as respetivas notas obtidas.
                    </p>
                    <a asp-controller="Notas" asp-action="Index" class="btn btn-outline-success w-100 mt-3">
                        Consultar Notas e Exames
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. Joel: Trabalhos e Grupos -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">
                        <i class="bi bi-people me-2 text-success"></i>Trabalhos e Grupos
                    </h5>
                    <p class="card-text text-muted flex-grow-1">
                        Consultar enunciados de trabalhos práticos e verificar os grupos de trabalho e respetivos membros.
                    </p>
                    <a asp-controller="Trabalhos" asp-action="Index" class="btn btn-outline-success w-100 mt-3">
                        Consultar Trabalhos e Grupos
                    </a>
                </div>
            </div>
        </div>

        <!-- 4. João: Feedback e Critérios -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">
                        <i class="bi bi-chat-square-text me-2 text-success"></i>Feedback e Critérios
                    </h5>
                    <p class="card-text text-muted flex-grow-1">
                        Consultar os critérios de avaliação das UCs e o feedback atribuído pelos docentes às submissões.
                    </p>
                    <a asp-controller="CriterioAvaliacao" asp-action="Index" class="btn btn-outline-success w-100 mt-3">
                        Critérios de Avaliação
                    </a>
                    <a asp-controller="Feedback" asp-action="Index" class="btn btn-outline-success w-100 mt-3">
                        Feedback Recebido
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>