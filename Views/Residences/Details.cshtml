@model UnivManagement.Models.AccommodationManagement.Residence

@{
    ViewData["Title"] = "Residence Details";
    var badge = Model.IsActive ? "text-bg-success" : "text-bg-secondary";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h1 class="h4 fw-bold mb-1">
                        <i class="bi bi-building text-primary me-2"></i>Residence Details
                    </h1>
                    <p class="text-body-secondary mb-0">Information about this university residence.</p>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-body-secondary">@Html.DisplayNameFor(model => model.Name)</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.Name)</dd>

                        <dt class="col-sm-5 text-body-secondary">@Html.DisplayNameFor(model => model.Address)</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.Address)</dd>

                        <dt class="col-sm-5 text-body-secondary">@Html.DisplayNameFor(model => model.Capacity)</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.Capacity)</dd>

                        <dt class="col-sm-5 text-body-secondary">@Html.DisplayNameFor(model => model.IsActive)</dt>
                        <dd class="col-sm-7 mb-0">
                            <span class="badge @badge">@(Model.IsActive ? "Yes" : "No")</span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-transparent border-0 pb-4 px-4 d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.ResidenceId" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>