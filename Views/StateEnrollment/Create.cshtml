@model UnivManagement.Models.AcademicManagement.StateEnrollment

@{
    ViewData["Title"] = "Criar Estado de Inscrição";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Criar Estado de Inscrição</h1>
    <p class="text-body-secondary mb-0">
        Adicionar novo estado para classificar as inscrições de alunos em cursos.
    </p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body-tertiary py-3">
        <h2 class="h5 mb-0">
            <i class="bi bi-clipboard-check me-2" aria-hidden="true"></i>
            Informação do novo Estado de Inscrição
        </h2>
    </div>

    <div class="card-body p-4">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="PENDING"
                           maxlength="30"
                           autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                    <small class="text-body-secondary d-block mt-1">
                        Apenas letras maiúsculas, espaços e underscores.
                    </small>
                </div>

                <div class="col-md-8">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <input asp-for="Description"
                           class="form-control"
                           placeholder="Descrição do estado (opcional)"
                           maxlength="60" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                    Criar Estado
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                    Voltar à Lista
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


