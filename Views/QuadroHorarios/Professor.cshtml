@model UnivManagement.Models.QuadroProfessorViewModel
@{
    ViewData["Title"] = Model.Nome;
    string[] dias = { "Segunda", "Terça", "Quarta", "Quinta", "Sexta" };
    int horaIni = 8;
    int horaFim = 20;
}

<style>
    .qh-grid {
        display: flex;
        border: 1px solid #ccc;
    }

    .qh-horas {
        width: 60px;
        flex: none;
    }

    .qh-dia {
        flex: 1;
        border-left: 1px solid #ccc;
        min-width: 120px;
    }

    .qh-titulo {
        height: 32px;
        line-height: 32px;
        text-align: center;
        font-weight: bold;
        background: #f1f1f1;
        border-bottom: 1px solid #ccc;
    }

    .qh-hora {
        height: 60px;
        font-size: 12px;
        color: #666;
        padding: 2px 6px;
        box-sizing: border-box;
    }

    .qh-corpo {
        position: relative;
        background: repeating-linear-gradient(to bottom, #fff 0, #fff 59px, #e5e5e5 59px, #e5e5e5 60px);
    }

    .qh-bloco {
        position: absolute;
        box-sizing: border-box;
        padding: 3px 5px;
        font-size: 12px;
        overflow: hidden;
        border-radius: 4px;
        border: 1px solid rgba(0,0,0,.25);
    }

        .qh-bloco strong {
            display: block;
        }

    .tipo-t {
        background: #cfe2ff;
    }

    .tipo-tp {
        background: #d1e7dd;
    }

    .tipo-pl {
        background: #fff3cd;
    }

    .tipo-at {
        background: #f8d7da;
    }
</style>

<h1>@Model.Nome</h1>
<p><a asp-action="Professores">← Todos os professores</a></p>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<div class="mb-3">
    <span class="me-2"><strong>Semestre:</strong></span>
    @for (int s = 1; s <= 2; s++)
    {
        <a class="btn btn-sm @(s == Model.Semestre ? "btn-primary" : "btn-outline-primary")"
           asp-action="Professor" asp-route-docenteid="@Model.DocenteId" asp-route-semestre="@s">@(s)º</a>
    }
</div>

<p>
    Horas de aula por semana: <strong>@Model.MinutosAula min</strong> ·
    Atendimento (um terço, arredondado a 30 min): <strong>@Model.MinutosAtendimento min</strong>
</p>

@if (!Model.Blocos.Any())
{
    <div class="alert alert-info">Sem aulas neste semestre.</div>
}

<div class="qh-grid">
    <div class="qh-horas">
        <div class="qh-titulo"></div>
        @for (int h = horaIni; h < horaFim; h++)
        {
            <div class="qh-hora">@h.ToString("00"):00</div>
        }
    </div>

    @for (int d = 1; d <= 5; d++)
    {
        <div class="qh-dia">
            <div class="qh-titulo">@dias[d - 1]</div>
            <div class="qh-corpo" style="height:@((horaFim - horaIni) * 60)px">
                @foreach (var b in Model.Blocos.Where(x => x.Dia == d))
                {
                    <div class="qh-bloco tipo-@b.Tipo.ToLower()"
                         style="top:@(b.Topo)px;height:@(b.Altura)px;left:@(b.Esq)%;width:@(b.Larg)%">
                        <strong>@b.Uc</strong>
                        @b.Tipo @(b.Turma == "—" ? "" : "· " + b.Turma)<br />
                        @b.Inicio.ToString(@"hh\:mm")–@b.Fim.ToString(@"hh\:mm")<br />
                        @b.Sala
                    </div>
                }
            </div>
        </div>
    }
</div>

<p class="mt-3 text-muted">
    <span class="badge" style="background:#cfe2ff;color:#000">T</span>
    <span class="badge" style="background:#d1e7dd;color:#000">TP</span>
    <span class="badge" style="background:#fff3cd;color:#000">PL</span>
    <span class="badge" style="background:#f8d7da;color:#000">AT – Atendimento</span>
</p>