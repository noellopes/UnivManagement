@model List<UnivManagement.Models.CursoQuadro>
@{
    ViewData["Title"] = "Horários";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="mb-0">Horários</h1>
    <a class="btn btn-outline-secondary" asp-action="Professores">Ver por professor</a>
</div>
<p class="text-muted">Escolha um curso para ver o horário semanal.</p>

<div class="row">
    @foreach (var c in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@c.Nome</h5>
                    <p class="card-text text-muted">@c.Grau · @c.Sigla</p>
                    <a class="btn btn-primary" asp-action="Curso" asp-route-cursoid="@c.CursoId">Ver horário</a>
                </div>
            </div>
        </div>
    }
</div>