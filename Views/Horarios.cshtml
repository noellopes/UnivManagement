@{
    ViewData["Title"] = "Gestão de Horários";
}

<div class="container-fluid py-4" style="background-color: #f4f6f8; min-height: 100vh;">
    
    
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-0">Horários e Alocações</h3>
            <small class="text-muted">Gestão dos mapas de aulas de todos os cursos.</small>
        </div>
        <button class="btn btn-dark rounded-pill px-4 shadow-sm">+ Novo Horário</button>
    </div>

    
    <div class="bg-white p-3 rounded-4 shadow-sm mb-4 d-flex gap-3 flex-wrap align-items-center">
        <input type="text" class="form-control border-0 bg-light flex-grow-1 w-auto" placeholder="Procurar curso ou turma...">
        <select class="form-select border-0 bg-light w-auto"><option>2026/2027</option></select>
        <select class="form-select border-0 bg-light w-auto"><option>Todos os Estados</option></select>
    </div>

    
    <div class="row g-4">
        
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 rounded-4 shadow-sm h-100 card-hover">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3">
                            <i class="bi bi-laptop fs-4"></i>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Publicado</span>
                    </div>
                    
                    <h5 class="fw-bold mb-1">Engenharia Informática</h5>
                    <p class="text-muted small mb-4">1º Ano • 1º Semestre</p>
                    
                    <div class="text-secondary small mb-4">
                        <div class="mb-2"><i class="bi bi-journal-text me-2"></i> 6 Disciplinas</div>
                        <div class="mb-2"><i class="bi bi-door-open me-2"></i> 3 Salas</div>
                        <div><i class="bi bi-clock me-2"></i> Atualizado hoje</div>
                    </div>
                </div>
                
                <div class="card-footer bg-transparent border-0 p-4 pt-0 d-flex gap-2">
                    <button class="btn btn-light rounded-pill w-100 fw-bold">Gerir Horário</button>
                    <button class="btn btn-light rounded-circle px-3"><i class="bi bi-three-dots-vertical"></i></button>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .card-hover {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }
</style>