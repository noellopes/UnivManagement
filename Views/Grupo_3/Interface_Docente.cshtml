@{

}

<div class="container py-4">
	<header class="text-left mb-5">
		<h1 class="display-5">Painel do Utilizador</h1>
		<p class="lead text-body-secondary">
			@if (User.Identity?.IsAuthenticated == true)
			{
				<span>Olá, @User.Identity.Name!</span>
			}
		</p>
	</header>
</div>

<div>
<section id="block-region-content" class="block-region" data-blockregion="content" data-droptarget="1"
		 aria-labelledby="content-block-region-heading">

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
	<div class="col">
		<div class="card h-100 shadow-sm">
			<div class="card-body d-flex flex-column">
				<h2 class="card-title h5">Programação Web</h2>
				<p class="card-text text-body-secondary flex-grow-1">
					Curso de Programação Web, lecionado no 2º semestre do 2º ano do curso de Engenharia Informática.
				</p>
				<button type="button" class="btn btn-outline-primary w-100" disabled>
					Open module
				</button>
			</div>
		</div>
	</div>
	<div class="col">
		<div class="card h-100 shadow-sm">
			<div class="card-body d-flex flex-column">
				<h2 class="card-title h5">Engenharia de Software II</h2>
				<p class="card-text text-body-secondary flex-grow-1">
					Curso de Engenharia de Software II, lecionado no 2º semestre do 2º ano do curso de Engenharia Informática.
				</p>
				<button type="button" class="btn btn-outline-primary w-100" disabled>
					Open module
				</button>
			</div>
		</div>
	</div>
	<div class="col">
		<div class="card h-100 shadow-sm">
			<div class="card-body d-flex flex-column">
				<h2 class="card-title h5">Programação de Sistemas</h2>
				<p class="card-text text-body-secondary flex-grow-1">
					Curso de Programação de Sistemas, lecionado no 1º semestre do 2º ano do curso de Engenharia Informática.
				</p>
			</div>
		</div>
	</div>
</div>

	</section>
</div>
