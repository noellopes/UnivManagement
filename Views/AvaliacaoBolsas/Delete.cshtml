@model UnivManagement.Models.AvaliacaoBolsa

@{
    ViewData["Title"] = "Eliminar avaliação";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1" style="color: #174966;">Eliminar avaliação</h1>
            <p class="text-muted mb-0">Tem a certeza de que pretende eliminar este parecer técnico?</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
    </div>

    <div class="card shadow-sm border-0 mx-auto" style="max-width: 680px; border-top: 4px solid #dc3545 !important; border-radius: 12px;">
        <div class="card-body p-4">
            <div class="alert alert-warning mb-4">
                Esta ação não pode ser anulada.
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Candidatura</dt>
                <dd class="col-sm-8 fw-semibold">#@Model.CandidaturaBolsaId</dd>

                <dt class="col-sm-4 text-muted">Técnico</dt>
                <dd class="col-sm-8">@(Model.Tecnico?.Nome ?? $"Técnico #{Model.TecnicoId}")</dd>

                <dt class="col-sm-4 text-muted">Data da avaliação</dt>
                <dd class="col-sm-8">@Model.DataAvaliacao.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4 text-muted">Resultado</dt>
                <dd class="col-sm-8">@Model.Resultado</dd>

                <dt class="col-sm-4 text-muted">Parecer técnico</dt>
                <dd class="col-sm-8">@Model.Parecer</dd>
            </dl>

            <form asp-action="Delete" class="d-flex gap-2">
                <input type="hidden" asp-for="AvaliacaoBolsaId" />
                <button type="submit" class="btn btn-danger fw-semibold px-4">Confirmar Eliminação</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-3">Cancelar</a>
            </form>
        </div>
    </div>
</div>