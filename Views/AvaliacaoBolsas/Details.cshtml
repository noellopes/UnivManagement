@model UnivManagement.Models.AvaliacaoBolsa

@{
    ViewData["Title"] = "Detalhes da avaliação";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1" style="color: #174966;">Detalhes da avaliação</h1>
            <p class="text-muted mb-0">Consulta do parecer técnico registado.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
    </div>

    <div class="card shadow-sm border-0 mx-auto" style="max-width: 680px; border-top: 4px solid #e5a93b !important; border-radius: 12px;">
        <div class="card-body p-4">
            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Candidatura</dt>
                <dd class="col-sm-8 fw-semibold">#@Model.CandidaturaBolsaId</dd>

                <dt class="col-sm-4 text-muted">Técnico</dt>
                <dd class="col-sm-8">@(Model.Tecnico?.Nome ?? $"Técnico #{Model.TecnicoId}")</dd>

                <dt class="col-sm-4 text-muted">Data da avaliação</dt>
                <dd class="col-sm-8">@Model.DataAvaliacao.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4 text-muted">Resultado</dt>
                <dd class="col-sm-8">
                    @if (Model.Resultado == "Favorável")
                    {
                        <span class="badge bg-success">@Model.Resultado</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@Model.Resultado</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted">Parecer técnico</dt>
                <dd class="col-sm-8">@Model.Parecer</dd>

                <dt class="col-sm-4 text-muted">Observações</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Observacoes) ? "—" : Model.Observacoes)</dd>
            </dl>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.AvaliacaoBolsaId" class="btn text-white fw-semibold px-4" style="background-color: #174966;">
                    Editar
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary px-3">Voltar à lista</a>
            </div>
        </div>
    </div>
</div>