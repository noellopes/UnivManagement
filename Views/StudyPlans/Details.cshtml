@model UnivManagement.Models.AcademicManagement.StudyPlan

@{
    ViewData["Title"] = "Detalhes do Plano de Estudos";

    var years = (ViewData["Years"] as IEnumerable<UnivManagement.Models.AcademicManagement.StudyPlanYear>
        ?? Enumerable.Empty<UnivManagement.Models.AcademicManagement.StudyPlanYear>())
        .OrderBy(y => y.NumYear)
        .ToList();

    var ucs = (ViewData["Ucs"] as IEnumerable<UnivManagement.Models.AcademicManagement.UC>
        ?? Enumerable.Empty<UnivManagement.Models.AcademicManagement.UC>())
        .ToList();

    var outsideUcs = ucs
        .Where(u => u.Year < 1 || u.Year > years.Count)
        .OrderBy(u => u.Year)
        .ThenBy(u => u.Semester)
        .ThenBy(u => u.Code)
        .ToList();
}

@if (ViewBag.SuccessMessage != null) {
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<div class="mb-4">
    <h1 class="h2 mb-1">Detalhes do Plano de Estudos</h1>
    <p class="text-muted mb-0">Consulte a estrutura e os conteúdos do plano selecionado.</p>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-body py-3">
        <h2 class="h5 mb-0">
            <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
            Dados Gerais
        </h2>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Code)</dt>
            <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.Code)</dd>

            <dt class="col-sm-3 text-muted">Curso</dt>
            <dd class="col-sm-9">
                @if (Model.Course != null) {
                    <span class="badge text-bg-secondary">
                        @Model.Course.Code — @Model.Course.Name
                    </span>
                }
                else {
                    <span class="text-muted">Sem curso associado</span>
                }
            </dd>

            <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.NumYears)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NumYears)</dd>

            <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.EctsTotal)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.EctsTotal)</dd>

            <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.CreationDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CreationDate)</dd>

            <dt class="col-sm-3 text-muted">Vigor</dt>
            <dd class="col-sm-9">@Model.StartVigor – @Model.EndVigor</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-body py-3">
        <h2 class="h5 mb-0">
            <i class="bi bi-diagram-3 me-2" aria-hidden="true"></i>
            Conteúdos do Plano
        </h2>
    </div>

    <div class="card-body">
        @if (years.Count == 0) {
            <div class="alert alert-warning mb-0" role="alert">
                <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                Este plano de estudos ainda não tem anos definidos.
            </div>
        }
        else {
            @foreach (var year in years) {
                var yearUcs = ucs
                    .Where(u => u.Year == year.NumYear)
                    .OrderBy(u => u.Semester)
                    .ThenBy(u => u.Code)
                    .ToList();

                var ucSum = yearUcs.Sum(u => u.ValueECTS);
                var semesterGroups = yearUcs
                    .GroupBy(u => u.Semester)
                    .OrderBy(g => g.Key)
                    .ToList();

                <div class="border rounded-3 p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <h3 class="h5 mb-0">@(year.NumYear).º Ano</h3>

                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge text-bg-light">
                                Soma das UCs: @ucSum ECTS
                            </span>
                            <span class="badge text-bg-secondary">
                                Total do ano: @year.ECTSTotalYear ECTS
                            </span>
                            <span class="badge text-bg-info">
                                Mínimo: @year.MinECTS ECTS
                            </span>
                        </div>
                    </div>

                    @if (semesterGroups.Count == 0) {
                        <p class="text-muted small mt-3 mb-0">
                            Sem unidades curriculares neste ano.
                        </p>
                    }
                    else {
                        @foreach (var group in semesterGroups) {
                            <div class="border rounded-3 p-3 mt-3">
                                <h4 class="h6 text-muted mb-2">@(group.Key).º Semestre</h4>

                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col" style="width: 7rem;">Código</th>
                                                <th scope="col">Nome</th>
                                                <th scope="col" style="width: 7rem;">Sigla</th>
                                                <th scope="col" class="text-end" style="width: 7rem;">ECTS</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var uc in group) {
                                                <tr>
                                                    <td class="fw-semibold">@uc.Code</td>
                                                    <td>@uc.Name</td>
                                                    <td>
                                                        @(string.IsNullOrWhiteSpace(uc.Acronym) ? "—" : uc.Acronym)
                                                    </td>
                                                    <td class="text-end">@uc.ValueECTS</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }

                    @if (ucSum != year.ECTSTotalYear) {
                        <div class="alert alert-warning py-2 px-3 small mt-3 mb-0" role="alert">
                            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                            A soma dos ECTS das UCs (@ucSum) não coincide com o total do ano
                            (@year.ECTSTotalYear). Esta diferença é apenas informativa.
                        </div>
                    }
                </div>
            }
        }

        @if (outsideUcs.Count > 0) {
            <div class="alert alert-danger mb-0" role="alert">
                <h3 class="h6 alert-heading">
                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                    Unidades curriculares fora da estrutura de anos
                </h3>

                <p class="mb-2">
                    Estas unidades curriculares estão atribuídas ao plano, mas o seu ano não
                    corresponde a nenhum dos anos definidos. Edite o plano para corrigir a situação.
                </p>

                <ul class="mb-0">
                    @foreach (var uc in outsideUcs) {
                        <li>
                            <strong>@uc.Code</strong> — @uc.Name
                            (ano @uc.Year, semestre @uc.Semester, @uc.ValueECTS ECTS)
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <div class="card-footer bg-body">
        <div class="d-flex justify-content-end flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                Voltar à Lista
            </a>

            <a asp-action="Edit" asp-route-id="@Model.StudyPlanId" class="btn btn-primary">
                <i class="bi bi-pencil me-2" aria-hidden="true"></i>
                Editar
            </a>

            <a asp-action="Delete" asp-route-id="@Model.StudyPlanId" class="btn btn-danger">
                <i class="bi bi-trash me-2" aria-hidden="true"></i>
                Eliminar
            </a>
        </div>
    </div>
</div>
