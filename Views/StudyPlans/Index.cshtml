@model IEnumerable<UnivManagement.Models.AcademicManagement.StudyPlan>

@{
    ViewData["Title"] = "Planos de Estudos";
}

@if (ViewBag.SuccessMessage != null) {
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

@if (ViewBag.ErrorMessage != null) {
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
        @ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-body py-3">
        <h2 class="h5 mb-0">
            <i class="bi bi-funnel me-2" aria-hidden="true"></i>
            Pesquisar
        </h2>
    </div>

    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-12 col-lg-9">
                <label for="search" class="form-label fw-semibold">Pesquisar</label>

                <input type="search"
                       id="search"
                       name="search"
                       value="@(ViewData["Search"])"
                       class="form-control"
                       placeholder="Código, curso ou sigla..." />
            </div>

            <div class="col-12 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>
                    Filtrar
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary"
                   title="Limpar filtros"
                   aria-label="Limpar filtros">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Planos de Estudos</h1>
        <p class="text-muted mb-0">Gestão dos planos de estudos dos cursos</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
        Novo Plano de Estudos
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-body py-3">
        <h2 class="h5 mb-0">
            <i class="bi bi-diagram-3 me-2" aria-hidden="true"></i>
            Lista de Planos de Estudos
        </h2>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.Code)</th>
                        <th scope="col">Curso</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.NumYears)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.EctsTotal)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CreationDate)</th>
                        <th scope="col">Vigor</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any()) {
                        @foreach (var item in Model) {
                            <tr>
                                <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Code)</td>
                                <td>
                                    @if (item.Course != null) {
                                        <span class="badge text-bg-secondary">
                                            @item.Course.Code — @item.Course.Name
                                        </span>
                                    }
                                    else {
                                        <span class="text-muted">Sem curso associado</span>
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.NumYears)</td>
                                <td>@Html.DisplayFor(modelItem => item.EctsTotal)</td>
                                <td>@Html.DisplayFor(modelItem => item.CreationDate)</td>
                                <td>
                                    <span class="text-muted small">
                                        @item.StartVigor – @item.EndVigor
                                    </span>
                                </td>

                                <td class="text-end text-nowrap">
                                    <div class="btn-group" role="group"
                                         aria-label="Ações para o plano @item.Code">
                                        <a asp-action="Edit" asp-route-id="@item.StudyPlanId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Editar" aria-label="Editar plano @item.Code">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>

                                        <a asp-action="Details" asp-route-id="@item.StudyPlanId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Detalhes" aria-label="Detalhes do plano @item.Code">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@item.StudyPlanId"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Eliminar" aria-label="Eliminar plano @item.Code">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-inbox fs-2 text-muted d-block mb-2" aria-hidden="true"></i>

                                @if (ViewData["HasFilters"] is true) {
                                    <p class="text-muted mb-0">
                                        Nenhum plano de estudos corresponde aos critérios de pesquisa.
                                    </p>
                                }
                                else {
                                    <p class="text-muted mb-0">
                                        Não existem planos de estudos registados.
                                    </p>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Any()) {
        <div class="card-footer bg-body text-muted">
            <small>
                <i class="bi bi-list-ul me-1" aria-hidden="true"></i>
                Resultados: @Model.Count()
            </small>
        </div>
    }
</div>
