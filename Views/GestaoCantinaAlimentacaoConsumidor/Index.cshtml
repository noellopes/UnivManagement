@{
    ViewData["Title"] = "Página em Desenvolvimento";
}

    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <!-- Alert de Informação -->
            <div class="alert alert-info border-0 shadow-sm rounded-4 p-4 mb-4" role="alert">
                <div class="d-flex align-items-center justify-content-center mb-3">
                    <div class="bg-info bg-opacity-25 text-info rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-cone-striped fs-2"></i>
                    </div>
                </div>
                <h4 class="alert-heading fw-bold text-dark">Página em Desenvolvimento</h4>
                <p class="mb-0 text-secondary">
                    Esta funcionalidade está atualmente a ser desenvolvida e estará disponível brevemente.
                </p>
            </div>

            <!-- Botão de Voltar -->
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
        </div>
    </div>
