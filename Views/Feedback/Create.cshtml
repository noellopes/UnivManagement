@model UnivManagement.Models.Feedback

@{
    ViewData["Title"] = "Criar Feedback";
}

<h1>Criar Feedback</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="SubmissaoID" class="control-label"></label>
                <input asp-for="SubmissaoID" class="form-control" />
                <span asp-validation-for="SubmissaoID" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DocenteID" class="control-label"></label>
                <input asp-for="DocenteID" class="form-control" />
                <span asp-validation-for="DocenteID" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Data_Feedback" class="control-label"></label>
                <input asp-for="Data_Feedback" class="form-control" />
                <span asp-validation-for="Data_Feedback" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Descricao" class="control-label"></label>
                <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Nota" class="control-label"></label>
                <input asp-for="Nota" type="number" step="0.1" class="form-control" />
                <span asp-validation-for="Nota" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
