@model UnivManagement.Models.Feedback

@{
    ViewData["Title"] = "Detalhes do Feedback";
}

<h1>Detalhes do Feedback</h1>

<div>
    <h4>Feedback</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SubmissaoTrabalhoId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SubmissaoTrabalhoId)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DocenteId)
        </dt>
        <dd class="col-sm-10">
            @Model.Docente?.Nome
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataFeedback)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataFeedback)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nota)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nota)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.FeedbackId" class="btn btn-warning">Editar</a> |
    <a asp-action="IndexDocente" class="btn btn-secondary">Voltar à Lista</a>
</div>