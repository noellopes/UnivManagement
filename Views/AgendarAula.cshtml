@{
    ViewData["Title"] = "Agendar Aula";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h2 class="h4 mb-0">Agendar Aula</h2>
                </div>
                <div class="card-body">

                    <form asp-controller="AgendarAula" asp-action="Index" method="post">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="sala" class="form-label font-weight-bold">Sala:</label>
                            <input type="text" id="sala" name="sala" class="form-control" placeholder="Ex: Sala 102" required />
                        </div>

                        <div class="mb-3">
                            <label for="turma" class="form-label font-weight-bold">Turma / Unidade Curricular:</label>
                            <input type="text" id="turma" name="turma" class="form-control" placeholder="Ex: Engenharia Informática - Programação Internet" required />
                        </div>

                        <div class="mb-3">
                            <label for="dataInicio" class="form-label font-weight-bold">Data e Hora de Início:</label>
                            <input type="datetime-local" id="dataInicio" name="dataInicio" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="dataFim" class="form-label font-weight-bold">Data e Hora de Fim:</label>
                            <input type="datetime-local" id="dataFim" name="dataFim" class="form-control" required />
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                Voltar à Página Principal
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                Confirmar Agendamento
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>