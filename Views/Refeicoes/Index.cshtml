@model IEnumerable<UnivManagement.Models.Refeicao>

@{
    ViewData["Title"] = "Gestão de Refeições";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    <p class="text-muted">Módulo de Gestão de Refeições da Cantina</p>

    <p>
        <a asp-action="Criar" class="btn btn-primary">Adicionar Nova Refeição</a>
    </p>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th scope="col">Nome</th>
                <th scope="col">Tipo</th>
                <th scope="col">Preço</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Tipo</td>
                    <td>@item.Preco.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>