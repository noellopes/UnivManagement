@model UnivManagement.Models.Refeicao
@{
    ViewData["Title"] = "Adicionar Refeição";
}

<div class="container mt-4">
    <h2>@ViewBag.Title</h2>
    <hr />

    <form asp-action="Criar" method="post">
        <!-- Sumário de erros de validação -->
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome da Refeição</label>
            <input asp-for="Nome" class="form-control" placeholder="Ex: Frango Grelhado" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Tipo" class="form-label">Tipo (ex: Almoço, Jantar)</label>
            <input asp-for="Tipo" class="form-control" placeholder="Ex: Almoço" />
            <span asp-validation-for="Tipo" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Preco" class="form-label">Preço (€)</label>
            <input asp-for="Preco" class="form-control" placeholder="Ex: 4.50" />
            <span asp-validation-for="Preco" class="text-danger small"></span>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Guardar Refeição</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>