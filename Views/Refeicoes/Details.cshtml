@model UnivManagement.Models.Refeicao

@{
    ViewData["Title"] = "Detalhes da refeição";
}

<h1>Detalhes da refeição</h1>

<hr />
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nome)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TipoRefeicaoId)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.TipoRefeicao!.Nome)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Preco)</dt>
    <dd class="col-sm-9">@Model.Preco.ToString("0.00") €</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.RefeicaoId" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar à lista</a>
</div>