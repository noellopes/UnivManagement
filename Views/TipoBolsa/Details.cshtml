@model UnivManagement.Models.TipoBolsa

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>TipoBolsa</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Nome</dd>

        <dt class="col-sm-2">Descrição</dt>
        <dd class="col-sm-10">@Model.Descricao</dd>

        <dt class="col-sm-2">Rendimento máximo</dt>
        <dd class="col-sm-10">
            @(Model.RendimentoMaximo != null ? Model.RendimentoMaximo + " €" : "Não aplicável")
        </dd>

        <dt class="col-sm-2">ECTS mínimos</dt>
        <dd class="col-sm-10">
            @(Model.EctsMinimos != null ? Model.EctsMinimos.ToString() : "Não aplicável")
        </dd>

        <dt class="col-sm-2">Média mínima</dt>
        <dd class="col-sm-10">
            @(Model.MediaMinima != null ? Model.MediaMinima + " valores" : "Não aplicável")
        </dd>

        <dt class="col-sm-2">Critérios de elegibilidade</dt>
        <dd class="col-sm-10" style="white-space: pre-line">@(Model.CriteriosElegibilidade ?? "Sem critérios adicionais")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.TipoBolsaId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>