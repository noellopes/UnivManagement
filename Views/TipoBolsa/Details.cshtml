@model UnivManagement.Models.TipoBolsa

@{
    ViewData["Title"] = "Detalhes do tipo de bolsa";
}

<div class="text-center mb-3">
    <h1 style="color: #1d4e6b;">Detalhes do tipo de bolsa</h1>
    <p class="text-muted mb-0">Informação e critérios de elegibilidade deste tipo de bolsa.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm" style="border-top: 4px solid #e8a33d;">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nome</dt>
                    <dd class="col-sm-8">@Model.Nome</dd>

                    <dt class="col-sm-4">Descrição</dt>
                    <dd class="col-sm-8">@Model.Descricao</dd>

                    <dt class="col-sm-4">Rendimento máximo</dt>
                    <dd class="col-sm-8">
                        @(Model.RendimentoMaximo != null ? Model.RendimentoMaximo + " €" : "Não aplicável")
                    </dd>

                    <dt class="col-sm-4">ECTS mínimos</dt>
                    <dd class="col-sm-8">
                        @(Model.EctsMinimos != null ? Model.EctsMinimos.ToString() : "Não aplicável")
                    </dd>

                    <dt class="col-sm-4">Média mínima</dt>
                    <dd class="col-sm-8">
                        @(Model.MediaMinima != null ? Model.MediaMinima + " valores" : "Não aplicável")
                    </dd>

                    <dt class="col-sm-4">Critérios de elegibilidade</dt>
                    <dd class="col-sm-8" style="white-space: pre-line">@(Model.CriteriosElegibilidade ?? "Sem critérios adicionais")</dd>
                </dl>

                <hr />

                <div class="text-center">
                    <a asp-action="Edit" asp-route-id="@Model.TipoBolsaId"
                       class="btn" style="color: #1d4e6b; border-color: #1d4e6b;">Editar</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
                </div>
            </div>
        </div>
    </div>
</div>