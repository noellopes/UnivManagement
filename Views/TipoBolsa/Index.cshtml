@model IEnumerable<UnivManagement.Models.TipoBolsa>

@{
    ViewData["Title"] = "Tipos de Bolsa";
}

<h1>Tipos de Bolsa</h1>

<p>
    <a asp-action="Create">Criar Novo Tipo de Bolsa</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Descrição</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Descricao</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.TipoBolsaId">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.TipoBolsaId">Detalhes</a> |
                    <a asp-action="Delete" asp-route-id="@item.TipoBolsaId">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>