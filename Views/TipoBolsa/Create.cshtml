@model UnivManagement.Models.TipoBolsa

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
<h4>TipoBolsa</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Descricao" class="control-label">Descrição</label>
                <input asp-for="Descricao" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RendimentoMaximo" class="form-label">Rendimento máximo (€)</label>
                <input asp-for="RendimentoMaximo" class="form-control" placeholder="Ex.: 12354" />
                <span asp-validation-for="RendimentoMaximo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EctsMinimos" class="form-label">ECTS mínimos</label>
                <input asp-for="EctsMinimos" class="form-control" placeholder="Ex.: 30" />
                <span asp-validation-for="EctsMinimos" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MediaMinima" class="form-label">Média mínima</label>
                <input asp-for="MediaMinima" class="form-control" placeholder="Ex.: 16" />
                <span asp-validation-for="MediaMinima" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CriteriosElegibilidade" class="form-label">Critérios de elegibilidade</label>
                <textarea asp-for="CriteriosElegibilidade" class="form-control" rows="3"
                          placeholder="Descreva outros requisitos da bolsa"></textarea>
                <span asp-validation-for="CriteriosElegibilidade" class="text-danger small"></span>
            </div>

            <div class="form-group mt-3 d-flex gap-2">
                <input type="submit" value="Create" class="btn text-white" style="background-color: #1d4e6b;" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
           
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>