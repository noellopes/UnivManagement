@model UnivManagement.Models.TipoBolsa

@{
    ViewData["Title"] = "Editar tipo de bolsa";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 style="color: #1d4e6b;">Editar tipo de bolsa</h1>
        <p class="text-muted mb-0">Altere os dados e os critérios de elegibilidade deste tipo de bolsa.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm" style="border-top: 4px solid #e8a33d;">
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="TipoBolsaId" />

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label">Nome</label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label">Descrição</label>
                        <textarea asp-for="Descricao" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="RendimentoMaximo" class="form-label">Rendimento máximo (€)</label>
                            <input asp-for="RendimentoMaximo" class="form-control" placeholder="Ex.: 12354" />
                            <span asp-validation-for="RendimentoMaximo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EctsMinimos" class="form-label">ECTS mínimos</label>
                            <input asp-for="EctsMinimos" class="form-control" placeholder="Ex.: 30" />
                            <span asp-validation-for="EctsMinimos" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MediaMinima" class="form-label">Média mínima</label>
                            <input asp-for="MediaMinima" class="form-control" placeholder="Ex.: 16" />
                            <span asp-validation-for="MediaMinima" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CriteriosElegibilidade" class="form-label">Critérios de elegibilidade</label>
                        <textarea asp-for="CriteriosElegibilidade" class="form-control" rows="4"
                                  placeholder="Escreva um critério por linha"></textarea>
                        <span asp-validation-for="CriteriosElegibilidade" class="text-danger small"></span>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn text-white" style="background-color: #1d4e6b; border-color: #1d4e6b;">
                            Guardar alterações
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}