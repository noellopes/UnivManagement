@model UnivManagement.Models.AccommodationManagement.ApplicationStatusHistory
@using UnivManagement.Models.AccommodationManagement

@{
    ViewData["Title"] = "Status History Record Details";
    var badgeClass = Model.Status switch
    {
        ApplicationStatus.Submitted => "bg-secondary",
        ApplicationStatus.UnderReview => "bg-warning text-dark",
        ApplicationStatus.Approved => "bg-success",
        ApplicationStatus.Rejected => "bg-danger",
        ApplicationStatus.Withdrawn => "bg-dark",
        _ => "bg-info"
    };
}

<h1>Status Change Details</h1>
<hr />

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AccommodationApplicationId)</dt>
            <dd class="col-sm-9">Application #@Model.AccommodationApplicationId</dd>

            @if (Model.AccommodationApplication != null)
            {
                <dt class="col-sm-3">Student ID</dt>
                <dd class="col-sm-9">@Model.AccommodationApplication.StudentId</dd>

                <dt class="col-sm-3">Current Application Status</dt>
                <dd class="col-sm-9">@Model.AccommodationApplication.Status</dd>
            }

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
            <dd class="col-sm-9">
                <span class="badge @badgeClass">@Model.Status</span>
            </dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ChangedAt)</dt>
            <dd class="col-sm-9">@Model.ChangedAt.ToString("dd/MM/yyyy HH:mm:ss")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ChangedBy)</dt>
            <dd class="col-sm-9">@Model.ChangedBy</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Notes)</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes provided." : Model.Notes)</dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Index" asp-route-applicationId="@Model.AccommodationApplicationId" class="btn btn-outline-primary">
        View History for this Application
    </a>
    <a asp-action="Index" class="btn btn-secondary">Back to Full List</a>
</div>