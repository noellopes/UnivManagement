@model IEnumerable<UnivManagement.Models.AccommodationManagement.ApplicationStatusHistory>

@{
    ViewData["Title"] = "Application Status History";
}

<div class="container py-4">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>Application Status History
            </h1>
            <p class="text-body-secondary mb-0">View the history of application status changes.</p>
        </div>
        <a asp-action="Create" asp-route-applicationId="@ViewBag.FilteredApplicationId" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Status Change
        </a>
    </header>

    @if (ViewBag.FilteredApplicationId != null)
    {
        <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2 shadow-sm">
            <span>
                <i class="bi bi-funnel me-1"></i> Showing status history for <strong>Application #@ViewBag.FilteredApplicationId</strong>.
            </span>
            <a asp-action="Index" class="btn btn-sm btn-outline-primary">Show All Records</a>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Application</th>
                        <th>Status</th>
                        <th>Changed At</th>
                        <th>Changed By</th>
                        <th>Notes</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusName = item.PossibleStatus?.Name ?? "Unknown";
                        var badgeClass = statusName switch
                        {
                            "Submitted" => "text-bg-secondary",
                            "UnderReview" or "Under Review" => "text-bg-warning",
                            "Approved" => "text-bg-success",
                            "Rejected" => "text-bg-danger",
                            "Withdrawn" => "text-bg-dark",
                            _ => "text-bg-info"
                        };

                        <tr>
                            <td>
                                <span class="fw-medium">Application #@item.AccommodationApplicationId</span>
                                @if (item.AccommodationApplication != null)
                                {
                                    <div class="small text-body-secondary">Student ID: @item.AccommodationApplication.StudentId</div>
                                }
                            </td>
                            <td>
                                <span class="badge @badgeClass">@statusName</span>
                            </td>
                            <td>@item.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.ChangedBy</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    @item.Notes
                                }
                                else
                                {
                                    <span class="text-body-secondary">&mdash;</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.ApplicationStatusHistoryId"
                                       class="btn btn-outline-secondary" title="Details" aria-label="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ApplicationStatusHistoryId"
                                       class="btn btn-outline-danger" title="Delete" aria-label="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-body-secondary py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No status history records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Accommodation" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Accommodation Management
        </a>
    </div>
</div>