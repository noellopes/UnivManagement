@model UnivManagement.Models.AccommodationManagement.ApplicationStatusHistory

@{
    ViewData["Title"] = "New Status Change";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h1 class="h4 fw-bold mb-1">
                        <i class="bi bi-plus-circle text-primary me-2"></i>New Status Change
                    </h1>
                    <p class="text-body-secondary mb-0">Record a new status change for an accommodation application.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="AccommodationApplicationId" class="form-label"></label>
                            <select asp-for="AccommodationApplicationId" class="form-select" asp-items="ViewBag.AccommodationApplicationId">
                                <option value="">-- Select an application --</option>
                            </select>
                            <span asp-validation-for="AccommodationApplicationId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PossibleStatusId" class="form-label"></label>
                            <select asp-for="PossibleStatusId" class="form-select" asp-items="ViewBag.PossibleStatusId">
                                <option value="">-- Select the new status --</option>
                            </select>
                            <span asp-validation-for="PossibleStatusId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangedBy" class="form-label"></label>
                            <input asp-for="ChangedBy" class="form-control" placeholder="Enter user or staff name" />
                            <span asp-validation-for="ChangedBy" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional notes about this status change"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <a asp-action="Index" asp-route-applicationId="@Model?.AccommodationApplicationId" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> Create
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}