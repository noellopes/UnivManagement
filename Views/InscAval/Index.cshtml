@model IEnumerable<UnivManagement.Models.InscAval>

@{
    ViewData["Title"] = "Inscrições em Avaliações";
}

<h1>Inscrições em Avaliações</h1>

@if (TempData["Mensagem"] != null)
{
    <script>alert('@Html.Raw(TempData["Mensagem"])');</script>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Nova inscrição</a>
    <a asp-controller="Notas" asp-action="Index" class="btn btn-outline-primary">Ver Notas</a>
</p>

@if (!Model.Any())
{
    <p>Ainda não há inscrições em avaliações.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Avaliação</th>
                <th>Inscrição na UC</th>
                <th>Pago</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@ViewBag.TextosAvaliacao[item.InscAvalId]</td>
                    <td>@ViewBag.TextosInscricao[item.InscAvalId]</td>
                    <td>
                        @if (item.Pago)
                        {
                            <span class="badge bg-success">Sim</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Não</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.InscAvalId" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.InscAvalId" class="btn btn-sm btn-info">Detalhes</a>
                        <a asp-action="Delete" asp-route-id="@item.InscAvalId" class="btn btn-sm btn-danger">Apagar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
