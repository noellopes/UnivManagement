@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model UnivManagement.Models.Room

@{
    ViewData["Title"] = "Registar Sala";
}

<div class="container my-4" style="max-width: 980px;">

    <!-- titulo e  cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-door-open-fill text-primary me-2"></i>Registar Nova Sala
            </h3>
            <p class="text-muted small mb-0">Introduza os dados da sala física para disponibilizar no sistema de alocação de horários.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Voltar à Lista
        </a>
    </div>

    <!-- formulário de criação -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-bold text-primary">
                <i class="bi bi-pencil-square me-2"></i>Formulário de Registo de Espaço
            </h6>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!--nr sala -->
                    <div class="col-md-4">
                        <label asp-for="NumeroSala" class="form-label fw-semibold small text-secondary">Identificador / Número <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-tag"></i></span>
                            <input asp-for="NumeroSala" class="form-control" placeholder="ex: 101, Lab Info 1" />
                        </div>
                        <span asp-validation-for="NumeroSala" class="text-danger small"></span>
                        <div class="form-text">Nome ou número visível na porta.</div>
                    </div>

                    <!--edificio -->
                    <div class="col-md-4">
                        <label asp-for="IdEdificio" class="form-label fw-semibold small text-secondary">Edifício <span class="text-danger">*</span></label>
                        <select asp-for="IdEdificio" class="form-select">
                            <option value="">Selecione o edifício...</option>
                            <option value="1">Edifício Central</option>
                            <option value="2">Edifício A - Tecnologias</option>
                            <option value="3">Edifício B - Ciências</option>
                            <option value="4">Complexo Desportivo</option>
                        </select>
                        <span asp-validation-for="IdEdificio" class="text-danger small"></span>
                    </div>

                    <!--piso -->
                    <div class="col-md-4">
                        <label asp-for="Piso" class="form-label fw-semibold small text-secondary">Piso / Andar <span class="text-danger">*</span></label>
                        <input asp-for="Piso" type="number" class="form-control" placeholder="ex: 0, 1, 2" min="-2" max="10" />
                        <span asp-validation-for="Piso" class="text-danger small"></span>
                    </div>

                    <!--capacidade -->
                    <div class="col-md-4">
                        <label asp-for="Lotacao" class="form-label fw-semibold small text-secondary">Capacidade (Lugares) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-people"></i></span>
                            <input asp-for="Lotacao" type="number" class="form-control" placeholder="ex: 35" min="1" max="500" />
                        </div>
                        <span asp-validation-for="Lotacao" class="text-danger small"></span>
                    </div>

                    <!-- tipo sala-->
                    <div class="col-md-4">
                        <label asp-for="IdTipoSala" class="form-label fw-semibold small text-secondary">Tipo de Sala <span class="text-danger">*</span></label>
                        <select asp-for="IdTipoSala" class="form-select">
                            <option value="">Selecione o tipo...</option>
                            <option value="1">Sala de Aula Teórica</option>
                            <option value="2">Laboratório de Informática</option>
                            <option value="3">Laboratório de Eletrónica</option>
                            <option value="4">Anfiteatro</option>
                            <option value="5">Gabinete / Sala de Reunião</option>
                        </select>
                        <span asp-validation-for="IdTipoSala" class="text-danger small"></span>
                    </div>

                    <!--estado -->
                    <div class="col-md-4">
                        <label asp-for="Estado" class="form-label fw-semibold small text-secondary">Estado Operacional</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Ativa">Ativa (Disponível para reservas)</option>
                            <option value="Manutenção">Em Manutenção</option>
                            <option value="Inativa">Inativa / Encerrada</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>

                    <!--botoes formularios -->
                    <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <button type="reset" class="btn btn-light px-4 border">Limpar</button>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-plus-circle me-1"></i>Registar Sala
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>