@model UnivManagement.Models.CriterioElegibilidade

@{
    ViewData["Title"] = "Delete eligibility criterion";
}

<div class="container mt-4 mb-5">

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold mb-2" style="color: #2F506F;">
                Delete Eligibility Criterion
            </h1>

            <p class="text-muted mb-0">
                Are you sure you want to delete this eligibility criterion?
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary mt-3 mt-sm-0">
            Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm"
                 style="border-top: 4px solid #F0A52B !important;">

                <div class="card-body p-4">

                    <h5 class="fw-semibold mb-4" style="color: #2F506F;">
                        Criterion Information
                    </h5>

                    <dl class="row mb-0">

                        <dt class="col-sm-4 text-secondary mb-2">
                            Description
                        </dt>
                        <dd class="col-sm-8 mb-3">
                            @Html.DisplayFor(model => model.Descricao)
                        </dd>

                        <dt class="col-sm-4 text-secondary mb-2">
                            Maximum Family Income
                        </dt>
                        <dd class="col-sm-8 mb-3">
                            @Html.DisplayFor(model => model.RendimentoMaximo) €
                        </dd>

                        <dt class="col-sm-4 text-secondary mb-2">
                            Minimum ECTS
                        </dt>
                        <dd class="col-sm-8 mb-3">
                            @Html.DisplayFor(model => model.EctsMinimos)
                        </dd>

                        <dt class="col-sm-4 text-secondary mb-2">
                            Scholarship Type
                        </dt>
                        <dd class="col-sm-8 mb-0">
                            @Model.TipoBolsa?.Nome
                        </dd>

                    </dl>
                </div>

                <div class="card-footer bg-white border-top p-3">
                    <form asp-action="Delete"
                          class="d-flex flex-wrap gap-2">
                        <input type="hidden" asp-for="CriterioElegibilidadeId" />

                        <button type="submit"
                                class="btn btn-danger px-4">
                            Delete Criterion
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>