@model UnivManagement.Models.CriterioElegibilidade

@{
    ViewData["Title"] = "Create eligibility criterion";
}

<div class="container mt-4 mb-5">

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold mb-2" style="color: #2F506F;">
                Create Eligibility Criterion
            </h1>

            <p class="text-muted mb-0">
                Add a new eligibility criterion for a scholarship.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary mt-3 mt-sm-0">
            Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <form asp-action="Create"
                  class="card border-0 shadow-sm"
                  style="border-top: 4px solid #F0A52B !important;">

                <div class="card-body p-4">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao"
                               class="form-label fw-semibold text-secondary">
                            Description
                        </label>

                        <textarea asp-for="Descricao"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter the eligibility description"></textarea>

                        <span asp-validation-for="Descricao"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RendimentoMaximo"
                               class="form-label fw-semibold text-secondary">
                            Maximum Family Income (€)
                        </label>

                        <input asp-for="RendimentoMaximo"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01"
                               placeholder="e.g. 30000" />

                        <span asp-validation-for="RendimentoMaximo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EctsMinimos"
                               class="form-label fw-semibold text-secondary">
                            Minimum ECTS
                        </label>

                        <input asp-for="EctsMinimos"
                               class="form-control"
                               type="number"
                               min="1"
                               max="60"
                               placeholder="e.g. 45" />

                        <span asp-validation-for="EctsMinimos"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="TipoBolsaId"
                               class="form-label fw-semibold text-secondary">
                            Scholarship Type
                        </label>

                        <select asp-for="TipoBolsaId"
                                class="form-select"
                                asp-items="ViewBag.TipoBolsaId">
                            <option value="">-- Select a scholarship type --</option>
                        </select>

                        <span asp-validation-for="TipoBolsaId"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn px-4 text-white"
                                style="background-color: #2F506F; border-color: #2F506F;">
                            Create Criterion
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>
                    </div>

                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}