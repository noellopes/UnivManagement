@model UnivManagement.Models.CriterioElegibilidade

@{
    ViewData["Title"] = "Edit eligibility criterion";
}

<div class="container mt-4 mb-5">

    <h1 class="fw-bold mb-2" style="color: #2F506F;">
        Edit Eligibility Criterion
    </h1>

    <h4 class="text-muted mb-3">CriterioElegibilidade</h4>

    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <form asp-action="Edit" class="card border-0 shadow-sm"
                  style="border-top: 4px solid #F0A52B !important;">

                <div class="card-body p-4">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="CriterioElegibilidadeId" />

                    <div class="form-group mb-3">
                        <label asp-for="Descricao"
                               class="control-label fw-semibold text-secondary">
                            Description
                        </label>

                        <textarea asp-for="Descricao"
                                  class="form-control"
                                  rows="3"></textarea>

                        <span asp-validation-for="Descricao"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="RendimentoMaximo"
                               class="control-label fw-semibold text-secondary">
                            Maximum Family Income (€)
                        </label>

                        <input asp-for="RendimentoMaximo"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01" />

                        <span asp-validation-for="RendimentoMaximo"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="EctsMinimos"
                               class="control-label fw-semibold text-secondary">
                            Minimum ECTS
                        </label>

                        <input asp-for="EctsMinimos"
                               class="form-control"
                               type="number"
                               min="1"
                               max="60" />

                        <span asp-validation-for="EctsMinimos"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="TipoBolsaId"
                               class="control-label fw-semibold text-secondary">
                            Scholarship Type
                        </label>

                        <select asp-for="TipoBolsaId"
                                class="form-select"
                                asp-items="ViewBag.TipoBolsaId">
                            <option value="">-- Select scholarship type --</option>
                        </select>

                        <span asp-validation-for="TipoBolsaId"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="submit"
                               value="Save Changes"
                               class="btn px-4 text-white"
                               style="background-color: #2F506F; border-color: #2F506F;" />
                    </div>

                </div>

                <div class="card-footer bg-white border-top p-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Back to List
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}