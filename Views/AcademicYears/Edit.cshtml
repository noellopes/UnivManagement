@model UnivManagement.Models.AcademicManagement.AcademicYear

@{
    ViewData["Title"] = "Editar Ano Letivo";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">

        <div class="mb-4">
            <h1 class="h2 mb-1">Editar Ano Letivo</h1>
            <p class="text-body-secondary mb-0">
                Alterar a informação do ano letivo selecionado.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body-tertiary py-3">
                <h2 class="h5 mb-0">
                    <i class="bi bi-calendar-event me-2" aria-hidden="true"></i>
                    Informação do Ano Letivo
                </h2>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"></div>

                    <input type="hidden" asp-for="AcademicYearId" />

                    <div class="mb-4">
                        <label asp-for="StartYear"
                               class="form-label fw-semibold"></label>

                        <input asp-for="StartYear"
                               class="form-control"
                               type="number"
                               min="2000"
                               max="9999"
                               placeholder="Ex: 2025" />

                        <span asp-validation-for="StartYear"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="EndYear"
                               class="form-label fw-semibold"></label>

                        <input asp-for="EndYear"
                               class="form-control"
                               type="number"
                               min="2000"
                               max="9999"
                               placeholder="Ex: 2026" />

                        <span asp-validation-for="EndYear"
                              class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                            Guardar Alterações
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                            Voltar à Lista
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
