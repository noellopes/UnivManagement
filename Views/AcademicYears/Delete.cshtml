@model UnivManagement.Models.AcademicManagement.AcademicYear

@{
    ViewData["Title"] = "Eliminar Ano Letivo";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">

        <div class="mb-4">
            <h1 class="h2 mb-1">Eliminar Ano Letivo</h1>
            <p class="text-body-secondary mb-0">
                Confirma se pretendes eliminar este ano letivo.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body-tertiary py-3">
                <h2 class="h5 mb-0">
                    <i class="bi bi-calendar-event me-2" aria-hidden="true"></i>
                    Informação do Ano Letivo
                </h2>
            </div>

            <div class="card-body p-4">

                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                    Tens a certeza de que pretendes eliminar este ano letivo?
                    Esta ação não pode ser anulada.
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.StartYear)
                    </dt>
                    <dd class="col-sm-7">
                        @Html.DisplayFor(model => model.StartYear)
                    </dd>

                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.EndYear)
                    </dt>
                    <dd class="col-sm-7">
                        @Html.DisplayFor(model => model.EndYear)
                    </dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="AcademicYearId" />

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1" aria-hidden="true"></i>
                            Eliminar Ano Letivo
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                            Voltar à Lista
                        </a>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>
