@model IEnumerable<UnivManagement.Models.AcademicManagement.AcademicYear>

@{
    ViewData["Title"] = "Anos Letivos";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <h1 class="h2 mb-1">Anos Letivos</h1>
                <p class="text-body-secondary mb-0">
                    Consultar e gerir os anos letivos da universidade.
                </p>
            </div>

            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                Criar Ano Letivo
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body-tertiary py-3">
                <h2 class="h5 mb-0">
                    <i class="bi bi-calendar-event me-2" aria-hidden="true"></i>
                    Lista de Anos Letivos
                </h2>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">
                                    @Html.DisplayNameFor(model => model.StartYear)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.EndYear)
                                </th>
                                <th class="text-end pe-4">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            @Html.DisplayFor(model => item.StartYear)
                                        </td>

                                        <td>
                                            @Html.DisplayFor(model => item.EndYear)
                                        </td>

                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-2">

                                                <a asp-action="Edit"
                                                   asp-route-id="@item.AcademicYearId"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Editar">
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                </a>

                                                <a asp-action="Details"
                                                   asp-route-id="@item.AcademicYearId"
                                                   class="btn btn-sm btn-outline-secondary"
                                                   title="Detalhes">
                                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                                </a>

                                                <a asp-action="Delete"
                                                   asp-route-id="@item.AcademicYearId"
                                                   class="btn btn-sm btn-outline-danger"
                                                   title="Eliminar">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                </a>

                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-body-secondary">
                                        Ainda não existem anos letivos registados.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
