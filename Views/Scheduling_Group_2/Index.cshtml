@{
    ViewData["Title"] = "Gestão de Horários e Salas";
}

<h1>Gestão de Horários e Salas</h1>

<p>Bem-vindo ao módulo de Gestão de Horários e Salas.</p>

<h2>Funcionalidades</h2>

<div class="row mt-4">

    <div class="col-md-6 mb-3">
        <div class="card h-100 p-3">
            <h3>Salas</h3>
            <p>Gestão das sala e edifícios.</p>
            <a asp-controller="AgendarAula"
               asp-action="Agendar_Aula"
               class="btn btn-outline-primary w-100 mt-auto">
                Open module
            </a>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card h-100 p-3">
            <h3>Horários</h3>
            <p>Consulta e gestão de horários.</p>
            <button type="button"
                    class="btn btn-outline-primary w-100 mt-auto"
                    onclick="alert('Gestão de Horários em desenvolvimento')">
                Gerir Horários
            </button>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card h-100 p-3">
            <h3>Reservas</h3>
            <p>Gestão de reservas de salas.</p>
            <button type="button"
                    class="btn btn-outline-primary w-100 mt-auto"
                    onclick="alert('Gestão de Reservas em desenvolvimento')">
                Gerir Reservas
            </button>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card h-100 p-3">
            <h3>Ocupação e Conflitos</h3>
            <p>Verificação de disponibilidade e conflitos.</p>
            <button type="button"
                    class="btn btn-outline-primary w-100 mt-auto"
                    onclick="alert('Ocupação e Conflitos em desenvolvimento')">
                Ver Ocupação e Conflitos
            </button>
        </div>
    </div>

</div>
