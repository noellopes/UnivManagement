@{
    ViewData["Title"] = "Gestão de Horários e Salas";
}

<h1>Gestão de Horários e Salas</h1>

<p>Bem-vindo ao módulo de Gestão de Horários e Salas.</p>

<h2>Funcionalidades</h2>

<div class="row mt-4">

    <div class="col-md-6 mb-3">
        <div class="card h-100 p-3">
            <h3>Salas</h3>
            <p>Gestão das salas e edifícios.</p>
            <button type="button"
                    class="btn btn-outline-primary w-100 mt-auto"
                    onclick="alert('Gestão de Salas em desenvolvimento')">
                Gerir Salas
            </button>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card h-100 p-3">
            <h3>Horários</h3>
            <p>Consulta e gestão de horários.</p>
            <button type="button"
                    class="btn btn-outline-primary w-100 mt-auto"
                    onclick="alert('Gestão de Horários em desenvolvimento')">
                Gerir Horários
            </button>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card h-100 p-3">
            <h3>Reservas</h3>
            <p>Gestão de reservas de salas.</p>
            <a asp-controller="Reservations"
               asp-action="Index"
               class="btn btn-outline-primary w-100 mt-auto">
                Gerir Reservas
            </a>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card h-100 p-3">
            <h3>Criar salas
            </h3>
            <p>Gestão das salas e edifícios.</p>
            <a asp-controller="CriarSalas"
               asp-action="CriarSalasIndex"
               class="btn btn-outline-primary w-100 mt-auto">
                Open module
            </a>
        </div>
    </div>

</div>
