@model ServiceRequestStatus

@{
    ViewData["Title"] = "New status";
}

<div class="container py-4">
    <a asp-action="Index" class="link-secondary text-decoration-none">
        <i class="bi bi-arrow-left"></i> Back to statuses
    </a>

    <header class="my-4">
        <h1 class="display-6">New status</h1>
        <p class="text-body-secondary">
            A step that requests can go through, and the rules that apply when a request gets it.
        </p>
    </header>

    <div class="row">
        <div class="col-lg-8">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. In progress" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="DisplayOrder" class="form-label"></label>
                        <input asp-for="DisplayOrder" class="form-control" min="1" max="99" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"
                              placeholder="What this status means for the requester"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Color" class="form-label"></label>
                    <select asp-for="Color" class="form-select" asp-items="new SelectList(ServiceRequestStatus.BadgeColors)"></select>
                    <span asp-validation-for="Color" class="text-danger small"></span>
                    <div class="form-text">
                        @foreach (var color in ServiceRequestStatus.BadgeColors) {
                            <span class="badge text-bg-@color me-1">@color</span>
                        }
                    </div>
                </div>

                <div class="form-check mb-2">
                    <input asp-for="IsFinal" class="form-check-input" />
                    <label asp-for="IsFinal" class="form-check-label"></label>
                    <div class="form-text mt-0">The request is closed when it gets this status (e.g. resolved or rejected).</div>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RequiresNote" class="form-check-input" />
                    <label asp-for="RequiresNote" class="form-check-label"></label>
                    <div class="form-text mt-0">The staff must write a note explaining the reason (e.g. rejected or waiting for information).</div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
