@model IEnumerable<UnivManagement.Models.AcademicManagement.UC>

@{
    ViewData["Title"] = "Index";
}


<!-- Main Header/Cabeçalho -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom-2 border-primary-subtle">
    <div>
        <h1 class="h2 text-primary fw-extrabold mb-1"><i class="bi bi-journal-bookmark-fill me-2"></i>Unidades Curriculares</h1>
        <p class="text-muted small mb-0">Gestão e listagem das disciplinas do sistema académico.</p>
    </div>
    <div class="mt-3 mt-sm-0">
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow px-4 py-2 fw-semibold w-100 w-sm-auto">
            <i class="bi bi-plus-lg"></i> Adicionar Nova
        </a>
    </div>
</div>

<!-- Data Table inside a Responsive Card/Tabela de Dados num Card -->
<div class="card shadow border-0 overflow-hidden">
    <div class="table-responsive rounded-3">
        <table class="table table-hover align-middle mb-0">
         
            <thead class="table-light fs-7 text-muted border-bottom-2">
                <tr>
                    <th scope="col" class="ps-4 py-3 text-uppercase tracking-wider">
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th scope="col" class="py-3">
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th scope="col" class="py-3 text-center">
                        @Html.DisplayNameFor(model => model.Acronym)
                    </th>
                    <th scope="col" class="py-3">
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th scope="col" class="pe-4 py-3 text-end" style="width: 140px;">Actions/Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-folder-x fs-1 text-secondary opacity-50 d-block mb-2"></i>
                            <span class="fw-medium">Nenhuma unidade curricular registada até ao momento.</span>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <!-- Código realçado -->
                            <td class="ps-4 py-3 fw-bold text-primary">
                                <code>@Html.DisplayFor(model => item.Code)</code>
                            </td>
                            <!-- Nome tem especie de negrito-->
                            <td class="py-3 fw-semibold text-dark">
                                @Html.DisplayFor(model => item.Name)
                            </td>
                            <!-- Badge -->
                            <td class="py-3 text-center">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill font-monospace fw-bold">
                                    @Html.DisplayFor(model => item.Acronym)
                                </span>
                            </td>
                            <!-- Descrição com Truncamento -->
                            <td class="py-3 text-muted text-truncate" style="max-width: 220px;">
                                @Html.DisplayFor(model => item.Description)
                            </td>
                            <!-- Action Buttons/Botões de Ação  -->
                            <td class="pe-4 py-3 text-end">
                                <div class="btn-group" role="group" aria-label="Ações">
                                    <a asp-action="Edit" asp-route-id="@item.UcId" 
                                       class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.UcId" 
                                       class="btn btn-sm btn-outline-info" title="Detalhes">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.UcId" 
                                       class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>