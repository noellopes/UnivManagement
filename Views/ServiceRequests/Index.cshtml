@model IEnumerable<ServiceRequest>

@{
    ViewData["Title"] = "Requests";

    var currentSearch = ViewData["Search"] as string;
    var currentStatus = (ViewData["Status"] as int?)?.ToString();
    var currentType = (ViewData["Type"] as int?)?.ToString();
    var currentPriority = (ViewData["Priority"] as int?)?.ToString();
    var onlyOverdue = ViewData["Overdue"] as bool? == true;

    // The controller already marks the selected type, status and priority
    var statusItems = ViewData["Statuses"] as SelectList;
    var typeItems = ViewData["Types"] as SelectList;
    var priorityItems = ViewData["Priorities"] as SelectList;

    bool isFiltered = !string.IsNullOrEmpty(currentSearch) || currentStatus != null || currentType != null
        || currentPriority != null || onlyOverdue;

    var paging = ViewData["Paging"] as ServiceRequestPagingInfo
        ?? new ServiceRequestPagingInfo { CurrentPage = 1, PageSize = Math.Max(1, Model.Count()), TotalItems = Model.Count() };

    // Route values of the current filters, so the page links keep them
    Dictionary<string, string> PageRoute(int page) {
        var route = new Dictionary<string, string> { ["page"] = page.ToString() };
        if (!string.IsNullOrEmpty(currentSearch)) route["search"] = currentSearch;
        if (currentStatus != null) route["status"] = currentStatus;
        if (currentType != null) route["type"] = currentType;
        if (currentPriority != null) route["priority"] = currentPriority;
        if (onlyOverdue) route["overdue"] = "true";
        return route;
    }
}

<div class="container py-4">
    <a asp-controller="AdministrativeServices" asp-action="Index" class="link-secondary text-decoration-none">
        <i class="bi bi-arrow-left"></i> Requests and Administrative Services
    </a>

    <header class="d-flex flex-wrap justify-content-between align-items-center my-4">
        <h1 class="display-6 mb-0">@ViewBag.Title</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New request
        </a>
    </header>

    @if (TempData["Message"] != null) {
        <div class="alert alert-success" role="alert">@TempData["Message"]</div>
    }

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <input type="text" name="search" value="@currentSearch" class="form-control"
                   placeholder="Search by title, requester name or email" aria-label="Search" />
        </div>
        <div class="col-md-2">
            <select name="type" class="form-select" aria-label="Request type" asp-items="typeItems">
                <option value="">All types</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select" aria-label="Status" asp-items="statusItems">
                <option value="">All statuses</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="priority" class="form-select" aria-label="Priority" asp-items="priorityItems">
                <option value="">All priorities</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="overdue" value="true" id="overdue"
                       checked="@onlyOverdue" />
                <label class="form-check-label" for="overdue">Only overdue</label>
            </div>
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-outline-primary" title="Filter">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </form>

    @if (isFiltered) {
        <p class="text-body-secondary">
            @paging.TotalItems result(s) for the selected filters.
            <a asp-action="Index">Clear filters</a>
        </p>
    }

    @if (!Model.Any()) {
        <div class="alert alert-info" role="alert">
            No requests found.
        </div>
    } else {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Html.DisplayNameFor(m => m.Title)</th>
                        <th>@Html.DisplayNameFor(m => m.Type)</th>
                        <th>@Html.DisplayNameFor(m => m.Status)</th>
                        <th>@Html.DisplayNameFor(m => m.Priority)</th>
                        <th>@Html.DisplayNameFor(m => m.RequesterName)</th>
                        <th>@Html.DisplayNameFor(m => m.AssignedTo)</th>
                        <th>@Html.DisplayNameFor(m => m.DueDate)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr class="@(item.IsOverdue ? "table-danger" : null)">
                            <td class="text-body-secondary">@item.ServiceRequestId</td>
                            <td>
                                @item.Title
                                <small class="text-body-secondary d-block">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </td>
                            <td>
                                @item.Type?.Name
                                @if (item.CatalogItem != null) {
                                    <small class="text-body-secondary d-block">
                                        <i class="bi bi-journal-bookmark"></i> @item.CatalogItem.Name
                                    </small>
                                }
                            </td>
                            <td>
                                <partial name="_ServiceRequestStatusBadge" model="item.Status" />
                            </td>
                            <td>
                                <partial name="_ServiceRequestPriorityBadge" model="item.Priority" />
                            </td>
                            <td>@item.RequesterName</td>
                            <td>@(item.AssignedTo ?? "—")</td>
                            <td class="text-nowrap">
                                @(item.DueDate?.ToString("yyyy-MM-dd") ?? "—")
                                @if (item.IsOverdue) {
                                    <span class="badge text-bg-danger d-block mt-1">Overdue</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.ServiceRequestId"
                                   class="btn btn-sm btn-outline-secondary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ServiceRequestId"
                                   class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ServiceRequestId"
                                   class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <p class="text-body-secondary small mb-0">
                Showing @paging.FirstItem to @paging.LastItem of @paging.TotalItems request(s)
            </p>

            @if (paging.TotalPages > 1) {
                <nav aria-label="Request pages">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(paging.HasPreviousPage ? null : "disabled")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(paging.CurrentPage - 1)"
                               aria-label="Previous page">&laquo;</a>
                        </li>
                        @if (paging.VisiblePages().First() > 1) {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(1)">1</a>
                            </li>
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        @foreach (int pageNumber in paging.VisiblePages()) {
                            <li class="page-item @(pageNumber == paging.CurrentPage ? "active" : null)"
                                aria-current="@(pageNumber == paging.CurrentPage ? "page" : null)">
                                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(pageNumber)">@pageNumber</a>
                            </li>
                        }
                        @if (paging.VisiblePages().Last() < paging.TotalPages) {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(paging.TotalPages)">@paging.TotalPages</a>
                            </li>
                        }
                        <li class="page-item @(paging.HasNextPage ? null : "disabled")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(paging.CurrentPage + 1)"
                               aria-label="Next page">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>
