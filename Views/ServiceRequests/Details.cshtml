@model ServiceRequest

@{
    ViewData["Title"] = "Request details";
}

<div class="container py-4">
    <a asp-action="Index" class="link-secondary text-decoration-none">
        <i class="bi bi-arrow-left"></i> Back to list
    </a>

    <header class="my-4">
        <h1 class="display-6">
            Request details
            <span class="text-body-secondary fs-4">#@Model.ServiceRequestId</span>
        </h1>
    </header>

    @if (TempData["Message"] != null) {
        <div class="alert alert-success" role="alert">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null) {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Title)</dt>
                        <dd class="col-sm-9">@Model.Title</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
                        <dd class="col-sm-9" style="white-space: pre-line">@(Model.Description ?? "—")</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CatalogItem)</dt>
                        <dd class="col-sm-9">
                            @if (Model.CatalogItem == null) {
                                <span class="text-body-secondary">Not in the catalog</span>
                            } else {
                                <a asp-controller="ServiceRequestCatalogItems" asp-action="Details"
                                   asp-route-id="@Model.CatalogItem.ServiceRequestCatalogItemId">@Model.CatalogItem.Name</a>
                                @if (!Model.CatalogItem.IsActive) {
                                    <span class="badge text-bg-secondary ms-1">Unavailable</span>
                                }
                                <small class="text-body-secondary d-block">
                                    Processing time: @Model.CatalogItem.ProcessingDays day(s)
                                </small>
                            }
                        </dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Type)</dt>
                        <dd class="col-sm-9">@Model.Type?.Name</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Status)</dt>
                        <dd class="col-sm-9"><partial name="_ServiceRequestStatusBadge" model="Model.Status" /></dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Priority)</dt>
                        <dd class="col-sm-9"><partial name="_ServiceRequestPriorityBadge" model="Model.Priority" /></dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DueDate)</dt>
                        <dd class="col-sm-9">
                            @(Model.DueDate?.ToString("d") ?? "—")
                            @if (Model.IsOverdue) {
                                <span class="badge text-bg-danger ms-1">
                                    Overdue by @((DateTime.Today - Model.DueDate!.Value.Date).Days) day(s)
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.RequesterName)</dt>
                        <dd class="col-sm-9">@Model.RequesterName</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.RequesterEmail)</dt>
                        <dd class="col-sm-9">@Model.RequesterEmail</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.AssignedTo)</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.AssignedTo) ? "—" : Model.AssignedTo)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("g")</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.UpdatedAt)</dt>
                        <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("g") ?? "—")</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ClosedAt)</dt>
                        <dd class="col-sm-9">@(Model.ClosedAt?.ToString("g") ?? "—")</dd>
                    </dl>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.CatalogItem?.RequiredDocuments)) {
                <div class="alert alert-light border mt-4 mb-0" role="note">
                    <h2 class="h6"><i class="bi bi-paperclip"></i> Documents needed for this service</h2>
                    <p class="mb-0 small" style="white-space: pre-line">@Model.CatalogItem.RequiredDocuments</p>
                </div>
            }

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.ServiceRequestId" class="btn btn-primary">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back to list</a>
            </div>

            <partial name="_ServiceRequestAttachments" model="Model" />
            <partial name="_ServiceRequestComments" model="Model" />
        </div>

        <div class="col-lg-4">
            <partial name="_ServiceRequestProcessForm" model="Model" />
            <partial name="_ServiceRequestHistory" model="Model.History" />
        </div>
    </div>
</div>
