@model UnivManagement.Models.ServiceRequest

@{
    ViewData["Title"] = "Add request";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="mb-4">
                <h1 class="h2 mb-1">Add request</h1>
                <p class="text-body-secondary mb-0">Fill in the information below. The request starts with the first status of the list.</p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-body-tertiary py-3">
                    <h2 class="h5 mb-0">
                        <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                        Request information
                    </h2>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter a short title" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ServiceRequestTypeId" class="form-label fw-semibold"></label>
                            <select asp-for="ServiceRequestTypeId" asp-items="ViewBag.Types" class="form-select">
                                <option value="">Select a request type</option>
                            </select>
                            <span asp-validation-for="ServiceRequestTypeId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RequesterName" class="form-label fw-semibold"></label>
                            <input asp-for="RequesterName" class="form-control" placeholder="Enter the requester's name" />
                            <span asp-validation-for="RequesterName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RequesterEmail" class="form-label fw-semibold"></label>
                            <input asp-for="RequesterEmail" class="form-control" placeholder="Enter the requester's email" />
                            <span asp-validation-for="RequesterEmail" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Optional description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                                Add request
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left-square me-1" aria-hidden="true"></i>
                                Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
