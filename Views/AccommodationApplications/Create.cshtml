@model UnivManagement.Models.AccommodationManagement.AccommodationApplication

@{
    ViewData["Title"] = "New Application";
}

<h1>Submit New Application</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="StudentId" class="control-label"></label>
                <input asp-for="StudentId" class="form-control" type="number" min="1" />
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AcademicYearId" class="control-label"></label>
                <input asp-for="AcademicYearId" class="form-control" type="number" min="1" />
                <span asp-validation-for="AcademicYearId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Em processo">Em processo</option>
                    <option value="Aceite">Aceite</option>
                    <option value="Recusada">Recusada</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SubmittedAt" class="control-label"></label>
                <input asp-for="SubmittedAt" class="form-control" />
                <span asp-validation-for="SubmittedAt" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="HasScholarshipPriority" class="control-label"></label>
                <input asp-for="HasScholarshipPriority" class="form-check-input" />
                <span asp-validation-for="HasScholarshipPriority" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PriorityCheckedAt" class="control-label"></label>
                <input asp-for="PriorityCheckedAt" class="form-control" />
                <span asp-validation-for="PriorityCheckedAt" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary mt-3">Back to List</a>
</div>
