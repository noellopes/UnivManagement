@{
    ViewData["Title"] = "Gestão de Alojamento";
}

<div class="container py-4">
    <header class="text-center mb-5">
        <h1 class="display-5">Gestão de Alojamento</h1>
        <p class="lead text-body-secondary">
            Residências, candidaturas, atribuição de quartos, contratos e ocupação.
        </p>
    </header>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Residências, Quartos e Camas</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Gestão das residências universitárias, dos seus quartos e das camas disponíveis.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Em desenvolvimento
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Candidaturas</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Submissão e avaliação de candidaturas a alojamento, com prioridade para estudantes bolseiros.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Em desenvolvimento
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Atribuições e Check-in/Check-out</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Atribuição de camas a estudantes e registo de entradas e saídas.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Em desenvolvimento
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Contratos e Pagamentos</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Contratos de alojamento, calendário de rendas e acompanhamento de pagamentos.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Em desenvolvimento
                    </button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Disponibilidade e Ocupação</h2>
                    <p class="card-text text-body-secondary flex-grow-1">
                        Consulta das camas livres e da taxa de ocupação por residência.
                    </p>
                    <button type="button" class="btn btn-outline-primary w-100" disabled>
                        Em desenvolvimento
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>