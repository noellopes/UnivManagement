@using UnivManagement.Models.AccommodationManagement
@model UnivManagement.Models.AccommodationManagement.AccommodationPayment

@{
    ViewData["Title"] = "Edit Payment";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h1 class="h4 fw-bold mb-1">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Edit Payment
                    </h1>
                    <p class="text-body-secondary mb-0">Update the details of the accommodation payment.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="AccommodationPaymentId" />

                        <div class="mb-3">
                            <label asp-for="AccommodationContractId" class="form-label">Contract</label>
                            <input asp-for="AccommodationContractId" class="form-control" />
                            <span asp-validation-for="AccommodationContractId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DueDate" class="form-label">Due Date</label>
                            <input asp-for="DueDate" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Amount" class="form-label">Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-currency-euro"></i></span>
                                    <input asp-for="Amount" class="form-control" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PaidAmount" class="form-label">Paid Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-currency-euro"></i></span>
                                    <input asp-for="PaidAmount" class="form-control" />
                                </div>
                                <span asp-validation-for="PaidAmount" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PaidAt" class="form-label">Paid At</label>
                            <input asp-for="PaidAt" class="form-control" />
                            <span asp-validation-for="PaidAt" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<PaymentStatus>()" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> Save
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>