@model IEnumerable<UnivManagement.Models.AccommodationManagement.AccommodationPayment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AccommodationContractId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaidAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaidAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.AccommodationContractId)
            </td>
            <td>
                @Html.DisplayFor(model => item.DueDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(model => item.PaidAmount)
            </td>
            <td>
                @Html.DisplayFor(model => item.PaidAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AccommodationPaymentId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AccommodationPaymentId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AccommodationPaymentId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
