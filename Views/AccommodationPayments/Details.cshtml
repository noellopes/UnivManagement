@using UnivManagement.Models.AccommodationManagement
@model UnivManagement.Models.AccommodationManagement.AccommodationPayment

@{
    ViewData["Title"] = "Payment Details";

    var badge = Model.Status == PaymentStatus.Paid ? "text-bg-success"
              : Model.Status == PaymentStatus.Overdue ? "text-bg-danger"
              : "text-bg-warning";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h1 class="h4 fw-bold mb-1">
                        <i class="bi bi-receipt text-primary me-2"></i>Payment Details
                    </h1>
                    <p class="text-body-secondary mb-0">Information about this accommodation payment.</p>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-body-secondary">Contract</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.AccommodationContractId)</dd>

                        <dt class="col-sm-5 text-body-secondary">Due Date</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.DueDate)</dd>

                        <dt class="col-sm-5 text-body-secondary">Amount</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.Amount)</dd>

                        <dt class="col-sm-5 text-body-secondary">Paid Amount</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.PaidAmount)</dd>

                        <dt class="col-sm-5 text-body-secondary">Paid At</dt>
                        <dd class="col-sm-7">
                            @if (Model.PaidAt != null)
                            {
                                @Html.DisplayFor(model => model.PaidAt)
                            }
                            else
                            {
                                <span class="text-body-secondary">&mdash;</span>
                            }
                        </dd>

                        <dt class="col-sm-5 text-body-secondary">Status</dt>
                        <dd class="col-sm-7 mb-0"><span class="badge @badge">@Html.DisplayFor(model => model.Status)</span></dd>
                    </dl>
                </div>
                <div class="card-footer bg-transparent border-0 pb-4 px-4 d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.AccommodationPaymentId" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
