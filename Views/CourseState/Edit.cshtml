@model UnivManagement.Models.AcademicManagement.CourseState

@{
    ViewData["Title"] = "Editar Estado de Curso";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Editar Estado de Curso</h1>
    <p class="text-muted mb-0">Atualize os dados do estado de curso selecionado.</p>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-body py-3">
        <h2 class="h5 mb-0">
            <i class="bi bi-flag me-2" aria-hidden="true"></i>
            Dados do Estado de Curso
        </h2>
    </div>

    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <input type="hidden" asp-for="CourseStateId" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="ACTIVE"
                           maxlength="50" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                    <small class="text-body-secondary d-block mt-1">
                        Apenas letras maiúsculas, espaços e underscores.
                    </small>
                </div>

                <div class="col-md-8">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <input asp-for="Description"
                           class="form-control"
                           placeholder="Descrição do estado (opcional)"
                           maxlength="200" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end flex-wrap gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                    Voltar à Lista
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                    Guardar Alterações
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}