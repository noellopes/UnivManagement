@model IEnumerable<UnivManagement.Models.ServiceRequestType>

@{
    ViewData["Title"] = "Request types";
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom">
    <div>
        <h1 class="h2 text-body-emphasis fw-bold mb-1">Request types</h1>
        <p class="text-muted small mb-0">Manage the kinds of requests that can be submitted.</p>
    </div>
    <div class="mt-2 mt-sm-0">
        <a asp-action="Create" class="btn btn-primary shadow-sm">Add New</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                    <th class="text-end" style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">No request types found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(model => item.Name)</td>
                            <td>@Html.DisplayFor(model => item.Description)</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Request type actions">
                                    <a asp-action="Edit" asp-route-id="@item.ServiceRequestTypeId"
                                       class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <a asp-action="Details" asp-route-id="@item.ServiceRequestTypeId"
                                       class="btn btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.ServiceRequestTypeId"
                                       class="btn btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>