@model ServiceRequestType

@{
    ViewData["Title"] = "New request type";
}

<div class="container py-4">
    <a asp-action="Index" class="link-secondary text-decoration-none">
        <i class="bi bi-arrow-left"></i> Back to request types
    </a>

    <header class="my-4">
        <h1 class="display-6">New request type</h1>
        <p class="text-body-secondary">
            Requests and services of the catalog are classified by type.
        </p>
    </header>

    <div class="row">
        <div class="col-lg-8">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Certificate" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="What kind of requests belong to this type"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
