@model UnivManagement.Models.ServiceRequestType

@{
    ViewData["Title"] = "Request type details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                    @ViewBag.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h1 class="h2 mb-1">Request type details</h1>
                    <p class="text-body-secondary mb-0">View information about this request type.</p>
                </div>
                <span class="badge text-bg-primary">Request type</span>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-body-tertiary py-3">
                    <h2 class="h5 mb-0">
                        <i class="bi bi-tag-fill me-2" aria-hidden="true"></i>
                        Request type information
                    </h2>
                </div>

                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-body-secondary mb-2">
                            @Html.DisplayNameFor(model => model.Name)
                        </dt>
                        <dd class="col-sm-8 fw-semibold mb-3">
                            @Html.DisplayFor(model => model.Name)
                        </dd>

                        <dt class="col-sm-4 text-body-secondary mb-2">
                            @Html.DisplayNameFor(model => model.Description)
                        </dt>
                        <dd class="col-sm-8 mb-0">
                            @(Model.Description ?? "(No description)")
                        </dd>
                    </dl>
                </div>

                <div class="card-footer bg-body-tertiary p-3">
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Edit" asp-route-id="@Model?.ServiceRequestTypeId" class="btn btn-primary">
                            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>
                            Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@Model?.ServiceRequestTypeId" class="btn btn-danger">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                            Delete
                        </a>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left-square me-1" aria-hidden="true"></i>
                            Back to List
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
