@model UnivManagement.Models.CriterioAvaliacao

@{
    ViewData["Title"] = "Eliminar Critério de Avaliação";
}

<h1>Eliminar Critério de Avaliação</h1>

<h3>Tem a certeza de que pretende eliminar este registo?</h3>
<div>
    <h4>Critério de Avaliação</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UcId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UcId)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UC)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UC.Name)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.PesoTrab)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.PesoTrab)
        </dd>
    </dl>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="CriterioAvaliacaoId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Voltar à Lista</a>
    </form>
</div>