@model UnivManagement.Models.CriterioAvaliacao

@{
    ViewData["Title"] = "Criar Critério de Avaliação";

    var valoresPeso = new List<string>
    {
        "0,10", "0,15", "0,20", "0,25", "0,30",
        "0,35", "0,40", "0,45", "0,50", "0,55",
        "0,60", "0,65", "0,70", "0,75", "0,80"
    };

    var listaPesos = new List<SelectListItem>();
    foreach (var valor in valoresPeso)
    {
        listaPesos.Add(new SelectListItem { Text = valor, Value = valor });
    }
}

<h1>Criar Critério de Avaliação</h1>

<h4>Critério de Avaliação</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="UcId" class="control-label">Unidade Curricular</label>
                <select asp-for="UcId" class="form-control" asp-items="ViewBag.UcId">
                    <option value="">-- Selecione uma UC --</option>
                </select>
                <span asp-validation-for="UcId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PesoTrab" class="control-label">Peso do Trabalho</label>
                <select asp-for="PesoTrab" class="form-control" asp-items="listaPesos">
                    <option value="">-- Selecione o peso --</option>
                </select>
                <span asp-validation-for="PesoTrab" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Criar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Voltar à Lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}