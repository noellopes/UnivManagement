@model ServiceRequestAssignment

@{
    ViewData["Title"] = "Delete assignment";
}

<div class="container py-4">
    <a asp-action="Index" class="link-secondary text-decoration-none">Back to assignments</a>

    <header class="my-4">
        <h1 class="display-6">Delete assignment</h1>
    </header>

    <div class="alert alert-danger" role="alert">
        Are you sure you want to delete this assignment? This action cannot be undone.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ServiceRequest)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ServiceRequest!.Title)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FuncionarioId)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FuncionarioId)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DepartamentoId)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.DepartamentoId)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AssignedAt)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.AssignedAt)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EndedAt)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.EndedAt)</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.ServiceRequestAssignmentId" method="post" class="mt-4">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
