@model ServiceRequestAssignment

@{
    ViewData["Title"] = "New assignment";
}

<div class="container py-4">
    <a asp-action="Index" class="link-secondary text-decoration-none">Back to assignments</a>

    <header class="my-4">
        <h1 class="display-6">New assignment</h1>
        <p class="text-body-secondary">Choose the request and who is in charge of it.</p>
    </header>

    <div class="row">
        <div class="col-lg-8">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="ServiceRequestId" class="form-label"></label>
                    <select asp-for="ServiceRequestId" class="form-select" asp-items="ViewBag.ServiceRequestId">
                        <option value="">Choose a request</option>
                    </select>
                    <span asp-validation-for="ServiceRequestId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FuncionarioId" class="form-label"></label>
                    <input asp-for="FuncionarioId" class="form-control" min="1" />
                    <span asp-validation-for="FuncionarioId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DepartamentoId" class="form-label"></label>
                    <input asp-for="DepartamentoId" class="form-control" min="1" />
                    <span asp-validation-for="DepartamentoId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AssignedAt" class="form-label"></label>
                    <input asp-for="AssignedAt" class="form-control" />
                    <span asp-validation-for="AssignedAt" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndedAt" class="form-label"></label>
                    <input asp-for="EndedAt" class="form-control" />
                    <span asp-validation-for="EndedAt" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Note" class="form-label"></label>
                    <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Note" class="text-danger small"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
