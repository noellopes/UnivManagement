
@model IEnumerable<UnivManagement.Models.Livro>

@{
    ViewData["Title"] = "Catálogo da Biblioteca";
}

<h1>Catálogo da Biblioteca</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Adicionar Livro
    </a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>ISBN</th>
            <th>Título</th>
            <th>Tipo</th>
            <th>Valor da Multa</th>
            <th>Autores</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ISBN</td>

                <td>@item.Titulo</td>

                <td>@item.Tipo</td>

                <td>
                    @item.ValorMulta.ToString("F2") €
                </td>

                <td>
                    @if (item.LivrosAutores.Any())
                    {
                        @string.Join(", ",
                            item.LivrosAutores.Select(la => la.Autor.Nome))
                    }
                    else
                    {
                        <span>Sem autores associados</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.LivroId"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.LivroId"
                       class="btn btn-info btn-sm">
                        Detalhes
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.LivroId"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
