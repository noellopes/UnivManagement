@model UnivManagement.Models.AccommodationManagement.AccommodationContract

@{
    ViewData["Title"] = "Criar Contrato";
}

<style>
    .create-contract-wrapper {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1.5rem 1rem 2.5rem;
    }

    .create-contract-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .create-contract-header h1 {
        font-size: 2rem;
        font-weight: 600;
        color: #111827;
        margin: 0;
    }

    .create-contract-card {
        max-width: 780px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        padding: 1.5rem 1.75rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    .create-contract-card h2 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #111827;
        margin-bottom: 1.25rem;
    }

    .form-actions-row {
        display: flex;
        gap: 0.6rem;
        margin-top: 1.5rem;
    }
</style>

<div class="create-contract-wrapper">
    <div class="create-contract-header">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar à Lista</a>
    </div>

    <div class="create-contract-card">
        <h2>Novo Contrato de Alojamento</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="RoomAllocationId" class="form-label"></label>
                    <input asp-for="RoomAllocationId" type="number" class="form-control" />
                    <span asp-validation-for="RoomAllocationId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ContractStatusId" class="form-label"></label>
                    <select asp-for="ContractStatusId" asp-items="ViewBag.ContractStatusId" class="form-select">
                        <option value="">-- Selecione o Estado --</option>
                    </select>
                    <span asp-validation-for="ContractStatusId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MonthlyRent" class="form-label"></label>
                    <input asp-for="MonthlyRent" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="MonthlyRent" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Deposit" class="form-label"></label>
                    <input asp-for="Deposit" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Deposit" class="text-danger small"></span>
                </div>

               <div class="col-md-6">
    <label asp-for="SignedDocumentId" class="form-label">Documento Assinado</label>
    <select asp-for="SignedDocumentId" class="form-select">
        <option value="">Não</option>
        <option value="1">Sim</option>
    </select>
    <span asp-validation-for="SignedDocumentId" class="text-danger small"></span>
</div>
            </div>

            <div class="form-actions-row">
                <button type="submit" class="btn btn-primary">Criar Contrato</button>
                <a asp-action="Index" class="btn btn-light border">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}