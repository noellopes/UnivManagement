@model UnivManagement.Models.AcademicManagement.Course

@{
    ViewData["Title"] = "Detalhes do Curso";
}

@if (ViewBag.SuccessMessage != null) {
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<div class="mb-4">
    <h1 class="h2 mb-1">Detalhes do Curso</h1>
    <p class="text-muted mb-0">Consulte a informação do curso selecionado.</p>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-body py-3">
        <h2 class="h5 mb-0">
            <i class="bi bi-mortarboard me-2" aria-hidden="true"></i>
            Dados do Curso
        </h2>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.Code)
            </dt>
            <dd class="col-sm-9 fw-semibold">
                @Html.DisplayFor(model => model.Code)
            </dd>

            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Name)
            </dd>

            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.Acronym)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Acronym)
            </dd>

            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.CreationDate)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.CreationDate)
            </dd>

            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.AcademicDegreeId)
            </dt>
            <dd class="col-sm-9">
                <span class="badge text-bg-secondary">
                    @Html.DisplayFor(model => model.AcademicDegree!.Name)
                </span>
            </dd>

            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.DocenteId)
            </dt>
            <dd class="col-sm-9">
                @(Model.Docente?.Nome ?? "Sem diretor atribuído")
            </dd>

            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.CourseStateId)
            </dt>
            <dd class="col-sm-9">
                <span class="badge text-bg-secondary">
                    @Html.DisplayFor(model => model.CourseState!.Name)
                </span>
            </dd>

            <dt class="col-sm-3 text-muted">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Description)
            </dd>
        </dl>
    </div>

    <div class="card-footer bg-body">
        <div class="d-flex justify-content-end flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                Voltar à Lista
            </a>

            <a asp-action="Edit" asp-route-id="@Model?.CourseId" class="btn btn-primary">
                <i class="bi bi-pencil me-2" aria-hidden="true"></i>
                Editar
            </a>

            <a asp-action="Delete" asp-route-id="@Model?.CourseId" class="btn btn-danger">
                <i class="bi bi-trash me-2" aria-hidden="true"></i>
                Eliminar
            </a>
        </div>
    </div>
</div>
