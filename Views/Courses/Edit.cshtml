@model UnivManagement.Models.AcademicManagement.Course
@using UnivManagement.Models.AcademicManagement

@{
    ViewData["Title"] = "Editar Curso";

    var calendarOptions = ViewData["SchoolCalendars"] as IEnumerable<SchoolCalendar>
        ?? Enumerable.Empty<SchoolCalendar>();

    var selectedCalendarIds = ViewData["SelectedSchoolCalendarIds"] as IEnumerable<int>
        ?? Enumerable.Empty<int>();

    // Full data for the calendars already associated with the course.
    var calendarsById = calendarOptions.ToDictionary(calendar => calendar.SchoolCalendarId);
    var selectedCalendars = selectedCalendarIds
        .Where(calendarsById.ContainsKey)
        .Select(id => calendarsById[id])
        .ToList();
}

@functions {
    private static string CalendarYearLabel(SchoolCalendar calendar) {
        var year = calendar.AcademicYear;
        return year == null ? "—" : $"{year.StartYear}/{year.EndYear}";
    }

    private static string CalendarLabel(SchoolCalendar calendar) =>
        $"{CalendarYearLabel(calendar)} — {calendar.Code}";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Editar Curso</h1>
    <p class="text-muted mb-0">Atualize os dados do curso selecionado.</p>
</div>

<form asp-action="Edit" id="courseEditForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-body py-3">
            <h2 class="h5 mb-0">
                <i class="bi bi-pencil-square me-2" aria-hidden="true"></i>
                Dados do Curso
            </h2>
        </div>

        <div class="card-body">
            <input type="hidden" asp-for="CourseId" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Acronym" class="form-label"></label>
                    <input asp-for="Acronym" class="form-control" />
                    <span asp-validation-for="Acronym" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CreationDate" class="form-label"></label>
                    <input asp-for="CreationDate" class="form-control" />
                    <span asp-validation-for="CreationDate" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="AcademicDegreeId" class="form-label"></label>
                    <select asp-for="AcademicDegreeId" class="form-select" asp-items="ViewBag.AcademicDegrees">
                        <option value="">-- Selecione o grau académico --</option>
                    </select>
                    <span asp-validation-for="AcademicDegreeId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DocenteId" class="form-label">
                        Diretor do Curso
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <select asp-for="DocenteId" class="form-select" asp-items="ViewBag.Docentes">
                        <option value="">-- Sem diretor atribuído --</option>
                    </select>
                    <span asp-validation-for="DocenteId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CourseState" class="form-label"></label>
                    <select asp-for="CourseState" class="form-select" asp-items="Html.GetEnumSelectList<CourseStateEnum>()">
                        <option value="">-- Selecione o estado do curso --</option>
                    </select>
                    <span asp-validation-for="CourseState" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- COURSE CALENDARS -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-body py-3">
            <h2 class="h5 mb-0">
                <i class="bi bi-calendar-range me-2" aria-hidden="true"></i>
                Calendários Escolares
            </h2>
        </div>

        <div class="card-body p-0">
            @if (!calendarOptions.Any()) {
                <div class="p-4 text-muted">
                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                    Ainda não existem calendários escolares disponíveis. Crie um calendário escolar primeiro.
                </div>
            }
            else {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Ano Letivo</th>
                                <th scope="col">Código</th>
                                <th scope="col">Início</th>
                                <th scope="col">Fim</th>
                                <th scope="col" class="text-center">Semestres</th>
                                <th scope="col">Exames Especiais</th>
                                <th scope="col" class="text-end" style="width: 8rem;">Ações</th>
                            </tr>
                        </thead>

                        <tbody id="calendarRows">
                            @foreach (var calendar in selectedCalendars) {
                                var start = calendar.StartDate.ToString("dd/MM/yyyy");
                                var end = calendar.EndDate.ToString("dd/MM/yyyy");
                                var special = $"{calendar.StartSpecialExam:dd/MM/yyyy} – {calendar.EndSpecialExam:dd/MM/yyyy}";

                                <tr data-calendar-row data-academic-year="@calendar.AcademicYearId">
                                    <td class="fw-semibold">@CalendarYearLabel(calendar)</td>
                                    <td>@calendar.Code</td>
                                    <td>@start</td>
                                    <td>@end</td>
                                    <td class="text-center">@calendar.TotalSemesters</td>
                                    <td>@special</td>
                                    <td class="text-end">
                                        <input type="hidden" name="schoolCalendarIds" value="@calendar.SchoolCalendarId" />
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                data-remove-calendar>
                                            <i class="bi bi-trash me-1" aria-hidden="true"></i>
                                            Remover
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 border-top">
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-8">
                            <label for="calendarToAdd" class="form-label small mb-1">Adicionar calendário escolar</label>
                            <select id="calendarToAdd" class="form-select">
                                <option value="">-- Selecione um calendário --</option>

                                @foreach (var calendar in calendarOptions) {
                                    var start = calendar.StartDate.ToString("dd/MM/yyyy");
                                    var end = calendar.EndDate.ToString("dd/MM/yyyy");
                                    var special = $"{calendar.StartSpecialExam:dd/MM/yyyy} – {calendar.EndSpecialExam:dd/MM/yyyy}";

                                    <option value="@calendar.SchoolCalendarId"
                                            data-academic-year="@calendar.AcademicYearId"
                                            data-year="@CalendarYearLabel(calendar)"
                                            data-code="@calendar.Code"
                                            data-start="@start"
                                            data-end="@end"
                                            data-semesters="@calendar.TotalSemesters"
                                            data-special="@special">
                                        @CalendarLabel(calendar)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-auto">
                            <button type="button" class="btn btn-outline-primary w-100" id="addCalendarBtn">
                                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>
                                Adicionar
                            </button>
                        </div>
                    </div>

                    <p id="noCalendarsMessage"
                       class="text-muted small mt-2 mb-0 @(selectedCalendars.Any() ? "d-none" : "")">
                        Este curso ainda não tem calendários escolares associados.
                    </p>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
            Voltar à Lista
        </a>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
            Guardar Alterações
        </button>
    </div>
</form>

<template id="calendarRowTemplate">
    <tr data-calendar-row data-academic-year="">
        <td class="fw-semibold" data-calendar-year></td>
        <td data-calendar-code></td>
        <td data-calendar-start></td>
        <td data-calendar-end></td>
        <td class="text-center" data-calendar-semesters></td>
        <td data-calendar-special></td>
        <td class="text-end">
            <input type="hidden" name="schoolCalendarIds" value="" />
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    data-remove-calendar>
                <i class="bi bi-trash me-1" aria-hidden="true"></i>
                Remover
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const form = document.getElementById('courseEditForm');
            const container = document.getElementById('calendarRows');
            const addButton = document.getElementById('addCalendarBtn');
            const addSelect = document.getElementById('calendarToAdd');
            const template = document.getElementById('calendarRowTemplate');
            const emptyMessage = document.getElementById('noCalendarsMessage');

            // The editor is optional; bail out when the page has no calendars.
            if (!form || !container || !addButton || !addSelect || !template) return;

            // All calendar rows currently displayed.
            function rows() {
                return Array.from(container.querySelectorAll('[data-calendar-row]'));
            }

            // Keep the "no calendars" message in sync with the table.
            function updateEmptyMessage() {
                if (emptyMessage) emptyMessage.classList.toggle('d-none', rows().length > 0);
            }

            // Disable calendars already associated and calendars from an academic
            // year already used by another row. A course allows only one calendar
            // per academic year.
            function syncOptions() {
                const usedIds = new Set(rows()
                    .map(row => row.querySelector('input[name="schoolCalendarIds"]')?.value)
                    .filter(Boolean));

                const usedYears = new Set(rows()
                    .map(row => row.dataset.academicYear)
                    .filter(Boolean));

                Array.from(addSelect.options).forEach(function (option) {
                    if (option.value === '') return;

                    option.disabled = usedIds.has(option.value)
                        || usedYears.has(option.dataset.academicYear);
                });

                updateEmptyMessage();
            }

            // Append a read-only row filled from the selected calendar's data.
            function addRow() {
                const option = addSelect.selectedOptions[0];
                if (!option || option.value === '') return;

                const fragment = template.content.cloneNode(true);
                const row = fragment.querySelector('[data-calendar-row]');

                row.dataset.academicYear = option.dataset.academicYear;
                row.querySelector('[data-calendar-year]').textContent = option.dataset.year;
                row.querySelector('[data-calendar-code]').textContent = option.dataset.code;
                row.querySelector('[data-calendar-start]').textContent = option.dataset.start;
                row.querySelector('[data-calendar-end]').textContent = option.dataset.end;
                row.querySelector('[data-calendar-semesters]').textContent = option.dataset.semesters;
                row.querySelector('[data-calendar-special]').textContent = option.dataset.special;
                row.querySelector('input[name="schoolCalendarIds"]').value = option.value;

                container.appendChild(fragment);
                addSelect.value = '';
                syncOptions();
            }

            // Remove the row. Existing links are deleted only when the form is saved.
            function removeRow(row) {
                row.remove();
                syncOptions();
            }

            addButton.addEventListener('click', addRow);

            // Delegated events keep rows added later working.
            form.addEventListener('click', function (event) {
                const removeButton = event.target.closest('[data-remove-calendar]');
                if (!removeButton) return;

                removeRow(removeButton.closest('[data-calendar-row]'));
            });

            // Initial pass.
            syncOptions();
        })();
    </script>
}
