@model IEnumerable<UnivManagement.Models.CandidaturaBolsa>

@{
    ViewData["Title"] = "Avaliação e Ranking";
}

<div class="container mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>✅ Sucesso:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h2>Avaliação e Ranking de Candidaturas</h2>
    <p class="text-muted">Aplicações ordenadas por mérito (Classificação).</p>

    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Ranking</th>
                <th>Estudante</th>
                <th>Classificação</th>
                <th>Data Submissão</th>
                <th>Estado</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rank = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>#@rank</strong></td>
                    <td>@item.NomeEstudante</td>
                    <td>@item.Classificacao.ToString("0.0") Valores</td>
                    <td>@item.DataSubmissao.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.Estado == "Aprovado")
                        {
                            <span class="badge bg-success">Aprovado</span>
                        }
                        else if (item.Estado == "Rejeitado")
                        {
                            <span class="badge bg-danger">Rejeitado</span>
                        }
                        else if (item.Estado == "Lista de Espera")
                        {
                            <span class="badge bg-warning text-dark">Em Espera</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pendente</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Avaliar" asp-route-id="@item.Id_CandidaturaBolsa" class="btn btn-primary btn-sm">
                            @(item.Estado == "Pendente" ? "Avaliar" : "Reavaliar")
                        </a>
                    </td>
                </tr>
                rank++;
            }
        </tbody>
    </table>
</div>