@model UnivManagement.Models.AvaliacaoBolsa

@{
    ViewData["Title"] = "Avaliar Candidatura";
}

<div class="container mt-4">
    <h2>Emitir Parecer Técnico</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Avaliar" method="post">
                @Html.AntiForgeryToken()

                <!-- Explicitly binding the hidden ID -->
                <input type="hidden" asp-for="Id_CandidaturaBolsa" />

                <div class="form-group mb-3">
                    <label asp-for="Resultado" class="control-label fw-bold">Decisão Final</label>
                    <select asp-for="Resultado" class="form-select">
                        <option value="Aprovado">Aprovado</option>
                        <option value="Rejeitado">Rejeitado</option>
                        <option value="Lista de Espera">Lista de Espera</option>
                    </select>
                    <span asp-validation-for="Resultado" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Parecer" class="control-label fw-bold">Parecer Técnico (Justificação)</label>
                    <textarea asp-for="Parecer" class="form-control" rows="4" required></textarea>
                    <span asp-validation-for="Parecer" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Observacoes" class="control-label fw-bold">Observações Adicionais</label>
                    <input asp-for="Observacoes" class="form-control" />
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Confirmar Decisão" class="btn btn-success" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Voltar à Lista</a>
                </div>
            </form>
        </div>
    </div>
</div>