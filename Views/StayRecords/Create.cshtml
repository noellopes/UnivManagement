@model UnivManagement.Models.AccommodationManagement.StayRecord

@{
    ViewData["Title"] = "Criar Registo";
}

<h1>Criar Registo</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="RoomAllocationId" class="control-label"></label>
                <input asp-for="RoomAllocationId" class="form-control" />
                <span asp-validation-for="RoomAllocationId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Type" class="control-label"></label>
                <select asp-for="Type" class="form-control">
                    <option value="">-- Selecione o Tipo --</option>
                    <option value="CheckIn">Check-In</option>
                    <option value="CheckOut">Check-Out</option>
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="OccurredAt" class="control-label"></label>
                <input asp-for="OccurredAt" class="form-control" />
                <span asp-validation-for="OccurredAt" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConditionNotes" class="control-label"></label>
                <input asp-for="ConditionNotes" class="form-control" />
                <span asp-validation-for="ConditionNotes" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RecordedBy" class="control-label"></label>
                <input asp-for="RecordedBy" class="form-control" />
                <span asp-validation-for="RecordedBy" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

