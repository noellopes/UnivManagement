@model UnivManagement.Models.EstadoPossivel

@{
    ViewData["Title"] = "Detalhes do estado";
}

<div class="text-center mb-3">
    <h1 style="color: #1d4e6b;">Detalhes do estado</h1>
    <p class="text-muted mb-0">Informação deste estado possível.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm" style="border-top: 4px solid #e8a33d;">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nome do estado</dt>
                    <dd class="col-sm-8">@Model.NomeEstado</dd>

                    <dt class="col-sm-4">Descrição</dt>
                    <dd class="col-sm-8">@Model.Descricao</dd>
                </dl>

                <hr />

                <div class="text-center">
                    <a asp-action="Edit" asp-route-id="@Model.EstadoPossivelId"
                       class="btn" style="color: #1d4e6b; border-color: #1d4e6b;">Editar</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
                </div>
            </div>
        </div>
    </div>
</div>