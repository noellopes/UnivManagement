@model UnivManagement.Models.EstadoPossivel

@{
    ViewData["Title"] = "Eliminar estado";
}

<div class="text-center mb-3">
    <h1 style="color: #1d4e6b;">Eliminar estado</h1>
    <p class="text-muted mb-0">Tem a certeza de que pretende eliminar este estado?</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm" style="border-top: 4px solid #dc3545;">
            <div class="card-body">
                <div class="alert alert-warning" role="alert">
                    Esta ação não pode ser desfeita.
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Nome do estado</dt>
                    <dd class="col-sm-8">@Model.NomeEstado</dd>

                    <dt class="col-sm-4">Descrição</dt>
                    <dd class="col-sm-8">@Model.Descricao</dd>
                </dl>

                <hr />

                <form asp-action="Delete" class="text-center">
                    <input type="hidden" asp-for="EstadoPossivelId" />
                    <button type="submit" class="btn btn-outline-danger">Eliminar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>