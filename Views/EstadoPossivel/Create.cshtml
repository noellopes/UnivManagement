@model UnivManagement.Models.EstadoPossivel

@{
    ViewData["Title"] = "Adicionar estado";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h1 style="color: #1d4e6b;">Adicionar estado</h1>
                <p class="text-muted mb-0">Preencha os dados do novo estado possível.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
        </div>

        <div class="card shadow-sm" style="border-top: 4px solid #e8a33d;">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="NomeEstado" class="form-label">Nome do estado</label>
                        <input asp-for="NomeEstado" class="form-control" placeholder="Ex.: Em análise" />
                        <span asp-validation-for="NomeEstado" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label">Descrição</label>
                        <textarea asp-for="Descricao" class="form-control" rows="3"
                                  placeholder="Explique o que significa este estado"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn text-white" style="background-color: #1d4e6b; border-color: #1d4e6b;">
                            Guardar estado
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}