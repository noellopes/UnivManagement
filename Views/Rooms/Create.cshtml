@model UnivManagement.Models.AccommodationManagement.Room1

@{
    ViewData["Title"] = "Create Room";
}

<style>
    .create-room-wrapper {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1.5rem 1rem 2.5rem;
    }

    .create-room-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .create-room-header h1 {
        font-size: 2rem;
        font-weight: 600;
        color: #111827;
        margin: 0;
    }

    .create-room-card {
        max-width: 780px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        padding: 1.5rem 1.75rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    .create-room-card h2 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #111827;
        margin-bottom: 1.25rem;
    }

    .form-actions-row {
        display: flex;
        gap: 0.6rem;
        margin-top: 1.5rem;
    }
</style>

<div class="create-room-wrapper">
    <div class="create-room-header">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar à Lista</a>
    </div>

    <div class="create-room-card">
        <h2>Novo Quarto de Alojamento</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ResidenceId" class="form-label">Residência</label>
                    <input asp-for="ResidenceId" class="form-control" placeholder="Ex: 1" />
                    <span asp-validation-for="ResidenceId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Number" class="form-label">Número do Quarto</label>
                    <input asp-for="Number" class="form-control" placeholder="Ex: 101-A" />
                    <span asp-validation-for="Number" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Floor" class="form-label">Piso</label>
                    <input asp-for="Floor" class="form-control" placeholder="Ex: 1" />
                    <span asp-validation-for="Floor" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Capacity" class="form-label">Capacidade</label>
                    <input asp-for="Capacity" class="form-control" placeholder="Ex: 2" />
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CurrentOccupancy" class="form-label">Ocupação Atual</label>
                    <input asp-for="CurrentOccupancy" class="form-control" placeholder="Ex: 0" />
                    <span asp-validation-for="CurrentOccupancy" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="RoomTypeId" class="form-label">Tipo</label>
                    <select asp-for="RoomTypeId" asp-items="ViewBag.RoomTypeId" class="form-select">
                        <option value="">-- Selecione o Tipo --</option>
                    </select>
                    <span asp-validation-for="RoomTypeId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="RoomStatusId" class="form-label">Estado</label>
                    <select asp-for="RoomStatusId" asp-items="ViewBag.RoomStatusId" class="form-select">
                        <option value="">-- Selecione o Estado --</option>
                    </select>
                    <span asp-validation-for="RoomStatusId" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-actions-row">
                <button type="submit" class="btn btn-primary">Criar</button>
                <a asp-action="Index" class="btn btn-light border">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}