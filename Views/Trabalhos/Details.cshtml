@model UnivManagement.Models.Trabalho

@{
    ViewData["Title"] = "Detalhes do trabalho";
}

<div class="container py-4">
    <h1 class="h3 mb-4">Detalhes do trabalho</h1>

    <dl class="row">
        <dt class="col-sm-3">Título</dt>
        <dd class="col-sm-9">@Model.Titulo</dd>

        <dt class="col-sm-3">Descrição</dt>
        <dd class="col-sm-9 text-break" style="white-space: pre-wrap;">@Model.Descricao</dd>

        <dt class="col-sm-3">Tipo de trabalho</dt>
        <dd class="col-sm-9">@(Model.E_individual ? "Individual" : "Em grupo")</dd>

        <dt class="col-sm-3">Data-limite de entrega</dt>
        <dd class="col-sm-9">@Model.Data_Limite.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">ID do docente</dt>
        <dd class="col-sm-9">@Model.DocenteId</dd>

        <dt class="col-sm-3">ID da unidade curricular</dt>
        <dd class="col-sm-9">@Model.UcId</dd>
    </dl>

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-trabalhoid="@Model.TrabalhoID"
           class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
    </div>
</div>