@model UnivManagement.Models.Trabalho

@{
    ViewData["Title"] = "Detalhes do trabalho";
}

<div class="container py-4">
    <h1 class="h3 mb-4">Detalhes do trabalho</h1>

    <dl class="row">
        <dt class="col-sm-3">Título</dt>
        <dd class="col-sm-9">@Model.Titulo</dd>

        <dt class="col-sm-3">Descrição</dt>
        <dd class="col-sm-9 text-break" style="white-space: pre-wrap;">@Model.Descricao</dd>

        <dt class="col-sm-3">Tipo de trabalho</dt>
        <dd class="col-sm-9">@(Model.EIndividual ? "Individual" : "Em grupo")</dd>

        <dt class="col-sm-3">Data-limite de entrega</dt>
        <dd class="col-sm-9">@Model.DataLimite.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Docente</dt>
        <dd class="col-sm-9">@(Model.Docente?.Nome ?? $"ID {Model.DocenteId}")</dd>

        <dt class="col-sm-3">Unidade curricular</dt>
        <dd class="col-sm-9">@(Model.UC?.Name ?? $"ID {Model.UcId}")</dd>
    </dl>

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.TrabalhoId"
           class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
    </div>

    @if (!Model.EIndividual)
    {
        <section class="mt-4">
            <h2 class="h5">Grupos do trabalho</h2>

            @if (TempData["GrupoCriado"] is string mensagemCriacao)
            {
                <div class="alert alert-success" role="status">@mensagemCriacao</div>
            }

            @if (TempData["GrupoEliminado"] is string mensagemEliminacao)
            {
                <div class="alert alert-success" role="status">@mensagemEliminacao</div>
            }

            @if (TempData["GrupoErro"] is string erro)
            {
                <div class="alert alert-danger" role="alert">@erro</div>
            }

            @if (ViewData["GruposTrabalho"] is IEnumerable<UnivManagement.Models.GrupoTrabalho> grupos
                && grupos.Any())
            {
                <ul class="list-group mb-3">
                    @foreach (var grupo in grupos)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@grupo.Nome</span>
                            <a asp-action="GerirMembros"
                               asp-route-grupoId="@grupo.GrupoTrabalhoId"
                               class="btn btn-sm btn-outline-primary">
                                Gerir membros
                            </a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">Ainda não existem grupos neste trabalho.</p>
            }

            <form asp-action="CriarGrupo" method="post">
                <input type="hidden" name="trabalhoId" value="@Model.TrabalhoId" />

                <div class="mb-3">
                    <label for="nomeGrupo" class="form-label">Nome do grupo</label>
                    <input id="nomeGrupo" name="nome" class="form-control"
                           maxlength="100" required />
                </div>

                <button type="submit" class="btn btn-primary">Criar grupo</button>
            </form>
        </section>
    }
</div>