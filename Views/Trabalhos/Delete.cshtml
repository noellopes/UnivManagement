@model UnivManagement.Models.Trabalho

@{
    ViewData["Title"] = "Eliminar trabalho";
}

<div class="container py-4">
    <h1 class="h3 mb-4">Eliminar trabalho</h1>

    <div class="alert alert-warning">
        Tens a certeza de que queres eliminar este trabalho?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Título</dt>
        <dd class="col-sm-9">@Model.Titulo</dd>

        <dt class="col-sm-3">Descrição</dt>
        <dd class="col-sm-9 text-break"
            style="white-space: pre-wrap;">@Model.Descricao</dd>

        <dt class="col-sm-3">Tipo de trabalho</dt>
        <dd class="col-sm-9">
            @(Model.EIndividual ? "Individual" : "Em grupo")
        </dd>

        <dt class="col-sm-3">Data-limite de entrega</dt>
        <dd class="col-sm-9">
            @Model.DataLimite.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-3">ID do docente</dt>
        <dd class="col-sm-9">@Model.DocenteId</dd>

        <dt class="col-sm-3">ID da unidade curricular</dt>
        <dd class="col-sm-9">@Model.UcId</dd>
    </dl>

    <form asp-action="Delete"
          asp-route-id="@Model.TrabalhoId"
          method="post"
          class="d-flex gap-2">

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>

        <a asp-action="IndexDocente"
           class="btn btn-outline-secondary">
            Cancelar
        </a>
    </form>
</div>