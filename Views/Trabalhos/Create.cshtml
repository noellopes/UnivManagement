@model UnivManagement.Models.Trabalho

@{
    ViewData["Title"] = "Criar trabalho";
}

<div class="container py-4">
    <h1 class="h3 mb-4">Criar trabalho</h1>

    <form asp-action="Create" method="post" class="col-lg-8">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label">Título</label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descricao" class="form-label">Descrição</label>
            <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="DocenteId" class="form-label">ID do docente</label>
                <input asp-for="DocenteId" type="number" min="1" required class="form-control" />
                <span asp-validation-for="DocenteId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="UcId" class="form-label">ID da unidade curricular</label>
                <input asp-for="UcId" type="number" min="1" required class="form-control" />
                <span asp-validation-for="UcId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="E_individual" class="form-label">Tipo de trabalho</label>
                <select asp-for="E_individual" class="form-select">
                    <option value="false">Em grupo</option>
                    <option value="true">Individual</option>
                </select>
                <span asp-validation-for="E_individual" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Data_Limite" class="form-label">Data-limite de entrega</label>
                <input asp-for="Data_Limite" type="date" required class="form-control" />
                <span asp-validation-for="Data_Limite" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>