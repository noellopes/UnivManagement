@model UnivManagement.Models.TestesEstagios.Estagio

@{
    ViewData["Title"] = "Detalhes do Estágio";
}

<h2>Detalhes do Estágio</h2>

<hr />

<div class="card">
    <div class="card-body">

        <h5 class="card-title">
            Estágio nº @Model.IdEstagio
        </h5>

        <p>
            <strong>Aluno:</strong>
            @ViewBag.NomeAluno
        </p>

        <p>
            <strong>Empresa:</strong>
            @ViewBag.NomeEmpresa
        </p>

        <p>
            <strong>Orientador de Estágio:</strong>
            @ViewBag.NomeOrientador
        </p>

        <hr />

        <p>
            <strong>Data de Início:</strong>
            @Model.DataInicio.ToString("dd/MM/yyyy")
        </p>

        <p>
            <strong>Data de Fim:</strong>
            @Model.DataFim.ToString("dd/MM/yyyy")
        </p>

        <p>
            <strong>Duração:</strong>
            @Model.Duracao dias
        </p>

        <p>
            <strong>Estado:</strong>
            @Model.Estado
        </p>

        <p>
            <strong>Plano de Trabalhos:</strong>
            @Model.PlanoTrabalhos
        </p>

        <div class="mt-4">
            <a asp-action="Edit"
               asp-route-idestagio="@Model.IdEstagio"
               class="btn btn-primary">
                Editar
            </a>

            <a asp-action="Delete"
               asp-route-idestagio="@Model.IdEstagio"
               class="btn btn-danger">
                Eliminar
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Voltar
            </a>
        </div>

    </div>
</div>