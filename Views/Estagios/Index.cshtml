@model IEnumerable<UnivManagement.Models.TestesEstagios.Estagio>

@{
    ViewData["Title"] = "Estágios";
}

<h2>Estágios</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Criar
    </a>
</p>

@if (Model.Count() == 0)
{
    <p>Ainda não existem estágios registados.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Estágio</th>
                <th>Data de Início</th>
                <th>Data de Fim</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var estagio in Model)
            {
                <tr>
                    <td>@estagio.IdEstagio</td>
                    <td>@estagio.DataInicio.ToString("dd/MM/yyyy")</td>
                    <td>@estagio.DataFim.ToString("dd/MM/yyyy")</td>
                    <td>@estagio.Estado</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-idestagio="@estagio.IdEstagio">
                            Ver detalhes
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}