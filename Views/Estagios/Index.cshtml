@model UnivManagement.ViewModels.QueryOptions<UnivManagement.Models.Estagio>

@{
    ViewData["Title"] = "Estágios";

    var estagios = Model.Items;

    int totalPaginas =
        (Model.TotalItems + Model.ItemsPerPage - 1) / Model.ItemsPerPage;
}

<h2>Gestão de Estágios</h2>

<hr />

<p>
    <a asp-action="Create" class="btn btn-primary">
        Criar Estágio
    </a>
</p>

<div class="card">
    <div class="card-body">

        <h5 class="card-title">
            Lista de Estágios
        </h5>

        <hr />

        @if (!estagios.Any())
        {
            <p>Ainda não existem estágios registados.</p>
        }
        else
        {
            <table class="table table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th scope="col">Estágio</th>
                        <th scope="col">Aluno</th>
                        <th scope="col">Empresa</th>
                        <th scope="col">Data de Início</th>
                        <th scope="col">Data de Fim</th>
                        <th scope="col">Duração</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var estagio in estagios)
                    {
                        <tr>
                            <td>@estagio.EstagioId</td>

                            <td>
                                @if (estagio.Student != null)
                                {
                                    @estagio.Student.Name
                                }
                                else
                                {
                                    <span>Aluno não encontrado</span>
                                }
                            </td>

                            <td>
                                @if (estagio.Empresa != null)
                                {
                                    @estagio.Empresa.Nome
                                }
                                else
                                {
                                    <span>Empresa não encontrada</span>
                                }
                            </td>

                            <td>
                                @estagio.DataInicio.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @estagio.DataFim.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @estagio.Duracao dias
                            </td>

                            <td>
                                @estagio.Estado
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-estagioId="@estagio.EstagioId"
                                   class="btn btn-secondary">
                                    Ver detalhes
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (totalPaginas > 1)
        {
            <nav aria-label="Paginação dos estágios" class="mt-3">
                <ul class="pagination justify-content-center mb-0">

                    @if (Model.CurrentPage == 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Anterior</span>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)">
                                Anterior
                            </a>
                        </li>
                    }

                    @for (int pagina = 1; pagina <= totalPaginas; pagina++)
                    {
                        if (pagina == Model.CurrentPage)
                        {
                            <li class="page-item active" aria-current="page">
                                <span class="page-link">@pagina</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@pagina">
                                    @pagina
                                </a>
                            </li>
                        }
                    }

                    @if (Model.CurrentPage == totalPaginas)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Seguinte</span>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)">
                                Seguinte
                            </a>
                        </li>
                    }

                </ul>
            </nav>
        }

    </div>
</div>