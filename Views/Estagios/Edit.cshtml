@model UnivManagement.Models.TestesEstagios.Estagio

@{
    ViewData["Title"] = "Editar Estágio";
}

<h2>Editar Estágio</h2>

<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit"
              asp-route-idestagio="@Model.IdEstagio"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            @if (ViewBag.ErroDatas != null)
            {
                <p class="text-danger">
                    @ViewBag.ErroDatas
                </p>
            }

            @if (ViewBag.ErroFormulario != null)
            {
                <p class="text-danger">
                    @ViewBag.ErroFormulario
                </p>
            }

            <div class="mb-3">
                <label asp-for="DataInicio" class="form-label">
                    Data de Início
                </label>
                <input asp-for="DataInicio"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label asp-for="DataFim" class="form-label">
                    Data de Fim
                </label>
                <input asp-for="DataFim"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label asp-for="PlanoTrabalhos" class="form-label">
                    Plano de Trabalhos
                </label>
                <input asp-for="PlanoTrabalhos"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label asp-for="StudentId" class="form-label">
                    Aluno
                </label>

                <select asp-for="StudentId"
                        class="form-select"
                        required>

                    <option value="">Selecione um aluno</option>

                    @foreach (UnivManagement.Models.TestesEstagios.Student aluno in ViewBag.Alunos)
                    {
                        <option value="@aluno.StudentId">
                            @aluno.Name
                        </option>
                    }

                </select>
            </div>

            <div class="mb-3">
                <label asp-for="IdEmpresa" class="form-label">
                    Empresa
                </label>

                <select asp-for="IdEmpresa"
                        class="form-select"
                        required>

                    <option value="">Selecione uma empresa</option>

                    @foreach (UnivManagement.Models.TestesEstagios.Empresa empresa in ViewBag.Empresas)
                    {
                        <option value="@empresa.IdEmpresa">
                            @empresa.Nome
                        </option>
                    }

                </select>
            </div>

            <div class="mb-3">
                <label asp-for="IdOrientador" class="form-label">
                    Orientador de Estágio
                </label>

                <select asp-for="IdOrientador"
                        class="form-select">

                    <option value="">Sem orientador</option>

                    @foreach (UnivManagement.Models.TestesEstagios.OrientadorEstagio orientador in ViewBag.Orientadores)
                    {
                        <option value="@orientador.IdOrientador">
                            @orientador.Nome
                        </option>
                    }

                </select>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    Guardar Alterações
                </button>

                <a asp-action="Details"
                   asp-route-idestagio="@Model.IdEstagio"
                   class="btn btn-secondary">
                    Cancelar
                </a>
            </div>

        </form>

    </div>
</div>