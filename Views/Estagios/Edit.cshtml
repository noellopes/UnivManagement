@model UnivManagement.Models.Estagio

@{
    ViewData["Title"] = "Editar Estágio";
}

<h2>Editar Estágio</h2>

<hr />

<form asp-action="Edit"
      asp-route-estagioId="@Model.EstagioId"
      method="post">

    <input type="hidden" asp-for="EstagioId" />

    <div asp-validation-summary="All"
         class="text-danger"></div>

    @if (ViewBag.ErroDatas != null)
    {
        <p class="text-danger">
            @ViewBag.ErroDatas
        </p>
    }

    @if (ViewBag.ErroFormulario != null)
    {
        <p class="text-danger">
            @ViewBag.ErroFormulario
        </p>
    }

    <div class="card">
        <div class="card-body">

            <h5 class="card-title">
                Informações do Estágio
            </h5>

            <hr />

            <div class="row">

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="DataInicio"
                               class="form-label">
                            Data de Início
                        </label>

                        <input asp-for="DataInicio"
                               class="form-control"
                               required />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="DataFim"
                               class="form-label">
                            Data de Fim
                        </label>

                        <input asp-for="DataFim"
                               class="form-control"
                               required />
                    </div>
                </div>

            </div>

            <div class="mb-3">
                <label asp-for="PlanoTrabalhos"
                       class="form-label">
                    Plano de Trabalhos
                </label>

                <input asp-for="PlanoTrabalhos"
                       class="form-control"
                       required />
            </div>

        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">

            <h5 class="card-title">
                Entidades Associadas
            </h5>

            <hr />

            <div class="row">

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="StudentId"
                               class="form-label">
                            Aluno
                        </label>

                        <select asp-for="StudentId"
                                class="form-select"
                                asp-items="ViewBag.StudentId"
                                required>

                            <option value="">
                                Selecione um aluno
                            </option>

                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="IdEmpresa"
                               class="form-label">
                            Empresa
                        </label>

                        <select asp-for="IdEmpresa"
                                class="form-select"
                                asp-items="ViewBag.IdEmpresa"
                                required>

                            <option value="">
                                Selecione uma empresa
                            </option>

                        </select>
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="OrientadorId"
                               class="form-label">
                            Orientador de Estágio
                        </label>

                        <select asp-for="OrientadorId"
                                class="form-select"
                                asp-items="ViewBag.OrientadorId">

                            <option value="">
                                Sem orientador
                            </option>

                        </select>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <div class="mt-4">

        <button type="submit"
                class="btn btn-primary">
            Guardar Alterações
        </button>

        <a asp-action="Details"
           asp-route-estagioId="@Model.EstagioId"
           class="btn btn-secondary">
            Cancelar
        </a>

    </div>

</form>