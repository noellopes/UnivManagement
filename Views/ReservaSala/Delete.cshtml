@model UnivManagement.Models.ReservaSala

@{
    ViewData["Title"] = "Eliminar Reserva de Sala";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="card border-0 shadow rounded-4">

                <!-- Cabeçalho -->
                <div class="card-header bg-danger text-white p-4 rounded-top-4">
                    <h3 class="mb-1">🗑️ Eliminar Reserva de Sala</h3>
                    <p class="mb-0 opacity-75">
                        Confirme os dados antes de eliminar a reserva.
                    </p>
                </div>

                <div class="card-body p-4">

                    <!-- Aviso -->
                    <div class="alert alert-warning d-flex align-items-center"
                         role="alert">
                        <div>
                            <strong>Atenção!</strong>
                            Tem a certeza de que pretende eliminar esta reserva?
                            Esta ação não poderá ser revertida.
                        </div>
                    </div>

                    <!-- Informações da reserva -->
                    <h5 class="fw-semibold mb-4">
                        Detalhes da Reserva
                    </h5>

                    <div class="row g-3">

                        <!-- Responsável -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Responsavel)
                            </label>
                            <div class="form-control bg-light">
                                @Html.DisplayFor(model => model.Responsavel)
                            </div>
                        </div>

                        <!-- Sala -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.SalaFk)
                            </label>
                            <div class="form-control bg-light">
                                @Html.DisplayFor(model => model.SalaFk)
                            </div>
                        </div>

                        <!-- Motivo -->
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Motivo)
                            </label>
                            <div class="form-control bg-light"
                                 style="min-height: 70px;">
                                @Html.DisplayFor(model => model.Motivo)
                            </div>
                        </div>

                        <!-- Data de início -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.DataInicio)
                            </label>
                            <div class="form-control bg-light">
                                @Html.DisplayFor(model => model.DataInicio)
                            </div>
                        </div>

                        <!-- Data de fim -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.DataFim)
                            </label>
                            <div class="form-control bg-light">
                                @Html.DisplayFor(model => model.DataFim)
                            </div>
                        </div>

                        <!-- Estado -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">
                                @Html.DisplayNameFor(model => model.Estado)
                            </label>
                            <div>
                                <span class="badge bg-secondary fs-6 px-3 py-2">
                                    @Html.DisplayFor(model => model.Estado)
                                </span>
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Botões -->
                    <form asp-action="Delete" method="post">

                        <input type="hidden"
                               asp-for="ReservaSalaId" />

                        <div class="d-flex justify-content-between gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                ← Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4">
                                🗑️ Eliminar Reserva
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
