<div class="alert alert-danger border-0 shadow-sm rounded-4 p-4 d-flex align-items-start gap-3"
     role="alert">

    <div class="bg-danger-subtle text-danger rounded-3 p-3 flex-shrink-0">
        <i class="bi bi-person-x-fill fs-3" aria-hidden="true"></i>
    </div>

    <div class="flex-grow-1">
        <h4 class="alert-heading fs-5 fw-semibold mb-2">
            Não foi encontrado funcao docente.
        </h4>

        <p class="mb-3">
            A funcão docente selecionado não foi encontrado. Deve ter sido eliminado ou não está mais disponível.
        </p>

        <hr class="border-danger opacity-25">

        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            <a asp-action="Index"
               class="btn btn-primary">
                <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                Voltar para funcao docente
            </a>
            <span class="text-body-secondary small">
                voltar para lista de funcoes docentes para continuar.
            </span>
        </div>

    </div>
</div>
