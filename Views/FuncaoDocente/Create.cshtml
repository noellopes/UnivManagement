@model UnivManagement.Models.FuncaoDocente

@{
    ViewData["Title"] = "Criar Função Docente";
}


    <!-- Cabeçalho -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="h3 mb-1 text-gray-800">Criar Nova Função Docente</h2>
            <p class="text-muted small mb-0">Preencha os campos abaixo para registar uma nova função docente no sistema.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
            </a>
        </div>
    </div>

    <!-- Formulário num Cartão Bootstrap -->
    <div class="row">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="bi bi-person-badge me-2"></i>Informações da Função
                    </h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Campo Nome -->
                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label fw-bold"></label>
                            <input asp-for="Nome" class="form-control" placeholder="Ex: Professor Coordenador" />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <!-- Campo Data de Criação -->
                        <div class="mb-3">
                            <label asp-for="DataCriacao" class="form-label fw-bold">Data de Criação</label>
                            <input asp-for="DataCriacao" class="form-control" type="datetime-local" />
                            <span asp-validation-for="DataCriacao" class="text-danger small"></span>
                        </div>

                        <!-- Campo Ativo (Checkbox Estilizado) -->
                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="Ativo" class="form-check-input" type="checkbox" role="switch" id="switchAtivo" />
                                <label class="form-check-label fw-bold" for="switchAtivo">
                                    @Html.DisplayNameFor(model => model.Ativo)
                                </label>
                            </div>
                            <span asp-validation-for="Ativo" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <!-- Botões de Ação -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i> Criar Função
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}