@model UnivManagement.Models.ServicoFuncionario

@{
    ViewData["Title"] = "Editar Serviço de Funcionário";
}



<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0 rounded-3">
                <!-- Cabeçalho do Cartão -->
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="card-title mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Editar Serviço de Funcionário
                    </h4>
                </div>

                <!-- Corpo do Formulário -->
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <!-- Chaves e Propriedades Ocultas que Devem Ser Preservadas -->
                        <input type="hidden" asp-for="ServicoFuncionarioId" />
                        <input type="hidden" asp-for="DataCriacao" />

                        <!-- Campo Nome -->
                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label fw-bold">
                                <i class="bi bi-tag-fill me-1 text-warning"></i> Nome do Serviço
                            </label>
                            <input asp-for="Nome" class="form-control" placeholder="Ex: Atendimento ao Cliente" />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <!-- Campo Ativo (Checkbox Estilizado) -->
                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="Ativo" class="form-check-input" type="checkbox" role="switch" id="switchAtivo" />
                                <label class="form-check-label fw-bold" for="switchAtivo">
                                    <i class="bi bi-check-circle-fill me-1 text-success"></i> Serviço Ativo
                                </label>
                            </div>
                            <span asp-validation-for="Ativo" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <!-- Botões de Ação -->
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                                <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
                            </a>
                            <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm fw-bold">
                                <i class="bi bi-check-lg me-1"></i> Guardar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
