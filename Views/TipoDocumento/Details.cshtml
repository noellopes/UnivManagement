@model UnivManagement.Models.TipoDocumento

@{
    ViewData["Title"] = "Details";
}

<h1 class="mb-4">Detalhes do tipo de documento</h1>

<div>
    <h4>TipoDocumento</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NomeTipo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NomeTipo)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Obrigatorio)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Obrigatorio)
            {
                <span class="badge rounded-pill text-bg-success">Sim</span>
            }
            else
            {
                <span class="badge rounded-pill text-bg-secondary">Não</span>
            }
        </dd>
    </dl>
</div>
<div class="d-flex gap-2 mt-4">
    <a asp-action="Edit" asp-route-id="@Model?.TipoDocumentoId" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
</div>
