@model UnivManagement.Models.TipoDocumento

@{
    ViewData["Title"] = "Novo tipo de documento";
}

<h1 class="mb-4">Novo tipo de documento</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NomeTipo" class="form-label"></label>
                <input asp-for="NomeTipo" class="form-control" />
                <div class="form-text">Máximo de 100 caracteres.</div>
                <span asp-validation-for="NomeTipo" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Obrigatorio" class="form-check-input" />
                <label asp-for="Obrigatorio" class="form-check-label"></label>
                <div class="form-text">Marca se o estudante tem de entregar este documento.</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar tipo de documento</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
