@model IPagination

@if (Model.PageCount > 1) {
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                @if (Model.CurrentPage == 1) {
                    <span class="page-link" aria-disabled="true" aria-label="First page"><i class="bi bi-chevron-bar-left" aria-hidden="true"></i></span>
                } else {
                    <a class="page-link" asp-action="Index" asp-route-page="1" aria-label="First page"><i class="bi bi-chevron-bar-left" aria-hidden="true"></i></a>
                }
            </li>

            @for (int p = Model.FirstPageToShow; p <= Model.LastPageToShow; p++) {
                if (p == Model.CurrentPage) {
                    <li class="page-item active">
                        <a class="page-link" href="#">@p</a>
                    </li>
                } else {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
            }

            <li class="page-item @(Model.CurrentPage == Model.PageCount ? "disabled" : "")">
                @if (Model.CurrentPage == Model.PageCount) {
                    <span class="page-link" aria-disabled="true" aria-label="Last page"><i class="bi bi-chevron-bar-right" aria-hidden="true"></i></span>
                } else {
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.PageCount" aria-label="Last page"><i class="bi bi-chevron-bar-right" aria-hidden="true"></i></a>
                }
            </li>
        </ul>
    </nav>
}