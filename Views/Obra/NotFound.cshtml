@{
    ViewData["Title"] = "Obra Não Encontrada";
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">

                <div class="card-body p-5 text-center">

                    <!-- Ícone de aviso -->
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger"
                           style="font-size: 4rem;"
                           aria-hidden="true"></i>
                    </div>

                    <!-- Título -->
                    <h2 class="fw-bold mb-3">
                        Obra Não Encontrada
                    </h2>

                    <!-- Mensagem -->
                    <div class="alert alert-danger mb-4"
                         role="alert">

                        <p class="fw-semibold mb-2">
                            Não foi possível encontrar a obra selecionada.
                        </p>

                        <p class="fw-semibold mb-0">
                            A obra poderá já ter sido eliminada.
                        </p>

                    </div>

                    <p class="text-muted mb-4">
                        Podes regressar ao catálogo para consultar
                        as obras disponíveis na biblioteca.
                    </p>

                    <!-- Botões de navegação -->
                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                        <a asp-controller="Obra"
                           asp-action="Index"
                           class="btn btn-primary">
                            📚 Voltar à Lista de Obras
                        </a>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            🏠 Voltar ao Início
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>

</div>
